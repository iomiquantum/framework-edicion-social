{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.framework-edicion-social/schemas/learning-evidence-event.schema.json",
  "title": "Immutable evidence event for the editorial learning engine",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "occurred_at",
    "source",
    "evidence_type",
    "scope",
    "context",
    "pattern",
    "evidence",
    "scope_authorization",
    "supersedes_event_id",
    "supersession_reason"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {
      "type": "string",
      "pattern": "^LE-[A-Z0-9][A-Z0-9._-]{2,127}$"
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["kind", "artifact_path", "artifact_sha256", "subject_sha256", "recorded_by"],
      "properties": {
        "kind": {
          "enum": ["approval", "feedback", "performance", "qa_measurement"]
        },
        "artifact_path": {"type": "string", "minLength": 1},
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "subject_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recorded_by": {"enum": ["human", "system", "importer"]}
      },
      "additionalProperties": false
    },
    "evidence_type": {
      "enum": ["technical", "creative", "preference", "performance"]
    },
    "scope": {
      "type": "object",
      "required": ["level", "id"],
      "properties": {
        "level": {"enum": ["asset", "video", "series", "style", "creator", "account", "global"]},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": [
        "project_id",
        "video_id",
        "series_id",
        "style_id",
        "creator_id",
        "account_id",
        "asset_id",
        "platform",
        "independent_context_id"
      ],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "video_id": {"type": ["string", "null"]},
        "series_id": {"type": ["string", "null"]},
        "style_id": {"type": ["string", "null"]},
        "creator_id": {"type": ["string", "null"]},
        "account_id": {"type": ["string", "null"]},
        "asset_id": {"type": ["string", "null"]},
        "platform": {"type": ["string", "null"]},
        "independent_context_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "pattern": {
      "type": "object",
      "required": [
        "key",
        "value",
        "decision_domain",
        "variant_axis",
        "template_family_id",
        "variant_id",
        "variation_mode",
        "applicability"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "value": {},
        "decision_domain": {"enum": ["editorial_choice", "technical_contract"]},
        "variant_axis": {
          "enum": [
            "structure",
            "format",
            "style",
            "rhythm",
            "transitions",
            "audio",
            "captions",
            "assets",
            "technical",
            "workflow",
            "other"
          ]
        },
        "template_family_id": {"type": ["string", "null"]},
        "variant_id": {"type": ["string", "null"]},
        "variation_mode": {
          "enum": ["baseline", "controlled_variant", "exploratory"]
        },
        "applicability": {
          "type": "object",
          "required": [
            "content_type",
            "platform",
            "audience_goal",
            "source_format",
            "duration_band",
            "language"
          ],
          "properties": {
            "content_type": {"type": "string", "minLength": 1},
            "platform": {"type": "string", "minLength": 1},
            "audience_goal": {"type": "string", "minLength": 1},
            "source_format": {"type": "string", "minLength": 1},
            "duration_band": {"type": "string", "minLength": 1},
            "language": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "signal",
        "weight",
        "confidence",
        "explicit_human",
        "measured",
        "sample_size",
        "reason",
        "performance_context",
        "hard_gate"
      ],
      "properties": {
        "signal": {"enum": ["supports", "opposes", "neutral", "revokes"]},
        "weight": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"enum": ["insufficient", "low", "medium", "high"]},
        "explicit_human": {"type": "boolean"},
        "measured": {"type": "boolean"},
        "sample_size": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "minLength": 1},
        "performance_context": {
          "type": ["object", "null"],
          "required": [
            "comparison_basis",
            "metric_name",
            "metric_value",
            "metric_direction",
            "benchmark_id",
            "benchmark_value",
            "experiment_id",
            "observation_window_hours",
            "causal_claim_allowed"
          ],
          "properties": {
            "comparison_basis": {"enum": ["none", "cohort", "control", "ab_test"]},
            "metric_name": {"type": "string", "minLength": 1},
            "metric_value": {"type": ["number", "null"]},
            "metric_direction": {"enum": ["higher_is_better", "lower_is_better"]},
            "benchmark_id": {"type": ["string", "null"]},
            "benchmark_value": {"type": ["number", "null"]},
            "experiment_id": {"type": ["string", "null"]},
            "observation_window_hours": {"type": "number", "minimum": 0},
            "causal_claim_allowed": {"const": false}
          },
          "additionalProperties": false
        },
        "hard_gate": {
          "type": ["object", "null"],
          "required": ["gate_id", "status", "override_permitted"],
          "properties": {
            "gate_id": {"type": "string", "minLength": 1},
            "status": {"enum": ["pass", "fail", "not_run"]},
            "override_permitted": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scope_authorization": {
      "type": ["object", "null"],
      "required": [
        "approval_id",
        "approval_mode",
        "decision",
        "approved_by",
        "approved_at",
        "artifact_path",
        "artifact_sha256",
        "source_scope",
        "target_scope"
      ],
      "properties": {
        "approval_id": {"type": "string", "minLength": 1},
        "approval_mode": {"const": "human_explicit"},
        "decision": {"const": "allow_evaluation_exact_scope"},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "artifact_path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_scope": {
          "type": "object",
          "required": ["level", "id"],
          "properties": {
            "level": {"enum": ["asset", "video", "series", "style", "creator", "account"]},
            "id": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "target_scope": {
          "type": "object",
          "required": ["level", "id"],
          "properties": {
            "level": {"enum": ["series", "style", "creator", "account", "global"]},
            "id": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "supersedes_event_id": {"type": ["string", "null"]},
    "supersession_reason": {"type": ["string", "null"], "minLength": 1}
  },
  "additionalProperties": false
}
