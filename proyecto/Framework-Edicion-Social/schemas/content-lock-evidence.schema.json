{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.framework-edicion-social/schemas/content-lock-evidence.schema.json",
  "title": "File-backed content lock evidence",
  "type": "object",
  "required": [
    "schema_version",
    "lock_id",
    "project_id",
    "video_id",
    "status",
    "platform_master_sha256",
    "hash_strategy",
    "locked_at",
    "artifacts",
    "binding",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "lock_id": {"type": "string", "pattern": "^CONTENT-LOCK-[A-Z0-9-]+$"},
    "project_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "pattern": "^VIDEO-[0-9]{2,}$"},
    "status": {"enum": ["pending", "sealed"]},
    "platform_master_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "hash_strategy": {"const": "file-sha256-or-directory-tree-sha256-v1"},
    "locked_at": {"type": ["string", "null"], "format": "date-time"},
    "artifacts": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["role", "path", "kind", "sha256", "size_bytes"],
        "properties": {
          "role": {"enum": ["project", "cut_plan", "audio_mix"]},
          "path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["file", "directory"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "binding": {
      "type": "object",
      "required": ["algorithm", "canonicalization", "payload_sha256"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "json-sort-keys-utf8-v1"},
        "payload_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
