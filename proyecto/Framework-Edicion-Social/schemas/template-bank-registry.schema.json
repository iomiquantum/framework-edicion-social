{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.framework-edicion-social/schemas/template-bank-registry.schema.json",
  "title": "Governed social template bank registry",
  "description": "Separates source-artifact approval, template reuse authorization, family maturity and performance evidence.",
  "type": "object",
  "required": ["schema_version", "updated_at", "templates"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "updated_at": {"type": "string", "format": "date"},
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "status",
          "source_project",
          "artifact_approval",
          "template_reuse",
          "performance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[0-9]{2,}-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9]+(?:[.-][a-z0-9]+)*)?$"
          },
          "status": {
            "enum": ["planned", "candidate", "testing", "validated", "retired"]
          },
          "source_project": {
            "type": ["string", "null"],
            "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
          },
          "artifact_approval": {
            "type": "object",
            "required": ["video_id", "status", "receipt_path", "scope", "reason"],
            "properties": {
              "video_id": {
                "type": ["string", "null"],
                "pattern": "^VIDEO-[0-9]{2,}$"
              },
              "status": {
                "enum": [
                  "not_applicable",
                  "pending_review",
                  "pending_receipt",
                  "approved",
                  "changes_requested",
                  "rejected"
                ]
              },
              "receipt_path": {
                "type": ["string", "null"],
                "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
              },
              "scope": {
                "type": ["string", "null"],
                "enum": ["whole_artifact", "layer_specific", null]
              },
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "template_reuse": {
            "type": "object",
            "required": [
              "status",
              "scope",
              "authorization_basis",
              "authorization_ref",
              "evidence_video_ids",
              "reason"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not_applicable",
                  "pending",
                  "series_default",
                  "creator_default",
                  "retired"
                ]
              },
              "scope": {
                "type": ["string", "null"],
                "enum": ["series", "creator", null]
              },
              "authorization_basis": {
                "enum": [
                  "none",
                  "explicit_template_approval",
                  "approved_pattern",
                  "manual_retirement"
                ]
              },
              "authorization_ref": {"type": ["string", "null"], "minLength": 1},
              "evidence_video_ids": {
                "type": "array",
                "items": {"type": "string", "pattern": "^VIDEO-[0-9]{2,}$"},
                "uniqueItems": true
              },
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "performance": {
            "type": "object",
            "required": ["status", "network_tests", "review_refs"],
            "properties": {
              "status": {
                "enum": [
                  "no_data",
                  "awaiting_data",
                  "inconclusive",
                  "context_supported",
                  "context_opposed",
                  "expired"
                ]
              },
              "network_tests": {"type": "integer", "minimum": 0},
              "review_refs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
