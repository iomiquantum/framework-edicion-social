{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.framework-edicion-social/schemas/production-metrics.schema.json",
  "title": "Verified video production metrics",
  "type": "object",
  "required": ["schema_version", "production_record_id", "project_id", "video_id", "captured_at", "started_at", "first_reviewable_at", "final_delivered_at", "measurement_method", "verification_status", "evidence", "stage_minutes", "assets", "reviews", "renders", "rework", "notes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "production_record_id": {"type": "string", "pattern": "^PROD-[A-F0-9]{16}$"},
    "project_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "pattern": "^VIDEO-[0-9]{2,}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "first_reviewable_at": {"type": ["string", "null"], "format": "date-time"},
    "final_delivered_at": {"type": ["string", "null"], "format": "date-time"},
    "measurement_method": {"enum": ["self_reported", "manual_timer", "automated_logs", "hybrid"]},
    "verification_status": {"enum": ["self_reported", "verified"]},
    "evidence": {
      "type": ["object", "null"],
      "required": ["path", "sha256", "type", "integrity_scope"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "type": {"enum": ["timer_export", "work_log", "local_record"]},
        "integrity_scope": {"const": "local_artifact_integrity_only"}
      },
      "additionalProperties": false
    },
    "stage_minutes": {
      "type": "object",
      "required": ["ingest_and_selects", "transcription_and_semantic_lock", "resource_preparation", "assembly", "review_changes", "quality_control", "rendering"],
      "properties": {
        "ingest_and_selects": {"type": "number", "minimum": 0},
        "transcription_and_semantic_lock": {"type": "number", "minimum": 0},
        "resource_preparation": {"type": "number", "minimum": 0},
        "assembly": {"type": "number", "minimum": 0},
        "review_changes": {"type": "number", "minimum": 0},
        "quality_control": {"type": "number", "minimum": 0},
        "rendering": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "required": ["reused", "derived", "generated", "generated_but_unused", "reuse_rate"],
      "properties": {
        "reused": {"type": "integer", "minimum": 0},
        "derived": {"type": "integer", "minimum": 0},
        "generated": {"type": "integer", "minimum": 0},
        "generated_but_unused": {"type": "integer", "minimum": 0},
        "reuse_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "reviews": {
      "type": "object",
      "required": ["rounds", "atomic_decisions", "approved_first_pass", "first_pass_approval_rate"],
      "properties": {
        "rounds": {"type": "integer", "minimum": 0},
        "atomic_decisions": {"type": "integer", "minimum": 0},
        "approved_first_pass": {"type": "integer", "minimum": 0},
        "first_pass_approval_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "renders": {
      "type": "object",
      "required": ["segment_previews", "full_drafts", "full_quality"],
      "properties": {
        "segment_previews": {"type": "integer", "minimum": 0},
        "full_drafts": {"type": "integer", "minimum": 0},
        "full_quality": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "rework": {
      "type": "object",
      "required": ["change_count", "layers", "root_causes"],
      "properties": {
        "change_count": {"type": "integer", "minimum": 0},
        "layers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "root_causes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
