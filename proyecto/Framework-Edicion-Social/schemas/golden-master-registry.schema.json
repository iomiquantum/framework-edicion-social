{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.framework-edicion-social/schemas/golden-master-registry.schema.json",
  "title": "Golden master reference registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "hash_algorithm", "entries", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "pattern": "^GOLDEN-MASTER-[A-Z0-9_-]+$"},
    "hash_algorithm": {"const": "sha256"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "reference_path", "content_sha256", "metadata", "source_id", "notes", "registered_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^GM-[A-Z0-9_-]+$"},
          "label": {"type": "string", "minLength": 1},
          "kind": {"enum": ["video", "audio", "image", "json", "document", "binary"]},
          "reference_path": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "metadata": {
            "type": "object",
            "required": ["size_bytes", "extension"],
            "properties": {
              "size_bytes": {"type": "integer", "minimum": 0},
              "extension": {"type": "string"},
              "mime_type": {"type": ["string", "null"]},
              "container": {"type": ["string", "null"]},
              "duration_s": {"type": ["number", "null"], "minimum": 0},
              "width": {"type": ["integer", "null"], "minimum": 1},
              "height": {"type": ["integer", "null"], "minimum": 1},
              "fps": {"type": ["number", "null"], "minimum": 0},
              "video_codec": {"type": ["string", "null"]},
              "audio_codec": {"type": ["string", "null"]},
              "sample_rate_hz": {"type": ["integer", "null"], "minimum": 1},
              "channels": {"type": ["integer", "null"], "minimum": 1},
              "json_type": {"type": ["string", "null"]},
              "document_schema_version": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "source_id": {"type": ["string", "null"]},
          "notes": {"type": "string"},
          "registered_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
