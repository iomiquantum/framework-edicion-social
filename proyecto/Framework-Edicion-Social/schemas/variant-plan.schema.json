{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.framework-edicion-social/schemas/variant-plan.schema.json",
  "title": "Hook and CTA variant plan with a locked shared body",
  "type": "object",
  "required": ["schema_version", "plan_id", "project_id", "video_id", "blueprint_id", "shared_body", "variants", "experiment", "traceability"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "plan_id": {"type": "string", "pattern": "^VARIANT-PLAN-[A-Z0-9_-]+$"},
    "project_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "minLength": 1},
    "blueprint_id": {"type": "string", "pattern": "^CBP-[A-Z0-9][A-Z0-9_-]*$"},
    "shared_body": {
      "type": "object",
      "required": ["beat_ids", "content_sha256", "edit_points_locked", "voice_locked", "caption_timing_locked", "semantic_plan_locked", "approved_assets_locked", "face_safe_zones_locked"],
      "properties": {
        "beat_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^BEAT-[0-9]{2,3}$"}, "uniqueItems": true},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "edit_points_locked": {"const": true},
        "voice_locked": {"const": true},
        "caption_timing_locked": {"const": true},
        "semantic_plan_locked": {"const": true},
        "approved_assets_locked": {"const": true},
        "face_safe_zones_locked": {"const": true}
      },
      "additionalProperties": false
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "label", "status", "body_reference", "hook", "cta", "allowed_overrides", "forbidden_overrides", "hypothesis", "metrics"],
        "properties": {
          "id": {"type": "string", "pattern": "^VAR-[A-Z0-9_-]+$"},
          "label": {"type": "string", "minLength": 1},
          "status": {"enum": ["candidate", "approved", "rejected", "paused"]},
          "body_reference": {"const": "shared_body"},
          "hook": {
            "type": "object",
            "required": ["text", "editorial_copy", "duration_target_s", "visual_treatment", "sfx_intent", "source_trace_ids"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "editorial_copy": {"type": "boolean"},
              "duration_target_s": {"type": "number", "exclusiveMinimum": 0},
              "visual_treatment": {"type": "string", "minLength": 1},
              "sfx_intent": {"type": ["string", "null"]},
              "source_trace_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(SRC|DEC)-[A-Z0-9_-]+$"}, "uniqueItems": true}
            },
            "additionalProperties": false
          },
          "cta": {
            "type": "object",
            "required": ["text", "editorial_copy", "duration_target_s", "visual_treatment", "sfx_intent", "source_trace_ids"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "editorial_copy": {"type": "boolean"},
              "duration_target_s": {"type": "number", "exclusiveMinimum": 0},
              "visual_treatment": {"type": "string", "minLength": 1},
              "sfx_intent": {"type": ["string", "null"]},
              "source_trace_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(SRC|DEC)-[A-Z0-9_-]+$"}, "uniqueItems": true}
            },
            "additionalProperties": false
          },
          "allowed_overrides": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {"enum": ["hook", "cta"]},
            "uniqueItems": true
          },
          "forbidden_overrides": {
            "type": "array",
            "minItems": 6,
            "items": {"enum": ["body", "voice", "caption_timing", "semantic_plan", "approved_assets", "face_safe_zones"]},
            "uniqueItems": true
          },
          "hypothesis": {"type": "string", "minLength": 1},
          "metrics": {
            "type": "object",
            "required": ["primary", "guardrails"],
            "properties": {
              "primary": {"type": "string", "minLength": 1},
              "guardrails": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "experiment": {
      "type": "object",
      "required": ["unit", "allocation", "primary_metric", "guardrail_metrics", "minimum_sample_note", "change_family"],
      "properties": {
        "unit": {"enum": ["impression", "viewer", "publication"]},
        "allocation": {"enum": ["equal", "manual"]},
        "primary_metric": {"type": "string", "minLength": 1},
        "guardrail_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "minimum_sample_note": {"type": "string", "minLength": 1},
        "change_family": {"const": "hook_and_cta_only"}
      },
      "additionalProperties": false
    },
    "traceability": {
      "type": "object",
      "required": ["source_blueprint_sha256", "variant_decision_ids", "notes"],
      "properties": {
        "source_blueprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "variant_decision_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^DEC-[A-Z0-9_-]+$"}, "uniqueItems": true},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
