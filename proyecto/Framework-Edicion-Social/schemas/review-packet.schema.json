{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.framework-edicion-social/schemas/review-packet.schema.json",
  "title": "Hash-bound editorial review packet",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "project_id",
    "video_id",
    "generated_at",
    "render",
    "source_manifest",
    "inputs",
    "comparison",
    "beats",
    "layers",
    "requested_changes",
    "impact",
    "preview_plan",
    "findings",
    "decisions",
    "governance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "packet_id": {"type": "string", "pattern": "^RP-[A-Z0-9_-]+-[A-F0-9]{12}$"},
    "project_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "pattern": "^VIDEO-[0-9]{2,3}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "render": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes", "metadata"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "metadata": {
          "type": "object",
          "required": ["duration_s", "resolution", "fps", "video_codec", "audio_codec", "color"],
          "properties": {
            "duration_s": {"type": "number", "exclusiveMinimum": 0},
            "resolution": {"type": "string", "pattern": "^[0-9]+x[0-9]+$"},
            "fps": {"type": "number", "exclusiveMinimum": 0},
            "video_codec": {"type": ["string", "null"]},
            "audio_codec": {"type": ["string", "null"]},
            "color": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "source_manifest": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": ["dependency_map", "blueprint", "changes", "review_decision"],
      "properties": {
        "dependency_map": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "additionalProperties": false
        },
        "blueprint": {
          "type": ["object", "null"],
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "additionalProperties": false
        },
        "changes": {
          "type": ["object", "null"],
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "additionalProperties": false
        },
        "review_decision": {
          "type": ["object", "null"],
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": ["enabled", "relation", "previous"],
      "properties": {
        "enabled": {"type": "boolean"},
        "relation": {"enum": ["not_requested", "identical", "different"]},
        "previous": {
          "type": ["object", "null"],
          "required": ["path", "sha256", "size_bytes"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "size_bytes": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "label", "start_s", "end_s", "reference_frame_s", "review_tags", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "start_s": {"type": "number", "minimum": 0},
          "end_s": {"type": "number", "exclusiveMinimum": 0},
          "reference_frame_s": {"type": "number", "minimum": 0},
          "review_tags": {
            "type": "array",
            "items": {"enum": ["hook", "middle", "critical_transition", "cta"]},
            "uniqueItems": true
          },
          "source": {"enum": ["manifest", "blueprint"]}
        },
        "additionalProperties": false
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "heavy", "state"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "description": {"type": "string"},
          "heavy": {"type": "boolean"},
          "state": {"enum": ["current", "reused", "new", "modified", "invalidated"]}
        },
        "additionalProperties": false
      }
    },
    "requested_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start_s", "end_s", "layer", "element_id", "instruction", "reference_frame_s", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^CHANGE-[0-9]{3,4}$"},
          "start_s": {"type": "number", "minimum": 0},
          "end_s": {"type": "number", "exclusiveMinimum": 0},
          "layer": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "element_id": {"type": "string", "minLength": 1},
          "instruction": {"type": "string", "minLength": 1},
          "reference_frame_s": {"type": "number", "minimum": 0},
          "status": {"const": "open"}
        },
        "additionalProperties": false
      }
    },
    "impact": {
      "type": "object",
      "required": ["changed", "invalidated_layers", "invalidated_artifacts", "heavy_layers", "unaffected_layers", "computed_at"],
      "properties": {
        "changed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "invalidated_layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "heavy", "invalidated_by"],
            "properties": {
              "id": {"type": "string"},
              "heavy": {"type": "boolean"},
              "invalidated_by": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            },
            "additionalProperties": false
          }
        },
        "invalidated_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path", "kind", "layer_id"],
            "properties": {
              "id": {"type": "string"},
              "path": {"type": "string"},
              "kind": {"enum": ["file", "directory", "logical"]},
              "layer_id": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "heavy_layers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "unaffected_layers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "computed_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "preview_plan": {
      "type": "object",
      "required": ["strategy", "partial_review_previews_allowed", "final_delivery_requires_full_encode", "handle_s", "ranges", "rationale"],
      "properties": {
        "strategy": {"enum": ["no_changes", "partial_then_full", "partial_only_for_review"]},
        "partial_review_previews_allowed": {"type": "boolean"},
        "final_delivery_requires_full_encode": {"type": "boolean"},
        "handle_s": {"type": "number", "minimum": 0, "maximum": 3},
        "ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "start_s", "end_s", "reference_frame_s", "change_ids", "layers", "recommended_output"],
            "properties": {
              "id": {"type": "string", "pattern": "^PREVIEW-[0-9]{2,3}$"},
              "start_s": {"type": "number", "minimum": 0},
              "end_s": {"type": "number", "exclusiveMinimum": 0},
              "reference_frame_s": {"type": "number", "minimum": 0},
              "change_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
              "layers": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
              "recommended_output": {"const": "partial_review_preview"}
            },
            "additionalProperties": false
          }
        },
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "object",
      "required": ["technical", "semantic", "variety"],
      "properties": {
        "technical": {"type": "array", "items": {"type": "string"}},
        "semantic": {"type": "array", "items": {"type": "string"}},
        "variety": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "object",
      "required": ["video", "assets", "template_family", "series_default"],
      "properties": {
        "video": {
          "type": "object",
          "required": ["status", "evidence_reference"],
          "properties": {
            "status": {"enum": ["pending", "approved", "changes_requested", "rejected"]},
            "evidence_reference": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "assets": {
          "type": "object",
          "required": ["status", "evidence_reference"],
          "properties": {
            "status": {"enum": ["pending", "approved", "changes_requested", "rejected"]},
            "evidence_reference": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "template_family": {
          "type": "object",
          "required": ["status", "evidence_reference"],
          "properties": {
            "status": {"enum": ["pending", "approved", "changes_requested", "rejected"]},
            "evidence_reference": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "series_default": {
          "type": "object",
          "required": ["status", "evidence_reference"],
          "properties": {
            "status": {"enum": ["pending", "approved", "changes_requested", "rejected"]},
            "evidence_reference": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": [
        "purpose",
        "review_decision_replaces_approval_receipt",
        "approval_authority",
        "notice"
      ],
      "properties": {
        "purpose": {"const": "editorial_review_coordination"},
        "review_decision_replaces_approval_receipt": {"const": false},
        "approval_authority": {"const": "approval_receipt_only"},
        "notice": {"type": "string", "minLength": 40}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
