{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.framework-edicion-social/schemas/feedback-event.schema.json",
  "title": "Atomic feedback event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "recorded_at",
    "project_id",
    "target_id",
    "attribute",
    "decision",
    "explicit_user_feedback",
    "scope",
    "preference_effect"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "event_id": {"type": "string", "pattern": "^FEEDBACK-[0-9]{8}-[0-9]{3,}$"},
    "recorded_at": {"type": "string", "format": "date"},
    "project_id": {"type": "string"},
    "review_id": {"type": ["string", "null"]},
    "target_id": {"type": "string"},
    "attribute": {"type": "string"},
    "decision": {"enum": ["approve", "confirm", "change", "reject", "revoke"]},
    "from": {},
    "value": {},
    "reason": {"type": "string"},
    "explicit_user_feedback": {"type": "boolean"},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "preference_effect": {"enum": ["none", "project_only", "candidate", "confirmed_global", "revoke_candidate", "revoke_confirmed"]},
    "supersedes_event_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
