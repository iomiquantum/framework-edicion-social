{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.framework-edicion-social/schemas/performance-observation.schema.json",
  "title": "Normalized social performance observation",
  "type": "object",
  "required": [
    "schema_version",
    "observation_id",
    "project_id",
    "video_id",
    "publication_id",
    "platform",
    "surface",
    "lineage",
    "published_at",
    "captured_at",
    "window_hours",
    "window_tolerance_hours",
    "captured_elapsed_hours",
    "content",
    "creative_attribution",
    "distribution",
    "metrics",
    "evidence",
    "derived",
    "confounders",
    "source_reference",
    "governance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "observation_id": {"type": "string", "pattern": "^OBS-[A-F0-9]{16}$"},
    "project_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "pattern": "^VIDEO-[0-9]{2,}$"},
    "publication_id": {"type": "string", "minLength": 1},
    "platform": {"enum": ["instagram", "tiktok", "youtube", "linkedin", "facebook", "other"]},
    "surface": {"type": "string", "minLength": 1},
    "lineage": {
      "type": "object",
      "required": ["publication_record_id", "publication_registry_id", "publication_registry_sha256", "package_id", "package_sha256", "target_profile_id", "delivery_sha256", "delivery_check_sha256", "publication_evidence_sha256", "verification_status"],
      "properties": {
        "publication_record_id": {"type": "string", "pattern": "^PUBREC-[A-F0-9]{16}$"},
        "publication_registry_id": {"type": "string", "pattern": "^PUBLICATION-REGISTRY-[A-Z0-9-]+$"},
        "publication_registry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "package_id": {"type": "string", "minLength": 1},
        "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "target_profile_id": {"type": "string", "pattern": "^PLATFORM-[A-Z0-9-]+-[0-9]{3}$"},
        "delivery_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "delivery_check_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "publication_evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "verification_status": {"const": "verified_ready_delivery"}
      },
      "additionalProperties": false
    },
    "published_at": {"type": "string", "format": "date-time"},
    "captured_at": {"type": "string", "format": "date-time"},
    "window_hours": {"enum": [24, 72, 168]},
    "window_tolerance_hours": {"enum": [2, 4, 8]},
    "captured_elapsed_hours": {"type": "number", "minimum": 0},
    "content": {
      "type": "object",
      "required": [
        "duration_s",
        "primary_family_id",
        "recipe_id",
        "hook_id",
        "structure_id",
        "visual_system_id",
        "motion_id",
        "sound_id",
        "cta_id",
        "hybrid",
        "contributing_family_ids"
      ],
      "properties": {
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "primary_family_id": {"type": ["string", "null"]},
        "recipe_id": {"type": ["string", "null"]},
        "hook_id": {"type": ["string", "null"]},
        "structure_id": {"type": ["string", "null"]},
        "visual_system_id": {"type": ["string", "null"]},
        "motion_id": {"type": ["string", "null"]},
        "sound_id": {"type": ["string", "null"]},
        "cta_id": {"type": ["string", "null"]},
        "hybrid": {"type": "boolean"},
        "contributing_family_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^FAMILY-[A-Z0-9_-]+$"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "creative_attribution": {
      "type": "object",
      "required": ["path", "sha256", "attribution_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "attribution_id": {"type": "string", "pattern": "^ATTR-[A-F0-9]{16}$"}
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": [
        "traffic_source",
        "paid_spend",
        "currency",
        "campaign_objective",
        "audience_segment",
        "followers_at_publish",
        "publish_slot",
        "account_id",
        "language",
        "topic_id",
        "campaign_id",
        "publication_period"
      ],
      "properties": {
        "traffic_source": {"enum": ["organic", "paid", "mixed", "unknown"]},
        "paid_spend": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": ["string", "null"]},
        "campaign_objective": {"type": ["string", "null"]},
        "audience_segment": {"type": ["string", "null"]},
        "followers_at_publish": {"type": ["integer", "null"], "minimum": 0},
        "publish_slot": {"type": ["string", "null"]},
        "account_id": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 2},
        "topic_id": {"type": "string", "minLength": 1},
        "campaign_id": {"type": ["string", "null"]},
        "publication_period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "impressions",
        "reach",
        "views",
        "total_watch_time_s",
        "average_watch_time_s",
        "completion_rate",
        "likes",
        "comments",
        "shares",
        "saves",
        "clicks",
        "conversions"
      ],
      "properties": {
        "impressions": {"type": ["integer", "null"], "minimum": 0},
        "reach": {"type": ["integer", "null"], "minimum": 0},
        "views": {"type": ["integer", "null"], "minimum": 0},
        "total_watch_time_s": {"type": ["number", "null"], "minimum": 0},
        "average_watch_time_s": {"type": ["number", "null"], "minimum": 0},
        "completion_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "likes": {"type": ["integer", "null"], "minimum": 0},
        "comments": {"type": ["integer", "null"], "minimum": 0},
        "shares": {"type": ["integer", "null"], "minimum": 0},
        "saves": {"type": ["integer", "null"], "minimum": 0},
        "clicks": {"type": ["integer", "null"], "minimum": 0},
        "conversions": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["path", "sha256", "type", "integrity_scope", "authenticity_notice"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "type": {"enum": ["platform_export", "screenshot", "local_record"]},
        "integrity_scope": {"const": "local_artifact_integrity_only"},
        "authenticity_notice": {"type": "string", "minLength": 40}
      },
      "additionalProperties": false
    },
    "derived": {
      "type": "object",
      "required": [
        "average_watch_ratio",
        "shares_per_reach",
        "saves_per_reach",
        "engagements_per_reach",
        "clicks_per_reach"
      ],
      "properties": {
        "average_watch_ratio": {"type": ["number", "null"], "minimum": 0},
        "shares_per_reach": {"type": ["number", "null"], "minimum": 0},
        "saves_per_reach": {"type": ["number", "null"], "minimum": 0},
        "engagements_per_reach": {"type": ["number", "null"], "minimum": 0},
        "clicks_per_reach": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "confounders": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_reference": {"type": "string", "minLength": 1},
    "governance": {
      "type": "object",
      "required": ["causal_claim_allowed", "automatic_rule_promotion", "human_review_required"],
      "properties": {
        "causal_claim_allowed": {"const": false},
        "automatic_rule_promotion": {"const": false},
        "human_review_required": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
