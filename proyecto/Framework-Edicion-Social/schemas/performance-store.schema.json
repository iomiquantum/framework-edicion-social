{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.framework-edicion-social/schemas/performance-store.schema.json",
  "title": "Normalized performance observation store",
  "type": "object",
  "required": ["schema_version", "store_id", "updated_at", "observations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "store_id": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "observations": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
