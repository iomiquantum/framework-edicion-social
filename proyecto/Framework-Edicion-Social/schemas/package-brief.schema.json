{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.framework-edicion-social/schemas/package-brief.schema.json",
  "title": "Sealed derivative build brief",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "video_id",
    "source_sha256",
    "ready_scope",
    "publication_ready",
    "target",
    "instruction",
    "binding"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package_id": {"type": "string", "pattern": "^PUBLISH-VIDEO-[0-9]{2,}-[A-F0-9]{16}$"},
    "video_id": {"type": "string", "pattern": "^VIDEO-[0-9]{2,}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ready_scope": {"const": "derivative_build_only"},
    "publication_ready": {"const": false},
    "target": {"type": "object", "minProperties": 1},
    "instruction": {"type": "string", "minLength": 1},
    "binding": {
      "type": "object",
      "required": ["algorithm", "canonicalization", "payload_sha256"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "json-sort-keys-utf8-v1"},
        "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
