<template><div data-hf-id="hf-rkr5" id="captions-es" data-composition-id="captions-es" data-width="1080" data-height="1920" data-duration="22.033333333"><div data-hf-id="hf-ew2a" id="cap-1" class="clip quote caption s0" data-start="0.171000000" data-duration="1.000000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-ci6q">Dentro de poco, hacer</p></div><div data-hf-id="hf-fp81" id="cap-2" class="clip quote caption s0" data-start="1.171000000" data-duration="1.245000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-m8og">una campaña completa</p></div><div data-hf-id="hf-wsd6" id="cap-3" class="clip quote caption s0" data-start="2.451000000" data-duration="2.235000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-gsca">puede ser lo <span data-hf-id="hf-whht" class="kw">más fácil</span> del marketing.</p></div><div data-hf-id="hf-sgri" id="cap-4" class="clip quote caption s1" data-start="4.917000000" data-duration="1.660000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-2w11">Textos, imágenes, vídeos,</p></div><div data-hf-id="hf-lrej" id="cap-5" class="clip quote caption s1" data-start="6.577000000" data-duration="1.350000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-7dau">segmentaciones,</p></div><div data-hf-id="hf-oenq" id="cap-6" class="clip quote caption s2" data-start="7.927000000" data-duration="1.490000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-4tp4">la <span data-hf-id="hf-e4px" class="kw">IA</span> puede generar todo eso</p></div><div data-hf-id="hf-aqur" id="cap-7" class="clip quote caption s2" data-start="9.417000000" data-duration="0.985000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-6pv5">cada vez más rápido.</p></div><div data-hf-id="hf-aqpi" id="cap-8" class="clip quote caption s3" data-start="10.783000000" data-duration="1.925000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-fvcq">Entonces saber hacer anuncios</p></div><div data-hf-id="hf-hga9" id="cap-9" class="clip quote caption s3" data-start="12.933000000" data-duration="1.575000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-dana">deja de ser <span data-hf-id="hf-oeja" class="kw">suficiente</span>,</p></div><div data-hf-id="hf-ify9" id="cap-10" class="clip quote caption s3" data-start="14.513000000" data-duration="1.465000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-cdsy">lo difícil va a ser decidir</p></div><div data-hf-id="hf-7as7" id="cap-11" class="clip quote caption s3" data-start="16.073000000" data-duration="2.015000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-gt7j"><span data-hf-id="hf-wne1" class="kw">qué idea probar</span> y saber qué pasó.</p></div><div data-hf-id="hf-5c74" id="cap-12" class="clip quote caption s4" data-start="18.255000000" data-duration="2.290000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-77e7">La ventaja no será <span data-hf-id="hf-v0hp" class="kw">crear campañas</span>,</p></div><div data-hf-id="hf-4qhn" id="cap-13" class="clip quote caption s4" data-start="20.545000000" data-duration="1.395000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-h0fc">será <span data-hf-id="hf-cagu" class="kw">aprender</span> de ellas.</p></div></div><script>const tl=gsap.timeline({paused:true});tl.set("#cap-1",{opacity:1},0.171000000);tl.set("#cap-1",{opacity:0},1.171000000);tl.set("#cap-2",{opacity:1},1.171000000);tl.set("#cap-2",{opacity:0},2.416000000);tl.set("#cap-3",{opacity:1},2.451000000);tl.set("#cap-3",{opacity:0},4.686000000);tl.set("#cap-4",{opacity:1},4.917000000);tl.set("#cap-4",{opacity:0},6.577000000);tl.set("#cap-5",{opacity:1},6.577000000);tl.set("#cap-5",{opacity:0},7.927000000);tl.set("#cap-6",{opacity:1},7.927000000);tl.set("#cap-6",{opacity:0},9.417000000);tl.set("#cap-7",{opacity:1},9.417000000);tl.set("#cap-7",{opacity:0},10.402000000);tl.set("#cap-8",{opacity:1},10.783000000);tl.set("#cap-8",{opacity:0},12.708000000);tl.set("#cap-9",{opacity:1},12.933000000);tl.set("#cap-9",{opacity:0},14.508000000);tl.set("#cap-10",{opacity:1},14.513000000);tl.set("#cap-10",{opacity:0},15.978000000);tl.set("#cap-11",{opacity:1},16.073000000);tl.set("#cap-11",{opacity:0},18.088000000);tl.set("#cap-12",{opacity:1},18.255000000);tl.set("#cap-12",{opacity:0},20.545000000);tl.set("#cap-13",{opacity:1},20.545000000);tl.set("#cap-13",{opacity:0},21.940000000);window.__timelines["captions-es"]=tl;</script></template>