<template><div data-hf-id="hf-rike" id="state-cierre" data-composition-id="state-cierre" data-width="1080" data-height="1920" data-duration="3.800000000" class="composition" style="position:absolute;inset:0;width:100%;height:100%;background:transparent"><div id="inner-state-cierre" class="scene-inner frame close" style="opacity:0"><h1 data-hf-id="hf-dux3" class="head">Aprender de<br data-hf-id="hf-x5px">las campañas.</h1></div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo("#inner-state-cierre",{opacity:0},{opacity:1,duration:.16,ease:"power2.out"},0);tl.fromTo("#state-cierre .head",{y:16,opacity:0},{y:0,opacity:1,duration:.22,ease:"power2.out"},0);tl.set("#state-cierre",{opacity:0},3.800000000);tl.set("#inner-state-cierre",{opacity:0},3.800000000);window.__timelines["state-cierre"]=tl;</script></template>