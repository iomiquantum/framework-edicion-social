<!doctype html><html><body><template><style>#root{position:absolute;inset:0;color:#f8fafc;font-family:Avenir Next,Arial,sans-serif;pointer-events:none}.cue{position:absolute;left:78px;bottom:235px;width:924px;padding:19px 25px 21px;border-radius:22px;background:rgba(7,17,31,.92);border:1px solid rgba(255,255,255,.15);box-shadow:0 18px 55px rgba(0,0,0,.3);font-size:45px;font-weight:800;line-height:1.08;text-align:center;letter-spacing:-1px;opacity:0}.cue span{background:linear-gradient(90deg,#fff,#F6B73C);-webkit-background-clip:text;background-clip:text;color:transparent}</style><div id="root" data-composition-id="captions-es" data-duration="18.700" data-width="1080" data-height="1920"><div id="c1" class="cue"><span>Tener muchas ideas no es emprender.</span></div><div id="c2" class="cue"><span>Tener 10 ideas de negocio no</span></div><div id="c3" class="cue"><span>significa que tengas 10 oportunidades.</span></div><div id="c4" class="cue"><span>La IA puede darte cientos de</span></div><div id="c5" class="cue"><span>ideas en segundos.</span></div><div id="c6" class="cue"><span>El verdadero valor está en descubrir</span></div><div id="c7" class="cue"><span>cuál merece tu tiempo, tu dinero</span></div><div id="c8" class="cue"><span>y tu energía.¿Qué idea tienes guardada</span></div><div id="c9" class="cue"><span>hace meses y todavía no has</span></div><div id="c10" class="cue"><span>probado?</span></div></div><script>const tl=gsap.timeline({paused:true});const cues=[["#c1",0,1.94],["#c2",1.94,3.85],["#c3",3.85,5.84],["#c4",5.84,7.7],["#c5",7.71,9.11],["#c6",9.11,11.33],["#c7",11.33,13.39],["#c8",13.39,15.99],["#c9",15.99,17.62],["#c10",17.64,18.49]];cues.forEach(([id,a,b])=>{tl.fromTo(id,{opacity:0,y:14},{opacity:1,y:0,duration:.09,ease:'power1.out'},a).to(id,{opacity:0,y:-8,duration:.09,ease:'power1.in'},Math.max(a,b-.09))});window.__timelines=window.__timelines||{};window.__timelines['captions-es']=tl;</script></template></body></html>