</style><div id="root" data-composition-id="scene-moat" data-width="1080" data-height="1920"><img class="photo" data-layout-allow-overflow src="assets/video-03_broll_business_knowledge_v01.png"><div class="shade"></div><div class="tag">TU VENTAJA ES PROPIA</div><div class="headline">LO QUE TU NEGOCIO<br><b>YA APRENDIÓ</b></div><div class="list"><div class="item"><span class="n">1</span>CLIENTES</div><div class="item"><span class="n">2</span>DATOS</div><div class="item"><span class="n">3</span>EXPERIENCIA</div><div class="item"><span class="n">4</span>APRENDIZAJE</div></div></div><script>const tl=gsap.timeline({paused:true});tl.set('.photo',{scale:1.02}).to('.photo',{scale:1.075,x:-12,duration:5.99,ease:'none'},0).fromTo('.tag',{opacity:0,x:-22},{opacity:1,x:0,duration:.28,ease:'power2.out'},.08).fromTo('.headline',{opacity:0,y:22},{opacity:1,y:0,duration:.34,ease:'power3.out'},.18).fromTo('.item',{opacity:0,x:-32},{opacity:1,x:0,duration:.28,stagger:.36,ease:'power3.out'},.45);window.__timelines=window.__timelines||{};window.__timelines['scene-moat']=tl;</script></template></body></html>
