<!doctype html><html><body><template><style>
#root{position:absolute;inset:0;overflow:hidden;background:#07111f;font-family:Montserrat,Arial,sans-serif;color:#f8fafc}.bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.network{position:absolute;left:210px;top:215px;width:660px;filter:drop-shadow(0 30px 60px rgba(96,165,250,.25))}.kicker{position:absolute;left:74px;top:116px;padding:11px 18px;border-radius:999px;background:#10b981;color:#07111f;font:900 22px Inter,Arial;letter-spacing:.12em}.copy{position:absolute;left:74px;right:74px;top:935px;padding:34px 38px 38px;border-radius:34px;background:rgba(7,17,31,.9);border:2px solid rgba(96,165,250,.52);box-shadow:0 28px 70px rgba(0,0,0,.3)}.small{font:800 24px Inter,Arial;letter-spacing:.13em;color:#a7f3d0}.big{margin-top:12px;font-size:74px;line-height:.94;letter-spacing:-.052em}.big b{color:#60a5fa}.chips{display:flex;gap:14px;margin-top:25px}.chip{padding:11px 17px;border-radius:15px;background:rgba(167,139,250,.22);border:2px solid #a78bfa;font:800 22px Inter,Arial}
</style><div id="root" data-composition-id="scene-common" data-width="1080" data-height="1920"><img class="bg" src="assets/video-03_business_moat_background_v01.svg"><div class="kicker">ACCESO COMÚN</div><img class="network" src="assets/video-03_commodity_nodes_overlay_v01.svg"><div class="copy"><div class="small">MAÑANA</div><div class="big">TODOS TENDRÁN<br><b>IA IGUAL O MEJOR</b></div><div class="chips"><div class="chip">MISMA HERRAMIENTA</div><div class="chip">≠ VENTAJA</div></div></div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('.network',{scale:.62,opacity:0,rotation:-12},{scale:1,opacity:1,rotation:0,duration:.48,ease:'back.out(1.6)'},.06).fromTo('.kicker',{opacity:0,y:-18},{opacity:1,y:0,duration:.28,ease:'power2.out'},.12).fromTo('.copy',{opacity:0,y:38},{opacity:1,y:0,duration:.4,ease:'power3.out'},.28).fromTo('.chip',{opacity:0,y:14},{opacity:1,y:0,duration:.22,stagger:.09,ease:'power2.out'},.62).to('.network',{scale:1.06,duration:2.8,ease:'sine.inOut'},1.0);window.__timelines=window.__timelines||{};window.__timelines['scene-common']=tl;</script></template></body></html>
