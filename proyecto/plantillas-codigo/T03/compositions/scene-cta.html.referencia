<!doctype html><html><body><template><style>
#root{position:absolute;inset:0;overflow:hidden;font-family:Montserrat,Arial,sans-serif;color:#f8fafc}.card{position:absolute;left:58px;right:58px;top:92px;padding:27px 32px 31px;border-radius:30px;background:rgba(7,17,31,.92);border:3px solid #10b981;box-shadow:0 24px 58px rgba(0,0,0,.28)}.small{font:850 22px Inter,Arial;letter-spacing:.12em;color:#6ee7b7}.question{margin-top:11px;font-size:54px;line-height:.98;letter-spacing:-.045em}.question b{color:#60a5fa}.pill{position:absolute;left:125px;right:125px;bottom:390px;padding:16px 20px;border-radius:99px;background:linear-gradient(90deg,#10b981,#60a5fa);color:#07111f;text-align:center;font:900 24px Inter,Arial;letter-spacing:.04em}
</style><div id="root" data-composition-id="scene-cta" data-width="1080" data-height="1920"><div class="card"><div class="small">PREGUNTA CLAVE</div><div class="question">¿QUÉ SABE TU NEGOCIO QUE <b>CHATGPT NO SABE?</b></div></div><div class="pill">AHÍ EMPIEZA TU VENTAJA</div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('.card',{opacity:0,y:-24},{opacity:1,y:0,duration:.36,ease:'power3.out'},.06).fromTo('.question b',{scale:.78,display:'inline-block'},{scale:1,duration:.4,ease:'back.out(1.8)'},.42).fromTo('.pill',{opacity:0,scale:.86},{opacity:1,scale:1,duration:.38,ease:'back.out(1.7)'},.8).to('.pill',{boxShadow:'0 0 34px rgba(16,185,129,.55)',duration:.6,ease:'sine.inOut',yoyo:true,repeat:1},1.5);window.__timelines=window.__timelines||{};window.__timelines['scene-cta']=tl;</script></template></body></html>
