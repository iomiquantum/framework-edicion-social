<!doctype html><html><body><template><style>
#root{position:absolute;inset:0;color:#f8fafc;font-family:Montserrat,Arial,sans-serif;pointer-events:none}.cue{position:absolute;left:72px;bottom:255px;width:936px;padding:20px 25px 22px;border-radius:23px;background:rgba(7,17,31,.94);box-shadow:0 18px 55px rgba(0,0,0,.3);font-size:46px;line-height:1.08;text-align:center;letter-spacing:-.025em;opacity:0}.cue em{font-style:normal;color:#6ee7b7}.cue strong{color:#60a5fa}
</style><div id="root" data-composition-id="captions-es" data-width="1080" data-height="1920"><div id="c1" class="cue"><strong>ChatGPT no es tu ventaja.</strong></div><div id="c2" class="cue">Si tu ventaja competitiva es usar ChatGPT,</div><div id="c3" class="cue">no tienes ninguna ventaja.</div><div id="c4" class="cue">Mañana todos tendremos una IA igual o mejor.</div><div id="c5" class="cue">Tu ventaja serán tus <em>clientes,</em></div><div id="c6" class="cue">tus <em>datos</em> y tu <em>experiencia,</em></div><div id="c7" class="cue">y lo que tu negocio haya aprendido.</div><div id="c8" class="cue">¿Qué sabe tu negocio que <strong>ChatGPT todavía no sabe?</strong></div></div><script>const tl=gsap.timeline({paused:true});const cues=[["#c1",.173,1.849],["#c2",2.195,4.864],["#c3",5.210,6.580],["#c4",6.926,10.836],["#c5",11.182,12.62],["#c6",12.62,14.35],["#c7",14.35,16.829],["#c8",17.175,20.014]];cues.forEach(([id,a,b])=>{tl.fromTo(id,{opacity:0,y:16},{opacity:1,y:0,duration:.09,ease:'power1.out'},a).to(id,{opacity:0,y:-8,duration:.09,ease:'power1.in'},b-.09)});window.__timelines=window.__timelines||{};window.__timelines['captions-es']=tl;</script></template></body></html>
