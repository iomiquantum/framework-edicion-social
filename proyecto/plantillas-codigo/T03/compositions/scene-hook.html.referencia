<!doctype html><html><body><template><style>
#root{position:absolute;inset:0;overflow:hidden;font-family:Montserrat,Arial,sans-serif;color:#f8fafc}.copy{position:absolute;left:62px;top:108px;width:760px}.tag{display:inline-flex;padding:11px 19px;border:3px solid #10b981;border-radius:999px;background:rgba(7,17,31,.86);font:850 23px Inter,Arial;letter-spacing:.12em;color:#6ee7b7}.title{box-sizing:border-box;width:700px;margin-top:18px;padding:22px 25px 25px;border:2px solid rgba(16,185,129,.72);border-left:8px solid #10b981;border-radius:26px;background:linear-gradient(135deg,rgba(7,17,31,.95),rgba(15,38,55,.86));box-shadow:0 18px 42px rgba(7,17,31,.30);font-size:70px;line-height:.92;letter-spacing:-.052em;text-transform:uppercase;text-shadow:0 4px 18px rgba(7,17,31,.35)}.title b{display:inline-block;color:#60a5fa}.node{position:absolute;right:42px;top:62px;width:245px;height:245px;opacity:.92;filter:drop-shadow(0 15px 24px rgba(7,17,31,.34))}.rule{margin-top:18px;width:250px;height:10px;border-radius:8px;background:linear-gradient(90deg,#10b981,#60a5fa,#a78bfa)}
</style><div id="root" data-composition-id="scene-hook" data-width="1080" data-height="1920"><img class="node" src="assets/video-03_commodity_nodes_overlay_v01.svg"><div class="copy" data-layout-allow-occlusion><div class="tag">VENTAJA COMPETITIVA</div><div class="title">CHATGPT<br><b>NO ES</b> TU VENTAJA</div><div class="rule"></div></div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('.tag',{opacity:0,x:-18},{opacity:1,x:0,duration:.24,ease:'power2.out'},.08).fromTo('.title',{opacity:0,y:24},{opacity:1,y:0,duration:.38,ease:'power3.out'},.16).fromTo('.title b',{scale:.74},{scale:1,duration:.4,ease:'back.out(2)'},.42).fromTo('.rule',{scaleX:0,transformOrigin:'0 50%'},{scaleX:1,duration:.35,ease:'power2.out'},.5).fromTo('.node',{opacity:0,scale:.65,rotation:-18},{opacity:.92,scale:1,rotation:0,duration:.52,ease:'back.out(1.6)'},.28).to('.node',{rotation:6,duration:1.4,ease:'sine.inOut',yoyo:true,repeat:3},.9);window.__timelines=window.__timelines||{};window.__timelines['scene-hook']=tl;</script></template></body></html>
