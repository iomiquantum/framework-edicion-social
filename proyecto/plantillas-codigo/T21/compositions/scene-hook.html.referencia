#scene-hook-root{position:absolute;inset:0}</style><div id="scene-hook-root" data-hf-id="hf-v21-scene-hook-root" data-composition-id="scene-hook" data-duration="5.166667" data-width="1080" data-height="1920"><div id="hook" data-hf-id="hf-v21-hook" class="clip title" data-start="0.000000" data-duration="5.166667" data-track-index="3" data-track-kind="graphics"><div data-hf-id="hf-79sn" class="eyebrow">NEUROMARKETING</div><h1 data-hf-id="hf-m3fm"><span data-hf-id="hf-oac8">¿CONTROLAR</span><span data-hf-id="hf-re0n">CEREBROS?</span></h1></div></div><script>const tl=gsap.timeline({paused:true});document.querySelectorAll('#scene-hook-root .title').forEach(el=>{const t=Number(el.dataset.start)+0;const end=Number(el.dataset.start)+Number(el.dataset.duration);const eyebrow=el.querySelector('.eyebrow');tl.set(eyebrow,{opacity:1},t);tl.set(eyebrow,{opacity:0},end);el.querySelectorAll('h1 span').forEach((s,n)=>{tl.set(s,{opacity:1,y:n?38:60},t+n*.11);tl.to(s,{y:0,duration:n?.14:.18,ease:'power4.out'},t+n*.11);tl.set(s,{opacity:0},end)})});window.__timelines["scene-hook"]=tl;</script></template>