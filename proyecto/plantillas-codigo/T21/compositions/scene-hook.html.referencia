<template><style>
@font-face{font-family:Montserrat;src:url(assets/fonts/Montserrat-800.woff2);font-weight:800;font-display:block}
@font-face{font-family:Editorial;src:url(assets/fonts/EBGaramond-700.woff2);font-weight:700;font-display:block}
*{box-sizing:border-box;margin:0;padding:0}html,body{width:100%;height:100%;overflow:hidden}
#main{position:relative;width:100%;height:100%;overflow:hidden;color:#FFF6E7;font-family:Montserrat,sans-serif}
#bed{position:absolute;inset:0;background:#142B3A;z-index:0}
.speaker{position:absolute;top:384px;left:0;width:1080px;height:1536px;object-fit:cover;object-position:50% 50%;z-index:1}
.cutaway{position:absolute;top:384px;left:0;width:1080px;height:1536px;object-fit:cover;z-index:2}
#header{position:absolute;top:0;left:0;width:1080px;height:384px;background:#142B3A;border-bottom:6px solid #F18B54;z-index:3}
.title{position:absolute;top:0;left:88px;width:904px;height:350px}
.eyebrow{position:absolute;top:58px;left:0;font-size:42px;line-height:1.1;letter-spacing:2px;color:#F18B54;opacity:0}
h1{position:absolute;left:0;top:126px;font-size:90px;line-height:1.16;letter-spacing:-2px;font-weight:800}
