<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=1080,height=1920">
<script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
<style>
@font-face{font-family:Montserrat;src:url(assets/fonts/Montserrat-800.woff2);font-weight:800;font-display:block}
@font-face{font-family:Editorial;src:url(assets/fonts/EBGaramond-700.woff2);font-weight:700;font-display:block}
*{box-sizing:border-box;margin:0;padding:0}html,body{width:100%;height:100%;overflow:hidden}
#main{position:relative;width:100%;height:100%;overflow:hidden;color:#FFF6E7;font-family:Montserrat,sans-serif}
#bed{position:absolute;inset:0;background:#142B3A;z-index:0}
.speaker{position:absolute;top:384px;left:0;width:1080px;height:1536px;object-fit:cover;object-position:50% 50%;z-index:1}
.cutaway{position:absolute;top:384px;left:0;width:1080px;height:1536px;object-fit:cover;z-index:2}
#header{position:absolute;top:0;left:0;width:1080px;height:384px;background:#142B3A;border-bottom:6px solid #F18B54;z-index:3}
.title{position:absolute;top:0;left:88px;width:904px;height:350px}
.eyebrow{position:absolute;top:58px;left:0;font-size:42px;line-height:1.1;letter-spacing:2px;color:#F18B54;opacity:0}
h1{position:absolute;left:0;top:126px;font-size:90px;line-height:1.16;letter-spacing:-2px;font-weight:800}
h1 span{display:block;opacity:0}h1.serif{font-family:Editorial,serif;font-size:88px;line-height:1.2;letter-spacing:-1px}
h1.single{top:168px;font-size:98px;letter-spacing:-3px}
.accent{color:#F18B54}
#route{position:absolute;left:88px;top:366px;width:860px;height:6px;background:#51616D;z-index:5}
#route-fill{width:100%;height:6px;background:#76C9C0;transform-origin:left center}
.caption{position:absolute;left:72px;top:1400px;width:936px;text-align:center}
.caption p{display:inline-block;width:100%;padding:24px 30px;background:#142B3A;color:#FFF6E7;border-radius:22px;border:3px solid #FFF6E7;font-size:58px;line-height:1.13;font-weight:800;word-spacing:2px}
.scene-mount{position:absolute;inset:0;z-index:4}#mount-captions{z-index:8}</style></head><body>
<div id="main" data-hf-id="hf-v21-main" data-composition-id="main" data-width="1080" data-height="1920" data-fps="30" data-start="0" data-duration="21.633333">
<div id="bed" data-hf-id="hf-v21-bed"></div>
<video id="presenter" data-hf-id="hf-v21-presenter" class="clip speaker" src="assets/video21-master-hlg-v1.mp4" muted playsinline preload="auto" data-start="0" data-duration="21.633333" data-media-start="0" data-track-index="0" data-track-kind="video"></video>
<img id="cutaway" data-hf-id="hf-v21-cutaway" class="clip cutaway" src="assets/brain-theatre.png" alt="Metáfora: un cerebro de arcilla separado de un mando teatral" data-start="5.166667" data-duration="1.9" data-track-index="2" data-track-kind="image">
<div id="header" data-hf-id="hf-v21-header"></div>
<div id="mount-scene-hook" data-hf-id="hf-v21-mount-scene-hook" class="clip scene-mount" data-composition-id="scene-hook" data-composition-src="compositions/scene-hook.html" data-start="0.000000" data-duration="5.166667" data-track-index="3" data-track-kind="graphics" data-width="1080" data-height="1920"></div><div id="mount-scene-myth" data-hf-id="hf-v21-mount-scene-myth" class="clip scene-mount" data-composition-id="scene-myth" data-composition-src="compositions/scene-myth.html" data-start="5.166667" data-duration="3.833333" data-track-index="3" data-track-kind="graphics" data-width="1080" data-height="1920"></div><div id="mount-scene-focus" data-hf-id="hf-v21-mount-scene-focus" class="clip scene-mount" data-composition-id="scene-focus" data-composition-src="compositions/scene-focus.html" data-start="9.000000" data-duration="8.933333" data-track-index="3" data-track-kind="graphics" data-width="1080" data-height="1920"></div><div id="mount-scene-close" data-hf-id="hf-v21-mount-scene-close" class="clip scene-mount" data-composition-id="scene-close" data-composition-src="compositions/scene-close.html" data-start="17.933333" data-duration="3.700000" data-track-index="3" data-track-kind="graphics" data-width="1080" data-height="1920"></div>
<div id="route" data-hf-id="hf-v21-route"><div id="route-fill" data-hf-id="hf-v21-route-fill"></div></div>
<div id="mount-captions" data-hf-id="hf-v21-mount-captions" class="clip scene-mount" data-composition-id="captions-es" data-composition-src="compositions/captions-es.html" data-start="0" data-duration="21.633333" data-track-index="8" data-track-kind="captions" data-width="1080" data-height="1920"></div>
<audio id="voice" data-hf-id="hf-v21-voice" src="assets/video21-voice-denoised-normalized-v1.wav" preload="auto" data-start="0" data-duration="21.633333" data-track-index="20" data-track-kind="voice" data-volume="1"></audio>
<audio id="sfx-myth" data-hf-id="hf-v21-sfx-myth" src="assets/entry-velvet.wav" data-start="5.166667" data-duration="0.58" data-track-index="30" data-track-kind="sfx" data-volume="3.2"></audio>
<audio id="sfx-understand" data-hf-id="hf-v21-sfx-understand" src="assets/entry-velvet.wav" data-start="9.000000" data-duration="0.58" data-track-index="30" data-track-kind="sfx" data-volume="2.6"></audio>
<audio id="sfx-limit" data-hf-id="hf-v21-sfx-limit" src="assets/entry-velvet.wav" data-start="17.933333" data-duration="0.58" data-track-index="30" data-track-kind="sfx" data-volume="2.2"></audio>
</div>
<script>
window.__timelines=window.__timelines||{};
const tl=gsap.timeline({paused:true});window.__timelines.main=tl;
tl.fromTo('#route-fill',{scaleX:0},{scaleX:1,duration:21.633333,ease:'none'},0);
tl.seek(0);
</script></body></html>