<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=1080,height=1920"><script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script><style>@font-face{font-family:Outfit;src:url(assets/fonts/Outfit-800.woff2);font-weight:800;font-display:block}@font-face{font-family:Outfit;src:url(assets/fonts/Outfit-700.woff2);font-weight:700;font-display:block}@font-face{font-family:RouteMono;src:url(assets/fonts/IBMPlexMono-500.woff2);font-weight:500;font-display:block}*{box-sizing:border-box;margin:0;padding:0}html,body{width:100%;height:100%;overflow:hidden}#main{position:relative;width:100%;height:100%;font-family:Outfit,sans-serif;color:#193C39;overflow:hidden}#bed{position:absolute;inset:0;background:#F5F1E6;z-index:0}.speaker{position:absolute;left:40px;top:470px;width:1000px;height:1400px;object-fit:cover;object-position:50% 50%;border-radius:28px;z-index:1}.cutaway{position:absolute;left:40px;top:470px;width:1000px;height:1400px;object-fit:cover;border-radius:28px;z-index:2}#header{position:absolute;left:0;top:0;width:1080px;height:446px;background:#F5F1E6;z-index:3}.scene-mount{position:absolute;inset:0;z-index:5}.phase{position:absolute;left:88px;top:118px;width:904px;height:312px}.eyebrow{font-family:RouteMono,monospace;font-weight:500;font-size:36px;line-height:1.15;letter-spacing:1px;color:#2B726B;opacity:0}.headline{position:absolute;left:0;top:65px;font-size:88px;line-height:1.07;font-weight:800;letter-spacing:-1.8px;width:904px}.headline span{display:block;opacity:0}.next{position:absolute;left:0;top:281px;font-family:RouteMono,monospace;font-weight:500;font-size:31px;line-height:1.2;letter-spacing:0;color:#193C39;opacity:0}.steps{position:absolute;left:88px;top:48px;width:904px;display:flex;gap:12px;z-index:6}.step{position:relative;flex:1;height:46px;border-radius:16px;background:#D6E5DF;overflow:hidden}.step-fill{position:absolute;inset:0;background:#2B726B;transform-origin:left center}.step-num{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:RouteMono,monospace;font-weight:500;font-size:30px;color:#193C39;background:#D6E5DF}.step-num.on{background:#2B726B;color:#F5F1E6}.caption{position:absolute;left:84px;top:1380px;width:912px;text-align:center}.caption p{opacity:0;display:inline-block;width:100%;padding:22px 24px;background:#F5F1E6;color:#193C39;border-radius:16px;font-family:Outfit,sans-serif;font-size:62px;line-height:1.12;font-weight:700;word-spacing:2px}.caption-line{display:block}#mount-captions{z-index:8}</style></head><body><div id="main" data-composition-id="main" data-width="1080" data-height="1920" data-fps="30" data-start="0" data-duration="25.266667"><div id="bed"></div><video id="presenter" class="clip speaker" src="assets/video22-master-hlg-v1.mp4" muted playsinline preload="auto" data-start="0" data-duration="25.266667" data-media-start="0" data-track-index="0" data-track-kind="video"></video><img id="cutaway" class="clip cutaway" src="assets/purchase-headphones-v2.png" alt="Ilustración editorial: pagar con tarjeta unos auriculares en un comercio" data-start="13.583333" data-duration="2" data-track-index="2" data-track-kind="image"><div id="header"></div><div class="steps"><div class="step"><div id="step-num-0" class="step-num">1</div></div><div class="step"><div id="step-num-1" class="step-num">2</div></div><div class="step"><div id="step-num-2" class="step-num">3</div></div><div class="step"><div id="step-num-3" class="step-num">4</div></div><div class="step"><div id="step-num-4" class="step-num">5</div></div></div><div id="mount-scene-question" class="clip scene-mount" data-composition-id="scene-question" data-composition-src="compositions/scene-question.html" data-width="1080" data-height="1920" data-start="0.000000" data-duration="3.333333" data-track-index="3" data-track-kind="graphics"></div><div id="mount-scene-contrast" class="clip scene-mount" data-composition-id="scene-contrast" data-composition-src="compositions/scene-contrast.html" data-width="1080" data-height="1920" data-start="3.333333" data-duration="5.233334" data-track-index="3" data-track-kind="graphics"></div><div id="mount-scene-example" class="clip scene-mount" data-composition-id="scene-example" data-composition-src="compositions/scene-example.html" data-width="1080" data-height="1920" data-start="8.566667" data-duration="7.666666" data-track-index="3" data-track-kind="graphics"></div><div id="mount-scene-observe" class="clip scene-mount" data-composition-id="scene-observe" data-composition-src="compositions/scene-observe.html" data-width="1080" data-height="1920" data-start="16.233333" data-duration="4.833334" data-track-index="3" data-track-kind="graphics"></div><div id="mount-scene-experience" class="clip scene-mount" data-composition-id="scene-experience" data-composition-src="compositions/scene-experience.html" data-width="1080" data-height="1920" data-start="21.066667" data-duration="4.200000" data-track-index="3" data-track-kind="graphics"></div><div id="mount-captions" class="clip scene-mount" data-composition-id="captions-es" data-composition-src="compositions/captions-es.html" data-width="1080" data-height="1920" data-start="0" data-duration="25.266667" data-track-index="8" data-track-kind="captions"></div><audio id="voice" src="assets/video22-voice-clean-normalized-v1.wav" data-start="0" data-duration="25.266667" data-volume="1" data-track-index="20" data-track-kind="voice"></audio><audio id="sfx-hook" src="assets/entry-breath.wav" data-start="0.050000" data-duration="0.72" data-volume="3.754151" data-track-index="30" data-track-kind="sfx"></audio><audio id="sfx-contrast" src="assets/entry-breath.wav" data-start="3.333333" data-duration="0.72" data-volume="3.843535" data-track-index="30" data-track-kind="sfx"></audio><audio id="sfx-example" src="assets/entry-breath.wav" data-start="13.583333" data-duration="0.72" data-volume="1.961535" data-track-index="30" data-track-kind="sfx"></audio><audio id="sfx-experience" src="assets/resolve.wav" data-start="21.066667" data-duration="0.84" data-volume="1.8" data-track-index="30" data-track-kind="sfx"></audio></div><script>window.__timelines=window.__timelines||{};const tl=gsap.timeline({paused:true});window.__timelines.main=tl;tl.set('#step-num-0',{backgroundColor:'#2B726B',color:'#F5F1E6'},0.000000);tl.set('#step-num-1',{backgroundColor:'#2B726B',color:'#F5F1E6'},3.333333);tl.set('#step-num-2',{backgroundColor:'#2B726B',color:'#F5F1E6'},8.566667);tl.set('#step-num-3',{backgroundColor:'#2B726B',color:'#F5F1E6'},16.233333);tl.set('#step-num-4',{backgroundColor:'#2B726B',color:'#F5F1E6'},21.066667);tl.seek(0);</script></body></html>