<template><div data-composition-id="scene-question" data-start="0" data-width="1080" data-height="1920" data-duration="3.333333" style="position:relative;width:100%;height:100%"><div class="phase"><div class="eyebrow">01 · LO QUE PREGUNTAS</div><h1 class="headline"><span>Preguntar no</span><span>siempre alcanza.</span></h1><div class="next">LO QUE DECIMOS Y HACEMOS</div></div></div><script>const root=document.querySelector('[data-composition-id="scene-question"]');const tl=gsap.timeline({paused:true});window.__timelines=window.__timelines||{};window.__timelines['scene-question']=tl;const label=root.querySelector('.eyebrow');const next=root.querySelector('.next');tl.set(label,{opacity:1},0);tl.fromTo(label,{y:10},{y:0,duration:.16,ease:'power4.out'},0);root.querySelectorAll('.headline span').forEach((el,n)=>{tl.set(el,{opacity:1},n*.12);tl.fromTo(el,{y:40+n*8},{y:0,duration:.18,ease:'power4.out'},n*.12);tl.set(el,{opacity:0},3.333333);});tl.set(next,{opacity:1},.34);tl.set([label,next],{opacity:0},3.333333);tl.seek(0);</script></template>