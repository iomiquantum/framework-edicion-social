<template><div data-composition-id="captions-es" data-start="0" data-width="1080" data-height="1920" data-duration="25.266667" style="position:relative;width:100%;height:100%"><div id="cap-0" class="clip caption" data-start="0.060021" data-duration="0.490000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">Hay veces que</span></p></div><div id="cap-1" class="clip caption" data-start="0.550021" data-duration="1.700000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">preguntarle al cliente</span><span class="caption-line">qué quiere</span></p></div><div id="cap-2" class="clip caption" data-start="2.250021" data-duration="1.010000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">te puede engañar.</span></p></div><div id="cap-3" class="clip caption" data-start="3.297333" data-duration="1.850000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">No porque te estén</span><span class="caption-line">engañando,</span></p></div><div id="cap-4" class="clip caption" data-start="5.147333" data-duration="1.210000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">sino porque</span><span class="caption-line">nosotros mismos</span></p></div><div id="cap-5" class="clip caption" data-start="6.357333" data-duration="2.040000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">decimos cosas que</span><span class="caption-line">después no hacemos.</span></p></div><div id="cap-6" class="clip caption" data-start="8.765042" data-duration="1.770000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">Decimos: «Yo nunca</span><span class="caption-line">pagaría eso»</span></p></div><div id="cap-7" class="clip caption" data-start="10.535042" data-duration="1.400000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">y terminamos</span><span class="caption-line">comprándolo.</span></p></div><div id="cap-8" class="clip caption" data-start="11.935042" data-duration="1.600000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">Decimos que queremos</span><span class="caption-line">una cosa</span></p></div><div id="cap-9" class="clip caption" data-start="13.535042" data-duration="2.500000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">y nuestro comportamiento</span><span class="caption-line">termina mostrando otra.</span></p></div><div id="cap-10" class="clip caption" data-start="16.192105" data-duration="1.570000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">No escuches solamente</span></p></div><div id="cap-11" class="clip caption" data-start="17.762105" data-duration="1.730000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">lo que la gente dice,</span></p></div><div id="cap-12" class="clip caption" data-start="19.492105" data-duration="1.380000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">mira también</span><span class="caption-line">lo que hace.</span></p></div><div id="cap-13" class="clip caption" data-start="21.024250" data-duration="1.190000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">¿Alguna vez dijiste:</span></p></div><div id="cap-14" class="clip caption" data-start="22.214250" data-duration="1.380000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">«Yo jamás compraría eso»</span></p></div><div id="cap-15" class="clip caption" data-start="23.594250" data-duration="1.530000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">y terminaste</span><span class="caption-line">comprándolo?</span></p></div></div><script>const root=document.querySelector('[data-composition-id="captions-es"]');const tl=gsap.timeline({paused:true});window.__timelines=window.__timelines||{};window.__timelines["cap