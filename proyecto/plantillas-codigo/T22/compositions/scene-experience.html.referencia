<template><div data-composition-id="scene-experience" data-start="0" data-width="1080" data-height="1920" data-duration="4.200000" style="position:relative;width:100%;height:100%"><div class="phase"><div class="eyebrow">05 · ¿TE HA PASADO?</div><h1 class="headline"><span>¿También</span><span>te pasó?</span></h1><div class="next">PIENSA EN ESA COMPRA</div></div></div><script>const root=document.querySelector('[data-composition-id="scene-experience"]');const tl=gsap.timeline({paused:true});window.__timelines=window.__timelines||{};window.__timelines['scene-experience']=tl;const label=root.querySelector('.eyebrow');const next=root.querySelector('.next');tl.set(label,{opacity:1},0);tl.fromTo(label,{y:10},{y:0,duration:.16,ease:'power4.out'},0);root.querySelectorAll('.headline span').forEach((el,n)=>{tl.set(el,{opacity:1},n*.12);tl.fromTo(el,{y:40+n*8},{y:0,duration:.18,ease:'power4.out'},n*.12);tl.set(el,{opacity:0},4.200000);});tl.set(next,{opacity:1},.34);tl.set([label,next],{opacity:0},4.200000);tl.seek(0);</script></template>