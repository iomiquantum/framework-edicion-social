<!doctype html><html><body><template><style>#root{position:absolute;inset:0;overflow:hidden}.accent{position:absolute;top:88px;left:54px;width:972px;height:558px;object-fit:contain;filter:drop-shadow(0 16px 36px rgba(0,0,0,.34))}.rule{position:absolute;top:625px;left:260px;right:260px;height:5px;border-radius:4px;background:linear-gradient(90deg,transparent,#D946EF,transparent)}</style><div id="root" data-composition-id="scene-cta" data-duration="5.300" data-width="1080" data-height="1920"><img class="accent" id="accent" src="assets/video-09_typographic_accent_v01.svg"><div class="rule" id="rule"></div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('#accent',{opacity:0,y:70,scale:.96},{opacity:1,y:0,scale:1,duration:.58,ease:'power4.out'},.05).fromTo('#rule',{scaleX:0},{scaleX:1,duration:.48,ease:'power2.out'},.28);window.__timelines=window.__timelines||{};window.__timelines['scene-cta']=tl;</script></template></body></html>