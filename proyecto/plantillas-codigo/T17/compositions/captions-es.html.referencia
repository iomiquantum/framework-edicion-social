<!doctype html><html lang="es"><body><template><style>@font-face{font-family:'Montserrat';font-weight:700;src:url('assets/fonts/Montserrat-700.woff2')}@font-face{font-family:'Montserrat';font-weight:900;src:url('assets/fonts/Montserrat-900.woff2')}#caption17-root{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.caption{position:absolute;left:108px;top:1160px;width:740px;height:188px;display:flex;align-items:center;justify-content:center;opacity:0}.caption-box{width:740px;padding:16px 22px;background:#0B3449;color:#F7F0E5;font-family:'Montserrat';font-size:60px;font-weight:700;line-height:72px;text-align:center;border-radius:6px}.cap-line{display:block;white-space:nowrap;letter-spacing:-1.1px;word-spacing:0}.caption strong{font-weight:900;color:#F4B379}</style><div id="caption17-root" data-composition-id="caption17" data-duration="27.733333333333334" data-width="1080" data-height="1920"><div id="cap17-01" class="clip caption" data-start="0.060000" data-duration="1.120000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>Te voy a decir algo:</div></div></div><div id="cap17-02" class="clip caption" data-start="1.180000" data-duration="1.800000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>el vendedor</div><div class="cap-line" data-layout-allow-overlap>que <strong>más habla</strong></div></div></div><div id="cap17-03" class="clip caption" data-start="2.980000" data-duration="1.990000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>muchas veces es</div><div class="cap-line" data-layout-allow-overlap>el que <strong>menos vende</strong>,</div></div></div><div id="cap17-04" class="clip caption" data-start="5.080000" data-duration="1.350000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>porque está</div><div class="cap-line" data-layout-allow-overlap>tan preocupado</div></div></div><div id="cap17-05" class="clip caption" data-start="6.430000" data-duration="0.950000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>por contarle todo</div></div></div><div id="cap17-06" class="clip caption" data-start="7.380000" data-duration="1.370000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>lo maravilloso</div><div class="cap-line" data-layout-allow-overlap>de <strong>su producto</strong></div></div></div><div id="cap17-07" class="clip caption" data-start="8.750000" data-duration="1.030000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>que nunca se detiene</div></div></div><div id="cap17-08" class="clip caption" data-start="9.780000" data-duration="2.460000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>a preguntarle qué</div><div class="cap-line" data-layout-allow-overlap><strong>necesita realmente</strong>.</div></div></div><div id="cap17-09" class="clip caption" data-start="12.500000" data-duration="1.550000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>Y si no entiendo</div><div class="cap-line" data-layout-allow-overlap><strong>tu problema</strong>,</div></div></div><div id="cap17-10" class="clip caption" data-start="14.050000" data-duration="1.910000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>probablemente</div><div class="cap-line" data-layout-allow-overlap>te voy a ofrecer</div></div></div><div id="cap17-11" class="clip caption" data-start="15.960000" data-duration="1.980000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>lo que <strong>yo</strong></div><div class="cap-line" data-layout-allow-overlap>quiero venderte,</div></div></div><div id="cap17-12" class="clip caption" data-start="17.980000" data-duration="1.540000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>no lo que</div><div class="cap-line" data-layout-allow-overlap><strong>tú necesitas</strong>.</div></div></div><div id="cap17-13" class="clip caption" data-start="19.720000" data-duration="1.810000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>Vender bien</div><div class="cap-line" data-layout-allow-overlap>no es <strong>hablar más</strong>;</div></div></div><div id="cap17-14" class="clip caption" data-start="21.530000" data-duration="1.500000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>es <strong>entender mejor</strong>.</div></div></div><div id="cap17-15" class="clip caption" data-start="23.480000" data-duration="1.020000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>¿Qué prefieres tú?</div></div></div><div id="cap17-16" class="clip caption" data-start="24.500000" data-duration="1.560000" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>¿Un vendedor</div><div class="cap-line" data-layout-allow-overlap>que <strong>explica mucho</strong></div></div></div><div id="cap17-17" class="clip caption" data-start="26.060000" data-duration="1.673333" data-track-index="0"><div class="caption-box"><div class="cap-line" data-layout-allow-overlap>o uno que</div><div class="cap-line" data-layout-allow-overlap><strong>pregunta bien</strong>?</div></div></div></div><script>const tl=gsap.timeline({paused:true});tl.set('.caption',{opacity:0},0);tl.set('#cap17-01',{opacity:1},0.060000);tl.set('#cap17-01',{opacity:0},1.180000);tl.set('#cap17-02',{opacity:1},1.180000);tl.set('#cap17-02',{opacity:0},2.980000);tl.set('#cap17-03',{opacity:1},2.980000);tl.set('#cap17-03',{opacity:0},4.970000);tl.set('#cap17-04',{opacity:1},5.080000);tl.set('#cap17-04',{opacity:0},6.430000);tl.set('#cap17-05',{opacity:1},6.430000);tl.set('#cap17-05',{opacity:0},7.380000);tl.set('#cap17-06',{opacity:1},7.380000);tl.set('#cap17-06',{opacity:0},8.750000);tl.set('#cap17-07',{opacity:1},8.750000);tl.set('#cap17-07',{opacity:0},9.780000);tl.set('#cap17-08',{opacity:1},9.780000);tl.set('#cap17-08',{opacity:0},12.240000);tl.set('#cap17-09',{opacity:1},12.500000);tl.set('#cap17-09',{opacity:0},14.050000);tl.set('#cap17-10',{opacity:1},14.050000);tl.set('#cap17-10',{opacity:0},15.960000);tl.set('#cap17-11',{opacity:1},15.960000);tl.set('#cap17-11',{opacity:0},17.940000);tl.set('#cap17-12',{opacity:1},17.980000);tl.set('#cap17-12',{opacity:0},19.520000);tl.set('#cap17-13',{opacity:1},19.720000);tl.set('#cap17-13',{opacity:0},21.530000);tl.set('#cap17-14',{opacity:1},21.530000);tl.set('#cap17-14',{opacity:0},23.030000);tl.set('#cap17-15',{opacity:1},23.480000);tl.set('#cap17-15',{opacity:0},24.500000);tl.set('#cap17-16',{opacity:1},24.500000);tl.set('#cap17-16',{opacity:0},26.060000);tl.set('#cap17-17',{opacity:1},26.060000);tl.set('#cap17-17',{opacity:0},27.733333);window.__timelines['caption17']=tl;</script></template></body></html>