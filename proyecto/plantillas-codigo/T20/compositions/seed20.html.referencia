<!DOCTYPE html><html lang="es"><head></head><body><template><style>@font-face{font-family:'EB Garamond';font-weight:700;src:url('assets/fonts/EBGaramond-700.woff2')}@font-face{font-family:'Inter';font-weight:700;src:url('assets/fonts/Inter-700.woff2')}#seed20-root{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}#seed20-inner{position:absolute;inset:0;width:100%;height:100%;opacity:1;overflow:hidden;color:#e8dfc8}#seed20-root .t20-title{position:absolute;top:110px;left:92px;width:896px;font-family:"EB Garamond";font-size:92px;font-weight:700;line-height:1.33;letter-spacing:-2px;opacity:0}#seed20-root .t20-shape{position:absolute;inset:0;width:1080px;height:1920px}#seed20-root .price20-leaf,#seed20-root .application20-leaf,#seed20-root .application20-flower,#seed20-root .understand20-head{opacity:0}#seed20-root #roots20-seed{opacity:0}#seed20-root .t20-bg{position:absolute;inset:0;background:#74513b}#seed20-root .seed20-tag{position:absolute;left:100px;top:1120px;padding:20px;color:#173b2d;background:#e8dfc8;font-family:"Inter";font-size:42px;opacity:0}</style><div data-hf-id="hf-x37e" id="seed20-root" data-composition-id="seed20" data-duration="1.866666667" data-width="1080" data-height="1920"><div data-hf-id="hf-t4xf" id="seed20-inner"><div data-hf-id="hf-v9cr" class="t20-bg" data-layout-ignore=""></div><div data-hf-id="hf-8ncr" class="t20-title">«Está caro»</div><svg data-hf-id="hf-l8x8" class="t20-shape" viewBox="0 0 1080 1920" aria-label="Raíces del motivo de una objeción"><circle data-hf-id="hf-mvpb" id="seed20-seed" cx="540" cy="520" r="86" fill="#e45d3d" /><path data-hf-id="hf-c115" class="seed20-rootline" d="M540 610C540 730 540 815 540 1040" fill="none" stroke="#f0cf85" stroke-width="15" stroke-linecap="round" /><path data-hf-id="hf-uoid" class="seed20-rootline" d="M540 740C445 785 400 840 370 980" fill="none" stroke="#f0cf85" stroke-width="15" stroke-linecap="round" /><path data-hf-id="hf-vm9d" class="seed20-rootline" d="M540 812C657 850 688 917 716 1018" fill="none" stroke="#f0cf85" stroke-width="15" stroke-linecap="round" /><path data-hf-id="hf-lirf" class="seed20-rootline" d="M540 902C483 990 476 1058 466 1155" fill="none" stroke="#f0cf85" stroke-width="15" stroke-linecap="round" /></svg><div data-hf-id="hf-3ocb" class="seed20-tag">Busca la raíz.</div></div></div><script>const tl=gsap.timeline({paused:true});tl.set('#seed20-inner',{opacity:1},0);tl.fromTo('#seed20-root .t20-title',{opacity:0,y:14},{opacity:1,y:0,duration:.28,ease:'power3.out',immediateRender:false},.17);document.querySelectorAll('#seed20-root .seed20-rootline').forEach((p,i)=>{const l=p.getTotalLength();p.style.strokeDasharray=l+' '+l;p.style.strokeDashoffset=l;tl.to(p,{strokeDashoffset:0,duration:0.65,ease:'power2.out'},0.32+i*0.1);});tl.fromTo('#seed20-seed',{scale:.8,opacity:1,transformOrigin:'50% 50%'},{scale:1,opacity:1,duration:.40,ease:'power3.out',immediateRender:false},0);tl.fromTo('.seed20-tag',{opacity:0,x:-14},{opacity:1,x:0,duration:.22,ease:'expo.out',immediateRender:false},1.10);tl.set('#seed20-inner',{opacity:0},1.866666667);window.__timelines['seed20']=tl;</script></template></body></html>