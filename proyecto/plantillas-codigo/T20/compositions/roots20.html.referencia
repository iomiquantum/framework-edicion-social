<!DOCTYPE html><html lang="es"><head></head><body><template><style>@font-face{font-family:'EB Garamond';font-weight:700;src:url('assets/fonts/EBGaramond-700.woff2')}@font-face{font-family:'Inter';font-weight:700;src:url('assets/fonts/Inter-700.woff2')}#roots20-root{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}#roots20-inner{position:absolute;inset:0;width:100%;height:100%;opacity:0;overflow:hidden;color:#e8dfc8}#roots20-root .t20-title{position:absolute;top:110px;left:92px;width:896px;font-family:"EB Garamond";font-size:92px;font-weight:700;line-height:1.33;letter-spacing:-2px;opacity:0}#roots20-root .t20-shape{position:absolute;inset:0;width:1080px;height:1920px}#roots20-root .price20-leaf,#roots20-root .application20-leaf,#roots20-root .application20-flower,#roots20-root .understand20-head{opacity:0}#roots20-root #roots20-seed{opacity:0}#roots20-root .t20-bg{position:absolute;inset:0;background:#74513b}</style><div data-hf-id="hf-zsyd" id="roots20-root" data-composition-id="roots20" data-duration="2.066666667" data-width="1080" data-height="1920"><div data-hf-id="hf-hce5" id="roots20-inner"><div data-hf-id="hf-v9cr" class="t20-bg" data-layout-ignore=""></div><div data-hf-id="hf-80hr" class="t20-title"><div data-hf-id="hf-c48q">¿Con qué</div><div data-hf-id="hf-yy7f">lo compara?</div></div><svg data-hf-id="hf-l8x8" class="t20-shape" viewBox="0 0 1080 1920" aria-label="Raíces del motivo de una objeción"><circle data-hf-id="hf-ekdd" id="roots20-seed" cx="540" cy="520" r="86" fill="#e45d3d" /><path data-hf-id="hf-bkdx" class="roots20-rootline" d="M540 610C540 730 540 815 540 1040" fill="none" stroke="#f0cf85" stroke-width="15" stroke-linecap="round" /><path data-hf-id="hf-q96h" class="roots20-rootline" d="M540 740C445 785 400 840 370 980" fill="none" stroke="#f0cf85" stroke-width="15" stroke-linecap="round" /><path data-hf-id="hf-pg19" class="roots20-rootline" d="M540 812C657 850 688 917 716 1018" fill="none" stroke="#f0cf85" stroke-width="15" stroke-linecap="round" /><path data-hf-id="hf-kx0f" class="roots20-rootline" d="M540 902C483 990 476 1058 466 1155" fill="none" stroke="#f0cf85" stroke-width="15" stroke-linecap="round" /></svg></div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('#roots20-inner',{opacity:0},{opacity:1,duration:.15,ease:'power1.out',immediateRender:false},0);tl.fromTo('#roots20-root .t20-title',{opacity:0,y:14},{opacity:1,y:0,duration:.28,ease:'power3.out',immediateRender:false},.17);document.querySelectorAll('#roots20-root .roots20-rootline').forEach((p,i)=>{const l=p.getTotalLength();p.style.strokeDasharray=l+' '+l;p.style.strokeDashoffset=l;tl.to(p,{strokeDashoffset:0,duration:0.68,ease:'power2.out'},0.27+i*0.22);});tl.fromTo('#roots20-seed',{scale:.4,opacity:0,transformOrigin:'50% 50%'},{scale:1,opacity:1,duration:.38,ease:'power3.out',immediateRender:false},.20);tl.set('#roots20-inner',{opacity:0},2.066666667);window.__timelines['roots20']=tl;</script></template></body></html>