<!DOCTYPE html><html lang="es"><head></head><body><template><style>@font-face{font-family:'EB Garamond';font-weight:700;src:url('assets/fonts/EBGaramond-700.woff2')}@font-face{font-family:'Inter';font-weight:700;src:url('assets/fonts/Inter-700.woff2')}#application20-root{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}#application20-inner{position:absolute;inset:0;width:100%;height:100%;opacity:0;overflow:hidden;color:#e8dfc8}#application20-root .t20-title{position:absolute;top:110px;left:92px;width:896px;font-family:"EB Garamond";font-size:92px;font-weight:700;line-height:1.33;letter-spacing:-2px;opacity:0}#application20-root .t20-shape{position:absolute;inset:0;width:1080px;height:1920px}#application20-root .price20-leaf,#application20-root .application20-leaf,#application20-root .application20-flower,#application20-root .understand20-head{opacity:0}#application20-root #roots20-seed{opacity:0}#application20-root .t20-bg{position:absolute;inset:0;background:#173b2d}</style><div data-hf-id="hf-d45s" id="application20-root" data-composition-id="application20" data-duration="2.633333333" data-width="1080" data-height="1920"><div data-hf-id="hf-qj5c" id="application20-inner"><div data-hf-id="hf-v9cr" class="t20-bg" data-layout-ignore=""></div><div data-hf-id="hf-80hr" class="t20-title"><div data-hf-id="hf-vicu">¿Qué te dicen</div><div data-hf-id="hf-gbcw">tus clientes?</div></div><svg data-hf-id="hf-9m42" class="t20-shape" viewBox="0 0 1080 1920" aria-label="Flor como metáfora de entender antes de responder"><path data-hf-id="hf-s4rr" class="application20-stem" d="M540 1140V715" stroke="#2d806d" stroke-width="18" fill="none" /><path data-hf-id="hf-ntuj" class="application20-leaf" d="M540 980C281 963 224 780 224 780C455 722 546 890 540 980Z" fill="#68a866" /><path data-hf-id="hf-w1ri" class="application20-leaf" d="M540 910C817 886 846 717 846 717C635 682 520 840 540 910Z" fill="#68a866" /><circle data-hf-id="hf-6psl" class="application20-flower" cx="540" cy="640" r="168" fill="#e45d3d" /><circle data-hf-id="hf-6cl6" class="application20-flower" cx="540" cy="640" r="98" fill="#f0cf85" /></svg></div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('#application20-inner',{opacity:0},{opacity:1,duration:.15,ease:'power1.out',immediateRender:false},0);tl.fromTo('#application20-root .t20-title',{opacity:0,y:14},{opacity:1,y:0,duration:.28,ease:'power3.out',immediateRender:false},.17);document.querySelectorAll('#application20-root .application20-stem').forEach((p,i)=>{const l=p.getTotalLength();p.style.strokeDasharray=l+' '+l;p.style.strokeDashoffset=l;tl.to(p,{strokeDashoffset:0,duration:0.5,ease:'power2.out'},0.21+i*0);});tl.fromTo('#application20-root .application20-leaf',{scale:0,opacity:0,transformOrigin:'50% 100%'},{scale:1,opacity:1,duration:.48,stagger:.07,ease:'power3.out',immediateRender:false},.38);tl.fromTo('#application20-root .application20-flower',{scale:0,opacity:0,transformOrigin:'50% 50%'},{scale:1,opacity:1,duration:.46,stagger:.06,ease:'expo.out',immediateRender:false},.60);tl.set('#application20-inner',{opacity:0},2.633333333);window.__timelines['application20']=tl;</script></template></body></html>