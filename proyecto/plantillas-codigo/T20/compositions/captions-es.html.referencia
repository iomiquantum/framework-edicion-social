<!DOCTYPE html><html lang="es"><head></head><body><template><style>@font-face{font-family:'EB Garamond';font-weight:700;src:url('assets/fonts/EBGaramond-700.woff2')}@font-face{font-family:'Inter';font-weight:700;src:url('assets/fonts/Inter-700.woff2')}#caption20-root{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.cue20{position:absolute;left:80px;top:1440px;width:920px;height:186px}.cue20-inner{width:920px;height:186px;padding:20px 24px;background:#173b2d;color:#f5f0e4;font-family:"Inter";font-size:58px;font-weight:700;line-height:68.44px;text-align:center;display:flex;align-items:center;justify-content:center;opacity:0}.cue20-inner span{display:block;white-space:normal;letter-spacing:-.4px;word-spacing:0}</style><div data-hf-id="hf-jhy8" id="caption20-root" data-composition-id="caption20" data-duration="24.933333333333334" data-width="1080" data-height="1920"><div data-hf-id="hf-xb9i" id="cap20-01" class="clip cue20" data-start="0.140000000" data-duration="1.760000000" data-track-index="0"><div data-hf-id="hf-uyor" id="cap20-01-inner" class="cue20-inner"><span data-hf-id="hf-55x2">Cuando un cliente te dice: «Está caro»,</span></div></div><div data-hf-id="hf-3bg9" id="cap20-02" class="clip cue20" data-start="1.920000000" data-duration="1.930000000" data-track-index="0"><div data-hf-id="hf-qp90" id="cap20-02-inner" class="cue20-inner"><span data-hf-id="hf-lmfg">no defiendas el precio todavía.</span></div></div><div data-hf-id="hf-ldpl" id="cap20-03" class="clip cue20" data-start="4.070000000" data-duration="1.790000000" data-track-index="0"><div data-hf-id="hf-h3m9" id="cap20-03-inner" class="cue20-inner"><span data-hf-id="hf-c6aw">Porque eso es lo primero que hacemos.</span></div></div><div data-hf-id="hf-2pgc" id="cap20-04" class="clip cue20" data-start="5.900000000" data-duration="2.280000000" data-track-index="0"><div data-hf-id="hf-257u" id="cap20-04-inner" class="cue20-inner"><span data-hf-id="hf-vzby">No, mira, es que incluye esto y esto,</span></div></div><div data-hf-id="hf-agtk" id="cap20-05" class="clip cue20" data-start="8.200000000" data-duration="1.860000000" data-track-index="0"><div data-hf-id="hf-nlan" id="cap20-05-inner" class="cue20-inner"><span data-hf-id="hf-b2ih">pero ni siquiera sabemos</span></div></div><div data-hf-id="hf-fgh7" id="cap20-06" class="clip cue20" data-start="10.080000000" data-duration="2.800000000" data-track-index="0"><div data-hf-id="hf-xmfc" id="cap20-06-inner" class="cue20-inner"><span data-hf-id="hf-ryou">qué está comparando el cliente.</span></div></div><div data-hf-id="hf-ud4o" id="cap20-07" class="clip cue20" data-start="13.180000000" data-duration="1.780000000" data-track-index="0"><div data-hf-id="hf-sbhx" id="cap20-07-inner" class="cue20-inner"><span data-hf-id="hf-0qsy">De pronto está comparando tu servicio</span></div></div><div data-hf-id="hf-ihyt" id="cap20-08" class="clip cue20" data-start="14.960000000" data-duration="1.800000000" data-track-index="0"><div data-hf-id="hf-wlby" id="cap20-08-inner" class="cue20-inner"><span data-hf-id="hf-am09">de mil dólares contra uno de cien,</span></div></div><div data-hf-id="hf-tawj" id="cap20-09" class="clip cue20" data-start="16.760000000" data-duration="2.280000000" data-track-index="0"><div data-hf-id="hf-k85f" id="cap20-09-inner" class="cue20-inner"><span data-hf-id="hf-tw7o">o de pronto ni siquiera entendió el valor.</span></div></div><div data-hf-id="hf-vk77" id="cap20-10" class="clip cue20" data-start="19.430000000" data-duration="0.980000000" data-track-index="0"><div data-hf-id="hf-ubyd" id="cap20-10-inner" class="cue20-inner"><span data-hf-id="hf-t0qp">Antes de defender tu precio,</span></div></div><div data-hf-id="hf-swgy" id="cap20-11" class="clip cue20" data-start="20.420000000" data-duration="1.780000000" data-track-index="0"><div data-hf-id="hf-3tlk" id="cap20-11-inner" class="cue20-inner"><span data-hf-id="hf-hyn0">entiende la comparación.</span></div></div><div data-hf-id="hf-z79i" id="cap20-12" class="clip cue20" data-start="22.420000000" data-duration="2.450000000" data-track-index="0"><div data-hf-id="hf-q6vz" id="cap20-12-inner" class="cue20-inner"><span data-hf-id="hf-k06p">¿Cuál es la objeción que más escuchas en tu negocio?</span></div></div></div><script>const tl=gsap.timeline({paused:true});tl.set('#cap20-01-inner',{opacity:1},0.140000000);tl.set('#cap20-01-inner',{opacity:0},1.900000000);tl.set('#cap20-02-inner',{opacity:1},1.920000000);tl.set('#cap20-02-inner',{opacity:0},3.850000000);tl.set('#cap20-03-inner',{opacity:1},4.070000000);tl.set('#cap20-03-inner',{opacity:0},5.860000000);tl.set('#cap20-04-inner',{opacity:1},5.900000000);tl.set('#cap20-04-inner',{opacity:0},8.180000000);tl.set('#cap20-05-inner',{opacity:1},8.200000000);tl.set('#cap20-05-inner',{opacity:0},10.060000000);tl.set('#cap20-06-inner',{opacity:1},10.080000000);tl.set('#cap20-06-inner',{opacity:0},12.880000000);tl.set('#cap20-07-inner',{opacity:1},13.180000000);tl.set('#cap20-07-inner',{opacity:0},14.960000000);tl.set('#cap20-08-inner',{opacity:1},14.960000000);tl.set('#cap20-08-inner',{opacity:0},16.760000000);tl.set('#cap20-09-inner',{opacity:1},16.760000000);tl.set('#cap20-09-inner',{opacity:0},19.040000000);tl.set('#cap20-10-inner',{opacity:1},19.430000000);tl.set('#cap20-10-inner',{opacity:0},20.410000000);tl.set('#cap20-11-inner',{opacity:1},20.420000000);tl.set('#cap20-11-inner',{opacity:0},22.200000000);tl.set('#cap20-12-inner',{opacity:1},22.420000000);tl.set('#cap20-12-inner',{opacity:0},24.870000000);window.__timelines['caption20']=tl;</script></template></body></html>