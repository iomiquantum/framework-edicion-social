<!DOCTYPE html><html lang="es"><head></head><body><template><style>@font-face{font-family:'EB Garamond';font-weight:700;src:url('assets/fonts/EBGaramond-700.woff2')}@font-face{font-family:'Inter';font-weight:700;src:url('assets/fonts/Inter-700.woff2')}#understand20-root{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}#understand20-inner{position:absolute;inset:0;width:100%;height:100%;opacity:0;overflow:hidden;color:#173b2d}#understand20-root .t20-title{position:absolute;top:110px;left:92px;width:896px;font-family:"EB Garamond";font-size:92px;font-weight:700;line-height:1.33;letter-spacing:-2px;opacity:0}#understand20-root .t20-shape{position:absolute;inset:0;width:1080px;height:1920px}#understand20-root .price20-leaf,#understand20-root .application20-leaf,#understand20-root .application20-flower,#understand20-root .understand20-head{opacity:0}#understand20-root #roots20-seed{opacity:0}#understand20-root .t20-bg{position:absolute;inset:0;background:transparent}#understand20-flower{position:absolute;left:818px;top:102px;width:155px;height:235px;opacity:0}</style><div data-hf-id="hf-vfjv" id="understand20-root" data-composition-id="understand20" data-duration="3.000000000" data-width="1080" data-height="1920"><div data-hf-id="hf-0fsa" id="understand20-inner"><div data-hf-id="hf-80hr" class="t20-title"><div data-hf-id="hf-38xo">Primero,</div><div data-hf-id="hf-yx27">comprende.</div></div><svg data-hf-id="hf-nu7e" id="understand20-flower" class="understand20-flower" viewBox="0 0 160 240" aria-label="Comprensión que crece"><path data-hf-id="hf-fcjd" class="understand20-stem" d="M80 220V80" stroke="#2d806d" stroke-width="9" fill="none" /><path data-hf-id="hf-0r1d" d="M80 164C36 159 16 129 16 129C61 118 92 144 80 164Z" fill="#2d806d" /><circle data-hf-id="hf-a3bb" class="understand20-head" cx="80" cy="70" r="46" fill="#e45d3d" /><circle data-hf-id="hf-43nl" class="understand20-head" cx="80" cy="70" r="25" fill="#f0cf85" /></svg></div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('#understand20-inner',{opacity:0},{opacity:1,duration:.15,ease:'power1.out',immediateRender:false},0);tl.fromTo('#understand20-root .t20-title',{opacity:0,y:14},{opacity:1,y:0,duration:.28,ease:'power3.out',immediateRender:false},.17);tl.set('#understand20-flower',{opacity:1},1.09);document.querySelectorAll('#understand20-root .understand20-stem').forEach((p,i)=>{const l=p.getTotalLength();p.style.strokeDasharray=l+' '+l;p.style.strokeDashoffset=l;tl.to(p,{strokeDashoffset:0,duration:0.45,ease:'power2.out'},1.1+i*0);});tl.fromTo('#understand20-root .understand20-head',{scale:0,opacity:0,transformOrigin:'50% 50%'},{scale:1,opacity:1,duration:.35,ease:'power3.out',immediateRender:false},1.30);tl.set('#understand20-inner',{opacity:0},3.000000000);window.__timelines['understand20']=tl;</script></template></body></html>