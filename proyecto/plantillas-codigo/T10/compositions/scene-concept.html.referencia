<!doctype html><html><body><template><style>#root{position:absolute;inset:0;font-family:Avenir Next,Arial,sans-serif;color:white;overflow:hidden}.card{position:absolute;top:120px;left:82px;right:82px;height:430px;border-radius:42px;background:linear-gradient(145deg,rgba(7,17,31,.92),rgba(7,17,31,.58));border:2px solid #4FD1C588;box-shadow:0 24px 80px rgba(0,0,0,.24);display:flex;align-items:center;padding:56px}.icon{width:250px;height:250px;object-fit:contain;filter:drop-shadow(0 12px 30px #4FD1C544)}.copy{font-size:57px;line-height:1.02;font-weight:900;letter-spacing:-2px;margin-left:28px;color:white}.copy em{display:block;color:#4FD1C5;font-style:normal}</style><div id="root" data-composition-id="scene-concept" data-duration="5.200" data-width="1080" data-height="1920"><div class="card" id="card"><img class="icon" src="assets/video-10_problem_searchlight_overlay_v01.svg"><div class="copy">RESPONDER YA NO BASTA</div></div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('#card',{opacity:0,x:80},{opacity:1,x:0,duration:.55,ease:'power3.out'},.08).to('#card',{y:-8,duration:4.30,ease:'none'},.63);window.__timelines=window.__timelines||{};window.__timelines['scene-concept']=tl;</script></template></body></html>