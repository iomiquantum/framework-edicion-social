<template><div id="scene-audiencia-root" data-composition-id="scene-audiencia" data-width="1080" data-height="1920" data-duration="4.800000000" style="position:relative;width:100%;height:100%"><h1 id="scene-audiencia-headline" class="headline"><span>La audiencia</span><span>correcta.</span></h1></div><script>const root=document.querySelector('[data-composition-id="scene-audiencia"]');const h=root.querySelector('.headline');gsap.set(h,{opacity:0});const tl=gsap.timeline({paused:true});tl.fromTo(h,{opacity:0},{opacity:1,duration:.3,ease:"sine.inOut"},0);tl.to(h,{opacity:0,duration:.15,ease:"sine.inOut"},4.650000);window.__timelines['scene-audiencia']=tl;tl.seek(0);</script></template>