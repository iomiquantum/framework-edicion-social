<template><div id="scene-eleccion-root" data-composition-id="scene-eleccion" data-width="1080" data-height="1920" data-duration="4.233333333" style="position:relative;width:100%;height:100%"><h1 id="scene-eleccion-headline" class="headline"><span>¿A quién</span><span>quieres llegar?</span></h1></div><script>const root=document.querySelector('[data-composition-id="scene-eleccion"]');const h=root.querySelector('.headline');gsap.set(h,{opacity:0});const tl=gsap.timeline({paused:true});tl.fromTo(h,{opacity:0},{opacity:1,duration:.3,ease:"sine.inOut"},0);tl.to(h,{opacity:0,duration:.15,ease:"sine.inOut"},4.083333);window.__timelines['scene-eleccion']=tl;tl.seek(0);</script></template>