<template><div id="scene-negocio-root" data-composition-id="scene-negocio" data-width="1080" data-height="1920" data-duration="2.833333333" style="position:relative;width:100%;height:100%"><h1 id="scene-negocio-headline" class="headline"><span>Alcance no es</span><span>negocio.</span></h1></div><script>const root=document.querySelector('[data-composition-id="scene-negocio"]');const h=root.querySelector('.headline');gsap.set(h,{opacity:0});const tl=gsap.timeline({paused:true});tl.fromTo(h,{opacity:0},{opacity:1,duration:.3,ease:"sine.inOut"},0);tl.to(h,{opacity:0,duration:.15,ease:"sine.inOut"},2.683333);window.__timelines['scene-negocio']=tl;tl.seek(0);</script></template>