<template><div id="captions-root" data-composition-id="captions-es" data-width="1080" data-height="1920" data-duration="24.666666667" style="position:relative;width:100%;height:100%"><div id="cap-0" class="clip caption" data-start="0.000000000" data-duration="2.466666667" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">Yo prefiero 20.000</span><span class="caption-line">vistas correctas</span></p></div><div id="cap-1" class="clip caption" data-start="2.466666667" data-duration="2.333333333" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">antes que un millón</span><span class="caption-line">que no me sirve para nada.</span></p></div><div id="cap-2" class="clip caption" data-start="4.800000000" data-duration="2.533333333" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">Porque si un millón de</span><span class="caption-line">personas ven tu video,</span></p></div><div id="cap-3" class="clip caption" data-start="7.333333333" data-duration="2.166666667" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">se ríen y se van,</span><span class="caption-line">¿qué construiste?</span></p></div><div id="cap-4" class="clip caption" data-start="9.500000000" data-duration="3.133333333" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">Ahora, si 20.000</span><span class="caption-line">entienden quién eres,</span></p></div><div id="cap-5" class="clip caption" data-start="12.633333333" data-duration="2.666666667" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">confían en ti y quieren</span><span class="caption-line">seguir escuchándote,</span></p></div><div id="cap-6" class="clip caption" data-start="15.300000000" data-duration="2.300000000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">eso ya empieza a</span><span class="caption-line">construirse como un activo.</span></p></div><div id="cap-7" class="clip caption" data-start="17.600000000" data-duration="2.833333333" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">Viralidad no siempre</span><span class="caption-line">significa negocio.</span></p></div><div id="cap-8" class="clip caption" data-start="20.433333333" data-duration="1.066666667" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">¿Qué escogerías tú?</span></p></div><div id="cap-9" class="clip caption" data-start="21.500000000" data-duration="1.400000000" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">¿Un millón de vistas</span></p></div><div id="cap-10" class="clip caption" data-start="22.900000000" data-duration="1.766666667" data-track-index="8" data-track-kind="captions"><p><span class="caption-line">o 20.000 personas</span><span class="caption-line">correctas?</span></p></div></div><script>const root=document.querySelector('[data-composition-id="captions-es"]');const tl=gsap.timeline({paused:true});const p0=root.querySelector("#cap-0 p");gsap.set(p0,{opacity:0});tl.set(p0,{opacity:1},0.000000000);tl.set(p0,{opacity:0},2.466666667);const p1=root.querySelector("#cap-1 p");gsap.set(p1,{opacity:0});tl.set(p1,{opacity:1},2.466666667);tl.set(p1,{opacity:0},4.800000000);const p2=root.querySelector("#cap-2 p");gsap.set(p2,{opacity:0});tl.set(p2,{opacity:1},4.800000000);tl.set(p2,{opacity:0},7.333333333);const p3=root.querySelector("#cap-3 p");gsap.set(p3,{opacity:0});tl.set(p3,{opacity:1},7.333333333);tl.set(p3,{opacity:0},9.500000000);const p4=root.querySelector("#cap-4 p");gsap.set(p4,{opacity:0});tl.set(p4,{opacity:1},9.500000000);tl.set(p4,{opacity:0},12.633333333);const p5=root.querySelector("#cap-5 p");gsap.set(p5,{opacity:0});tl.set(p5,{opacity:1},12.633333333);tl.set(p5,{opacity:0},15.300000000);const p6=root.querySelector("#cap-6 p");gsap.set(p6,{opacity:0});tl.set(p6,{opacity:1},15.300000000);tl.set(p6,{opacity:0},17.600000000);const p7=root.querySelector("#cap-7 p");gsap.set(p7,{opacity:0});tl.set(p7,{opacity:1},17.600000000);tl.set(p7,{opacity:0},20.433333333);const p8=root.querySelector("#cap-8 p");gsap.set(p8,{opacity:0});tl.set(p8,{opacity:1},20.433333333);tl.set(p8,{opacity:0},21.500000000);const p9=root.querySelector("#cap-9 p");gsap.set(p9,{opacity:0});tl.set(p9,{opacity:1},21.500000000);tl.set(p9,{opacity:0},22.900000000);const p10=root.querySelector("#cap-10 p");gsap.set(p10,{opacity:0});tl.set(p10,{opacity:1},22.900000000);tl.set(p10,{opacity:0},24.666666667);window.__timelines["captions-es"]=tl;tl.seek(0);</script></template>