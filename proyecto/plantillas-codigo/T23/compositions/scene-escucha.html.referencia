<template><div id="scene-escucha-root" data-composition-id="scene-escucha" data-width="1080" data-height="1920" data-duration="8.100000000" style="position:relative;width:100%;height:100%"><h1 id="scene-escucha-headline" class="headline"><span>Que quieran</span><span>escucharte.</span></h1></div><script>const root=document.querySelector('[data-composition-id="scene-escucha"]');const h=root.querySelector('.headline');gsap.set(h,{opacity:0});const tl=gsap.timeline({paused:true});tl.fromTo(h,{opacity:0},{opacity:1,duration:.3,ease:"sine.inOut"},0);tl.to(h,{opacity:0,duration:.15,ease:"sine.inOut"},7.950000);window.__timelines['scene-escucha']=tl;tl.seek(0);</script></template>