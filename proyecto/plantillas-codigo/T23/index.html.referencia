<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script><style>@font-face{font-family:CalmaSerif;src:url(assets/fonts/EBGaramond-700.woff2);font-weight:700;font-display:block}@font-face{font-family:CalmaSans;src:url(assets/fonts/Montserrat-800.woff2);font-weight:800;font-display:block}*{box-sizing:border-box;margin:0;padding:0}html,body{width:100%;height:100%;overflow:hidden}#main{position:relative;width:100%;height:100%;overflow:hidden;color:#243C32;font-family:CalmaSans,sans-serif}#bed{position:absolute;inset:0;background:#DFE7DC}#halo{position:absolute;left:190px;top:1400px;width:700px;height:700px;border-radius:50%;background:#D0DFD3}#halo-core{position:absolute;left:330px;top:1540px;width:420px;height:420px;border-radius:50%;background:#B9CEC0}.presenter{position:absolute;left:80px;top:330px;width:920px;height:820px;object-fit:cover;object-position:50% 35%;border-radius:38px;z-index:1}.image-panel{position:absolute;left:80px;top:330px;width:920px;height:820px;object-fit:cover;border-radius:38px;z-index:2}#image-bed{position:absolute;left:80px;top:330px;width:920px;height:820px;border-radius:38px;background:#DFE7DC;z-index:2}.scene-mount{position:absolute;inset:0;z-index:4}.headline{position:absolute;left:90px;top:40px;width:900px;font-family:CalmaSerif,serif;font-size:94px;line-height:1.4;font-weight:700;letter-spacing:-1.5px;opacity:0}.headline span{display:block}.headline span:last-child{color:#85516E}.caption{position:absolute;left:80px;top:1185px;width:920px;text-align:center}.caption p{opacity:0;width:100%;background:#F5EFE4;color:#243C32;border-radius:30px;padding:23px 20px;font-family:CalmaSans,sans-serif;font-size:58px;line-height:1.16;font-weight:800;word-spacing:1px}.caption-line{display:block}#mount-captions{z-index:8}</style></head><body><div id="main" data-composition-id="main" data-width="1080" data-height="1920" data-fps="30" data-duration="24.666666667"><div id="bed"></div><div id="halo" data-layout-ignore></div><div id="halo-core" data-layout-ignore></div><video id="presenter" class="clip presenter" src="assets/video23-master-hlg-v1.mp4" muted playsinline data-start="0" data-duration="24.666666667" data-media-start="0" data-track-index="0" data-track-kind="video"></video><div id="image-bed" class="clip" data-start="12.633333333" data-duration="2" data-track-index="1" data-track-kind="graphics"></div><img id="escucha" class="clip image-panel" src="assets/escucha-atenta-v3.png" alt="Ilustración generada de una mujer escuchando un video educativo" data-start="12.633333333" data-duration="2" data-track-index="2" data-track-kind="image"><div id="mount-scene-audiencia" class="clip scene-mount" data-composition-id="scene-audiencia" data-composition-src="compositions/scene-audiencia.html" data-start="0.000000000" data-duration="4.800000000" data-width="1080" data-height="1920" data-track-index="3" data-track-kind="graphics"></div><div id="mount-scene-confianza" class="clip scene-mount" data-composition-id="scene-confianza" data-composition-src="compositions/scene-confianza.html" data-start="4.800000000" data-duration="4.700000000" data-width="1080" data-height="1920" data-track-index="3" data-track-kind="graphics"></div><div id="mount-scene-escucha" class="clip scene-mount" data-composition-id="scene-escucha" data-composition-src="compositions/scene-escucha.html" data-start="9.500000000" data-duration="8.100000000" data-width="1080" data-height="1920" data-track-index="3" data-track-kind="graphics"></div><div id="mount-scene-negocio" class="clip scene-mount" data-composition-id="scene-negocio" data-composition-src="compositions/scene-negocio.html" data-start="17.600000000" data-duration="2.833333333" data-width="1080" data-height="1920" data-track-index="3" data-track-kind="graphics"></div><div id="mount-scene-eleccion" class="clip scene-mount" data-composition-id="scene-eleccion" data-composition-src="compositions/scene-eleccion.html" data-start="20.433333333" data-duration="4.233333333" data-width="1080" data-height="1920" data-track-index="3" data-track-kind="graphics"></div><div id="mount-captions" class="clip scene-mount" data-composition-id="captions-es" data-composition-src="compositions/captions-es.html" data-start="0" data-duration="24.666666667" data-width="1080" data-height="1920" data-track-index="8" data-track-kind="captions"></div><audio id="voice" src="assets/video23-voice-clean-normalized-v3.wav" data-start="0" data-duration="24.666666667" data-volume="1" data-track-index="20" data-track-kind="voice"></audio><audio id="sfx-audiencia" src="assets/sfx-audiencia-mix-v3.wav" data-start="0.100000000" data-duration="0.58" data-volume="1" data-track-index="30" data-track-kind="sfx"></audio><audio id="sfx-enfasis-negocio" src="assets/sfx-enfasis-negocio-mix-v3.wav" data-start="17.433333333" data-duration="0.16" data-volume="1" data-track-index="30" data-track-kind="sfx"></audio><audio id="sfx-escucha" src="assets/sfx-escucha-mix-v3.wav" data-start="12.633333333" data-duration="0.58" data-volume="1" data-track-index="30" data-track-kind="sfx"></audio></div><script>const tl=gsap.timeline({paused:true});tl.to('#halo',{scale:1.012,duration:4,ease:'sine.inOut',yoyo:true,repeat:4},0);window.__timelines.main=tl;tl.seek(0);</script></body></html>