<!doctype html><html lang="es"><body><template><style>@font-face{font-family:'Montserrat';font-weight:700;src:url('assets/fonts/Montserrat-700.woff2')}@font-face{font-family:'Montserrat';font-weight:900;src:url('assets/fonts/Montserrat-900.woff2')}@font-face{font-family:'IBM Plex Mono';font-weight:500;src:url('assets/fonts/IBMPlexMono-500.woff2')}#caption19-root{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.cue19{position:absolute;left:100px;top:1280px;width:880px;height:190px;display:flex;align-items:flex-start;justify-content:center}.cue19-inner{width:880px;padding:14px 24px;background:#f7f4d5;color:#0d1028;border:6px solid #0d1028;box-shadow:10px 10px 0 #68e05a;font-family:'Montserrat';font-size:64px;font-weight:700;line-height:74px;text-align:center;opacity:0}.cue19-text{display:block;white-space:normal;letter-spacing:-1.6px;word-spacing:0}</style><div id="caption19-root" data-composition-id="caption19" data-duration="29.6" data-width="1080" data-height="1920"><div id="cap19-01" class="clip cue19" data-start="0.060000" data-duration="1.700000" data-track-index="0"><div id="cap19-01-inner" class="cue19-inner"><span class="cue19-text">¿Tú pagarías cinco mil dólares</span></div></div><div id="cap19-02" class="clip cue19" data-start="1.800000" data-duration="1.280000" data-track-index="0"><div id="cap19-02-inner" class="cue19-inner"><span class="cue19-text">por algo sin ni siquiera</span></div></div><div id="cap19-03" class="clip cue19" data-start="3.080000" data-duration="1.640000" data-track-index="0"><div id="cap19-03-inner" class="cue19-inner"><span class="cue19-text">poder hablar con una persona?</span></div></div><div id="cap19-04" class="clip cue19" data-start="5.060000" data-duration="1.180000" data-track-index="0"><div id="cap19-04-inner" class="cue19-inner"><span class="cue19-text">Porque aquí veo algo</span></div></div><div id="cap19-05" class="clip cue19" data-start="6.240000" data-duration="0.980000" data-track-index="0"><div id="cap19-05-inner" class="cue19-inner"><span class="cue19-text">muy interesante:</span></div></div><div id="cap19-06" class="clip cue19" data-start="7.220000" data-duration="1.230000" data-track-index="0"><div id="cap19-06-inner" class="cue19-inner"><span class="cue19-text">una contradicción</span></div></div><div id="cap19-07" class="clip cue19" data-start="8.450000" data-duration="0.950000" data-track-index="0"><div id="cap19-07-inner" class="cue19-inner"><span class="cue19-text">muy interesante.</span></div></div><div id="cap19-08" class="clip cue19" data-start="9.860000" data-duration="1.990000" data-track-index="0"><div id="cap19-08-inner" class="cue19-inner"><span class="cue19-text">Queremos automatizar absolutamente todo,</span></div></div><div id="cap19-09" class="clip cue19" data-start="12.180000" data-duration="1.220000" data-track-index="0"><div id="cap19-09-inner" class="cue19-inner"><span class="cue19-text">pero mientras más importante</span></div></div><div id="cap19-10" class="clip cue19" data-start="13.400000" data-duration="1.020000" data-track-index="0"><div id="cap19-10-inner" class="cue19-inner"><span class="cue19-text">es una decisión,</span></div></div><div id="cap19-11" class="clip cue19" data-start="14.700000" data-duration="0.920000" data-track-index="0"><div id="cap19-11-inner" class="cue19-inner"><span class="cue19-text">más necesito sentir</span></div></div><div id="cap19-12" class="clip cue19" data-start="15.620000" data-duration="1.480000" data-track-index="0"><div id="cap19-12-inner" class="cue19-inner"><span class="cue19-text">que alguien responde detrás.</span></div></div><div id="cap19-13" class="clip cue19" data-start="17.340000" data-duration="1.260000" data-track-index="0"><div id="cap19-13-inner" class="cue19-inner"><span class="cue19-text">De pronto, para comprar algo</span></div></div><div id="cap19-14" class="clip cue19" data-start="18.600000" data-duration="1.290000" data-track-index="0"><div id="cap19-14-inner" class="cue19-inner"><span class="cue19-text">de veinte dólares me da igual,</span></div></div><div id="cap19-15" class="clip cue19" data-start="20.240000" data-duration="1.440000" data-track-index="0"><div id="cap19-15-inner" class="cue19-inner"><span class="cue19-text">pero para cinco mil cambia.</span></div></div><div id="cap19-16" class="clip cue19" data-start="21.820000" data-duration="1.330000" data-track-index="0"><div id="cap19-16-inner" class="cue19-inner"><span class="cue19-text">No todo lo que puede automatizarse</span></div></div><div id="cap19-17" class="clip cue19" data-start="23.150000" data-duration="1.470000" data-track-index="0"><div id="cap19-17-inner" class="cue19-inner"><span class="cue19-text">debería automatizarse igual.</span></div></div><div id="cap19-18" class="clip cue19" data-start="24.820000" data-duration="0.990000" data-track-index="0"><div id="cap19-18-inner" class="cue19-inner"><span class="cue19-text">Entonces, pregúntate:</span></div></div><div id="cap19-19" class="clip cue19" data-start="25.860000" data-duration="1.190000" data-track-index="0"><div id="cap19-19-inner" class="cue19-inner"><span class="cue19-text">¿desde qué monto tú ya</span></div></div><div id="cap19-20" class="clip cue19" data-start="27.310000" data-duration="2.110000" data-track-index="0"><div id="cap19-20-inner" class="cue19-inner"><span class="cue19-text">necesitarías hablar con una persona?</span></div></div></div><script>const tl=gsap.timeline({paused:true});tl.set('#cap19-01-inner',{opacity:1},0.060000);tl.set('#cap19-01-inner',{opacity:0},1.760000);tl.set('#cap19-02-inner',{opacity:1},1.800000);tl.set('#cap19-02-inner',{opacity:0},3.080000);tl.set('#cap19-03-inner',{opacity:1},3.080000);tl.set('#cap19-03-inner',{opacity:0},4.720000);tl.set('#cap19-04-inner',{opacity:1},5.060000);tl.set('#cap19-04-inner',{opacity:0},6.240000);tl.set('#cap19-05-inner',{opacity:1},6.240000);tl.set('#cap19-05-inner',{opacity:0},7.220000);tl.set('#cap19-06-inner',{opacity:1},7.220000);tl.set(