<!doctype html><html lang="es"><body><template><style>@font-face{font-family:'Montserrat';font-weight:700;src:url('assets/fonts/Montserrat-700.woff2')}@font-face{font-family:'Montserrat';font-weight:900;src:url('assets/fonts/Montserrat-900.woff2')}@font-face{font-family:'IBM Plex Mono';font-weight:500;src:url('assets/fonts/IBMPlexMono-500.woff2')}#scene19-hook-root{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}#scene19-hook-title{position:absolute;left:120px;top:144px;width:840px;height:120px;display:flex;flex-direction:column;justify-content:center;color:#f7f4d5;font-family:"IBM Plex Mono";font-weight:500;font-size:54px;line-height:61px;letter-spacing:-1.6px;opacity:0}#scene19-hook-title .title19-line{display:block;white-space:nowrap}#scene19-hook-title .title19-line:first-child{color:#ffd64a}</style><div id="scene19-hook-root" data-composition-id="scene19-hook" data-duration="4.966666666666667" data-width="1080" data-height="1920"><div id="scene19-hook-title"><div class="title19-line">$5.000</div><div class="title19-line">¿SIN UNA PERSONA?</div></div></div><script>const tl=gsap.timeline({paused:true});tl.set('#scene19-hook-title',{opacity:1,y:30},.02);tl.to('#scene19-hook-title',{y:0,duration:.20,ease:'power4.out'},.02);window.__timelines['scene19-hook']=tl;</script></template></body></html>