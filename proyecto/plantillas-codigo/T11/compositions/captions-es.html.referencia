<!DOCTYPE html><html><head></head><body><template><style>
  #root{position:absolute;inset:0;color:#14120f;font-family:Inter,sans-serif;pointer-events:none}.cue{position:absolute;left:64px;right:64px;bottom:520px;padding:24px 30px 26px;background:rgba(242,235,221,.96);border:4px solid #14120f;box-shadow:12px 12px 0 #2854E8;font-size:52px;font-weight:900;line-height:1.08;text-align:center;letter-spacing:-1px;opacity:0}.cue.high{bottom:520px}.cue b{color:#2854E8;font-weight:900}
</style><div data-hf-id="hf-3p1b" id="root" data-composition-id="captions-es" data-duration="29.100" data-width="1080" data-height="1920" data-layout-allow-caption-zone=""><div data-hf-id="hf-5i8u" id="c1" class="cue">La IA está llenando Internet de <b data-hf-id="hf-l9bw">contenido genérico.</b></div><div data-hf-id="hf-33gq" id="c2" class="cue">Mientras más fácil sea crear contenido con IA,</div><div data-hf-id="hf-k4la" id="c3" class="cue">menos va a valer el <b data-hf-id="hf-0elz">contenido promedio.</b></div><div data-hf-id="hf-pyuv" id="c4" class="cue high">Porque todos podemos publicar más,</div><div data-hf-id="hf-nw1t" id="c5" class="cue high"><b data-hf-id="hf-v3tu">más rápido y cada vez más bonito.</b></div><div data-hf-id="hf-9con" id="c6" class="cue">La ventaja ya no será producir más.</div><div data-hf-id="hf-jmcm" id="c7" class="cue">Será tener algo propio que decir, <b data-hf-id="hf-xefh">algo original.</b></div><div data-hf-id="hf-9ju7" id="c8" class="cue">Y tú, ¿ya distingues cuándo un contenido fue pensado</div><div data-hf-id="hf-rf6c" id="c9" class="cue">y cuándo un contenido fue <b data-hf-id="hf-e20h">generado?</b></div><div data-hf-id="hf-l1b9" id="c10" class="cue">Dos diferencias, ¿no? <b data-hf-id="hf-tnrn">Pensado y generado.</b></div></div><script>
  const tl=gsap.timeline({paused:true});const cues=[["#c1",.12,2.82],["#c2",2.88,6.12],["#c3",6.13,8.76],["#c4",8.97,11.24],["#c5",11.24,14.08],["#c6",14.08,16.63],["#c7",16.63,19.90],["#c8",20.04,23.68],["#c9",23.68,26.36],["#c10",26.36,29.02]];cues.forEach(([id,a,b])=>{tl.fromTo(id,{opacity:0,y:14},{opacity:1,y:0,duration:.09,ease:"power1.out"},a).to(id,{opacity:0,y:-8,duration:.09,ease:"power1.in"},Math.max(a,b-.09))});window.__timelines=window.__timelines||{};window.__timelines["captions-es"]=tl;
</script></template></body></html>
