<!DOCTYPE html>
<html lang="es" data-resolution="portrait">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=1080,height=1920">
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      * { box-sizing: border-box; }
      html, body { margin: 0; width: 1080px; height: 1920px; overflow: hidden; background: #14120f; }
      #root { position: relative; width: 1080px; height: 1920px; overflow: hidden; background: #14120f; }
      .clip { position: absolute; inset: 0; }
      #camera { position: absolute; inset: -1.5%; transform-origin: 50% 40%; }
      #speaker { width: 103%; height: 103%; object-fit: cover; }
      .scene { z-index: 5; }
      #captions { z-index: 30; pointer-events: none; }
      #paper-grain { position: absolute; inset: 0; z-index: 28; opacity: .10; pointer-events: none; mix-blend-mode: multiply; background-image: radial-gradient(#14120f 0.7px, transparent 0.7px); background-size: 7px 7px; }
    </style>
  </head>
