    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1080px; height: 1920px; overflow: hidden; background: #17323B; }
      #root { position: relative; width: 100%; height: 100%; overflow: hidden; background: #17323B; }
      #header-bed { position: absolute; inset: 0 0 auto 0; height: 330px; background: #F2E7D5; border-bottom: 6px solid #17323B; }
      .speaker {
        position: absolute;
        inset: 330px 0 0;
        width: 1080px;
        height: 1590px;
        object-fit: cover;
        object-position: center 48%;
        background: #17323B;
      }
      [data-composition-src] { position: absolute; inset: 0; }
    </style>
  </head>
