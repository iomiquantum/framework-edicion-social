<!DOCTYPE html><html><head></head><body><template>
<style>
  #root{position:absolute;inset:0;overflow:hidden;color:#17323B;font-family:Inter,Arial,sans-serif;pointer-events:none}
  .card{position:absolute;left:42px;right:42px;top:50px;height:216px;background:#F2E7D5;border:5px solid #17323B;box-shadow:12px 12px 0 #C89B4B;padding:20px 30px;overflow:hidden}.kicker{font:900 42px/.95 Inter,Arial,sans-serif;color:#3B8C91;text-transform:uppercase}.headline{margin-top:5px;font:900 78px/.88 "Bebas Neue",Impact,sans-serif;text-transform:uppercase;max-width:770px}
  .icon{position:absolute;right:26px;top:23px;width:160px;height:160px;background:#17323B;border:5px solid #3B8C91;display:grid;place-items:center}.icon svg{width:118px;height:118px}.icon circle,.icon path{fill:none;stroke:#F2E7D5;stroke-width:9;stroke-linecap:round}
  .question{position:absolute;left:108px;right:108px;top:330px;padding:18px 26px;background:#3B8C91;color:#F2E7D5;border:5px solid #17323B;box-shadow:10px 10px 0 #C84A3D;font:900 58px/.95 Inter,Arial,sans-serif;text-align:center;opacity:0}
</style>
<div data-hf-id="hf-v15-inspect-root" id="root" data-composition-id="scene-inspect" data-duration="4.064" data-width="1080" data-height="1920">
  <div data-hf-id="hf-6yi7" class="card" id="inspect-card"><div data-hf-id="hf-icx8" class="kicker" data-layout-allow-overlap="">Antes de escalar</div><div data-hf-id="hf-80iu" class="headline" data-layout-allow-overlap="">ENTIENDE EL PROCESO</div><div data-hf-id="hf-con3" class="icon" id="inspect-icon"><svg data-hf-id="hf-tgml" viewBox="0 0 120 120"><circle data-hf-id="hf-2qd4" id="inspect-lens" cx="49" cy="49" r="29" /><path data-hf-id="hf-gyta" id="inspect-handle" d="M70 70L103 103" /></svg></div></div>
  <div data-hf-id="hf-fm9k" class="question" id="inspect-question">¿POR QUÉ FUNCIONA?</div>
</div>
<script>
  const tl=gsap.timeline({paused:true});tl.fromTo("#inspect-card",{y:-48,opacity:0},{y:0,opacity:1,duration:.42,ease:"power3.out"},.04);
  document.querySelectorAll("#inspect-icon circle,#inspect-icon path").forEach((p,i)=>{const len=p.getTotalLength();p.style.strokeDasharray=len;p.style.strokeDashoffset=len;tl.to(p,{strokeDashoffset:0,duration:i?.34:.52,ease:"power2.out"},.34+i*.35)});
  tl.fromTo("#inspect-question",{scale:0,opacity:0,y:22},{scale:1,opacity:1,y:0,duration:.46,ease:"power3.out"},1.45);window.__timelines["scene-inspect"]=tl;
</script>
</template></body></html>
