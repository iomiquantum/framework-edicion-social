<!DOCTYPE html><html><head></head><body><template>
<style>
  #root{position:absolute;inset:0;overflow:hidden;color:#17323B;font-family:Inter,Arial,sans-serif;pointer-events:none}.card{position:absolute;left:42px;right:42px;top:34px;height:216px;background:#F2E7D5;border:5px solid #17323B;box-shadow:12px 12px 0 #3B8C91;padding:22px 30px;overflow:hidden}.kicker{font:900 40px/.95 Inter,Arial,sans-serif;color:#C84A3D;text-transform:uppercase;opacity:0}.headline{margin-top:8px;font:900 84px/.86 "Bebas Neue",Impact,sans-serif;text-transform:uppercase;letter-spacing:-.5px}.headline span{display:inline-block;opacity:0}.headline .accent{color:#3B8C91}
  .steps{position:absolute;left:54px;right:54px;top:1510px;height:174px;display:grid;grid-template-columns:1fr 72px 1fr 72px 1fr;align-items:stretch;gap:8px}.step{background:#F2E7D5;border:5px solid #17323B;box-shadow:8px 8px 0 #C89B4B;display:grid;place-items:center;padding:12px;font:900 48px/.9 "Bebas Neue",Impact,sans-serif;text-align:center;opacity:0}.step.final{background:#3B8C91;color:#F2E7D5;box-shadow:8px 8px 0 #C84A3D}.arrow{display:grid;place-items:center;font:900 68px/.8 Inter,Arial,sans-serif;color:#F2E7D5;background:#17323B;border-block:5px solid #F2E7D5;opacity:0}.rule{position:absolute;left:30px;right:30px;bottom:16px;height:7px;background:#C89B4B;transform-origin:left center}
</style>
<div data-hf-id="hf-v15-close-root" id="root" data-composition-id="scene-close" data-duration="7.52" data-width="1080" data-height="1920">
  <div data-hf-id="hf-4x27" class="card" id="close-card"><div data-hf-id="hf-tso1" class="kicker" id="close-kicker">El orden correcto</div><div data-hf-id="hf-sodk" class="headline"><span data-hf-id="hf-a4x5" id="close-w1">PRIMERO</span> <span data-hf-id="hf-02nj" id="close-w2" class="accent">ENTIENDE</span></div><div data-hf-id="hf-jupj" class="rule" id="close-rule"></div></div>
