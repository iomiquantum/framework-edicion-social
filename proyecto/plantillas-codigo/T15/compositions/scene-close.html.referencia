<script>
  const tl=gsap.timeline({paused:true});tl.set("#close-kicker",{opacity:1,y:48},.06).to("#close-kicker",{y:0,duration:.15,ease:"power4.out"},.06).set("#close-w1",{opacity:1,y:72},.18).to("#close-w1",{y:0,duration:.18,ease:"power4.out"},.18).set("#close-w2",{opacity:1,y:62},.34).to("#close-w2",{y:0,duration:.16,ease:"power4.out"},.34).fromTo("#close-rule",{scaleX:0},{scaleX:1,duration:.42,ease:"power2.out"},.50);
  [["#close-s1",.72],["#close-a1",1.10],["#close-s2",2.30],["#close-a2",3.35],["#close-s3",4.55]].forEach(([id,t])=>tl.fromTo(id,{scale:0,opacity:0,y:20},{scale:1,opacity:1,y:0,duration:.46,ease:"power3.out"},t));window.__timelines["scene-close"]=tl;
