<!DOCTYPE html><html><head></head><body><template>
<style>
  #root{position:absolute;inset:0;overflow:hidden;color:#F2E7D5;font-family:Inter,Arial,sans-serif;pointer-events:none;background:transparent}.photo-window{position:absolute;inset:0;width:100%;height:100%;overflow:hidden;background-image:url("assets/video-15_broll_premature_automation_machine_v01.png");background-size:cover;background-position:center 45%;background-repeat:no-repeat;z-index:0}.shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(23,50,59,.18) 0%,rgba(23,50,59,.02) 42%,rgba(23,50,59,.74) 100%)}.return-mask{position:absolute;inset:0 0 auto;height:430px;background:#F2E7D5;border-bottom:6px solid #17323B;z-index:1}
  .card{position:absolute;left:54px;right:54px;top:94px;min-height:278px;background:#F2E7D5;color:#17323B;border:5px solid #17323B;box-shadow:12px 12px 0 #C84A3D;padding:28px 34px;overflow:hidden;z-index:2}.kicker{font:900 42px/.95 Inter,Arial,sans-serif;color:#C84A3D;text-transform:uppercase;opacity:0}.headline{margin-top:10px;font:900 80px/.88 "Bebas Neue",Impact,sans-serif;text-transform:uppercase;letter-spacing:-.5px;display:flex;flex-wrap:wrap;gap:0 16px}.headline span{display:inline-block;opacity:0}.headline .neq{color:#C84A3D;font-size:96px}.rail{position:absolute;left:88px;right:88px;top:390px;height:9px;background:#C89B4B;transform-origin:left center;z-index:2}
