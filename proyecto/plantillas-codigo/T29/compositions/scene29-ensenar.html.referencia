<template><div id="scene29-ensenar" data-composition-id="scene29-ensenar" data-width="1080" data-height="1920" data-duration="3.933333333" style="position:relative;width:100%;height:100%"><div class="scene-inner yellow" id="inner29-ensenar"><div class="head">¿Qué podrías<span>enseñar hoy?</span></div><div class="closing">Algo útil.<br>Sin vender.</div><div class="rule"></div></div></div><script>const root=document.querySelector('[data-composition-id="scene29-ensenar"]');const tl=gsap.timeline({paused:true});tl.fromTo(root.querySelector(".scene-inner"),{opacity:0,y:12},{opacity:1,y:0,duration:.16,ease:"power2.out"},0);tl.fromTo(root.querySelectorAll(".cards,.circle,.closing,.rule"),{opacity:0},{opacity:1,duration:.12,ease:"power2.out"},.16);tl.set(root.querySelector(".scene-inner"),{opacity:0},3.933333333);window.__timelines["scene29-ensenar"]=tl;</script></template>