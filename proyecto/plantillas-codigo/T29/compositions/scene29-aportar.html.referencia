<template><div id="scene29-aportar" data-composition-id="scene29-aportar" data-width="1080" data-height="1920" data-duration="3.200000000" style="position:relative;width:100%;height:100%"><div class="scene-inner cream" id="inner29-aportar"><div class="head">Antes de vender,<span>aporta algo útil.</span></div><div class="cards"><div class="card">Solo vender<span>Pides atención.</span></div><div class="card">Enseñar algo útil<span>Construyes confianza.</span></div></div></div></div><script>const root=document.querySelector('[data-composition-id="scene29-aportar"]');const tl=gsap.timeline({paused:true});tl.fromTo(root.querySelector(".scene-inner"),{opacity:0,y:12},{opacity:1,y:0,duration:.16,ease:"power2.out"},0);tl.fromTo(root.querySelectorAll(".cards,.circle,.closing,.rule"),{opacity:0},{opacity:1,duration:.12,ease:"power2.out"},.16);tl.set(root.querySelector(".scene-inner"),{opacity:0},3.200000000);window.__timelines["scene29-aportar"]=tl;</script></template>