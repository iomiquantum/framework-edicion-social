<template><div id="scene29-antes" data-composition-id="scene29-antes" data-width="1080" data-height="1920" data-duration="2.700000000" style="position:relative;width:100%;height:100%"><div class="scene-inner blue" id="inner29-antes"><div class="head">La venta empieza<span>mucho antes.</span></div><div class="circle"><div>ANTES<br><span>de pedir<br>dinero.</span></div></div></div></div><script>const root=document.querySelector('[data-composition-id="scene29-antes"]');const tl=gsap.timeline({paused:true});tl.fromTo(root.querySelector(".scene-inner"),{opacity:0,y:12},{opacity:1,y:0,duration:.16,ease:"power2.out"},0);tl.fromTo(root.querySelectorAll(".cards,.circle,.closing,.rule"),{opacity:0},{opacity:1,duration:.12,ease:"power2.out"},.16);tl.set(root.querySelector(".scene-inner"),{opacity:0},2.700000000);window.__timelines["scene29-antes"]=tl;</script></template>