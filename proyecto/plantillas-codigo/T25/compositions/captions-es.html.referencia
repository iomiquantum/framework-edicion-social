<template><div data-hf-id="hf-wvbr" data-composition-id="captions-es" data-width="1080" data-height="1920" data-duration="24.233333333" style="position:relative;width:100%;height:100%"><div data-hf-id="hf-cns6" id="cap-0" class="clip caption" data-start="0.000000000" data-duration="2.433333333" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-mp11">100 dólares pueden parecer carísimos</p></div><div data-hf-id="hf-ah97" id="cap-1" class="clip caption" data-start="2.433333333" data-duration="1.866666667" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-8w2p">o pueden parecer regalados.</p></div><div data-hf-id="hf-qaj4" id="cap-2" class="clip caption" data-start="4.300000000" data-duration="2.100000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-h8i4">Depende del problema que estés resolviendo.</p></div><div data-hf-id="hf-kjlv" id="cap-3" class="clip caption" data-start="6.400000000" data-duration="1.300000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-xfxu">Si me estás vendiendo algo</p></div><div data-hf-id="hf-fhzs" id="cap-4" class="clip caption" data-start="7.700000000" data-duration="1.933333333" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-3s2m">que me ahorra 10 mil dólares,</p></div><div data-hf-id="hf-ym76" id="cap-5" class="clip caption" data-start="9.633333333" data-duration="1.666666667" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-7zdf">100 parece poco.</p></div><div data-hf-id="hf-0eb6" id="cap-6" class="clip caption" data-start="11.300000000" data-duration="1.433333333" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-9glt">Si todavía no entendí</p></div><div data-hf-id="hf-fu7u" id="cap-7" class="clip caption" data-start="12.733333333" data-duration="1.433333333" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-ypsn">para qué lo necesito</p></div><div data-hf-id="hf-nlct" id="cap-8" class="clip caption" data-start="14.166666667" data-duration="2.233333333" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-ux5z">10 dólares ya me parece caro.</p></div><div data-hf-id="hf-vnn4" id="cap-9" class="clip caption" data-start="16.400000000" data-duration="2.166666667" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-slbo">El precio no existe solo.</p></div><div data-hf-id="hf-hbyx" id="cap-10" class="clip caption" data-start="18.566666667" data-duration="2.333333333" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-xg74">Siempre vive dentro de un contexto.</p></div><div data-hf-id="hf-g47j" id="cap-11" class="clip caption" data-start="20.900000000" data-duration="1.733333333" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-a8mv">¿Y tu cliente entiende realmente</p></div><div data-hf-id="hf-5ni8" id="cap-12" class="clip caption" data-start="22.633333333" data-duration="1.600000000" data-track-index="8" data-track-kind="captions"><p data-hf-id="hf-t9is">lo que está comprando?</p></div></div><script>const root=document.querySelector('[data-composition-id="captions-es"]');const tl=gsap.timeline({paused:true});const p0=root.querySelector("#cap-0 p");gsap.set(p0,{opacity:0});tl.set(p0,{opacity:1},0.000000000);tl.set(p0,{opacity:0},2.433333333);const p1=root.querySelector("#cap-1 p");gsap.set(p1,{opacity:0});tl.set(p1,{opacity:1},2.433333333);tl.set(p1,{opacity:0},4.300000000);const p2=root.querySelector("#cap-2 p");gsap.set(p2,{opacity:0});tl.set(p2,{opacity:1},4.300000000);tl.set(p2,{opacity:0},6.400000000);const p3=root.querySelector("#cap-3 p");gsap.set(p3,{opacity:0});tl.set(p3,{opacity:1},6.400000000);tl.set(p3,{opacity:0},7.700000000);const p4=root.querySelector("#cap-4 p");gsap.set(p4,{opacity:0});tl.set(p4,{opacity:1},7.700000000);tl.set(p4,{opacity:0},9.633333333);const p5=root.querySelector("#cap-5 p");gsap.set(p5,{opacity:0});tl.set(p5,{opacity:1},9.633333333);tl.set(p5,{opacity:0},11.300000000)