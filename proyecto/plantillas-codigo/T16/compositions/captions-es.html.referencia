<!DOCTYPE html><html lang="es"><head></head><body><template><style>@font-face{font-family:'EB Garamond';font-weight:700;src:url('assets/fonts/EBGaramond-700.woff2')}@font-face{font-family:'Inter';font-weight:700;src:url('assets/fonts/Inter-700.woff2')}#captions-es-root{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.caption{opacity:0;position:absolute;left:108px;top:1592px;width:864px;height:132px;display:flex;align-items:center;justify-content:center}.caption-box{width:864px;max-height:132px;box-sizing:border-box;padding:14px 24px;background:#EEEAE0;color:#171716;font-family:'Inter';font-weight:700;font-size:48px;line-height:52px;text-align:center;overflow-wrap:normal;white-space:normal;word-spacing:0;column-gap:.23em}</style><div data-hf-id="hf-231b" id="captions-es-root" data-composition-id="captions-es" data-duration="28.5" data-width="1080" data-height="1920"><div data-hf-id="hf-9gqa" id="caption-01" class="clip caption" data-start="0.28" data-duration="1.140000"><div data-hf-id="hf-ecnp" class="caption-box">Hay un tipo de vendedor</div></div><div data-hf-id="hf-mz0w" id="caption-02" class="clip caption" data-start="1.42" data-duration="0.820000"><div data-hf-id="hf-0tn9" class="caption-box">que la IA sí puede</div></div><div data-hf-id="hf-01vk" id="caption-03" class="clip caption" data-start="2.24" data-duration="1.120000"><div data-hf-id="hf-iujr" class="caption-box">reemplazar muy fácil.</div></div><div data-hf-id="hf-pk32" id="caption-04" class="clip caption" data-start="3.86" data-duration="1.250000"><div data-hf-id="hf-h4e8" class="caption-box">Mira, si yo ya puedo</div></div><div data-hf-id="hf-lmjt" id="caption-05" class="clip caption" data-start="5.11" data-duration="0.750000"><div data-hf-id="hf-1bg0" class="caption-box">entrar a internet,</div></div><div data-hf-id="hf-naf8" id="caption-06" class="clip caption" data-start="6.2" data-duration="0.960000"><div data-hf-id="hf-f61m" class="caption-box">preguntarle a una IA</div></div><div data-hf-id="hf-rbaq" id="caption-07" class="clip caption" data-start="7.16" data-duration="1.100000"><div data-hf-id="hf-5452" class="caption-box">cuánto cuesta algo,</div></div><div data-hf-id="hf-w4bk" id="caption-08" class="clip caption" data-start="8.46" data-duration="1.260000"><div data-hf-id="hf-66ir" class="caption-box">cuáles son sus características,</div></div><div data-hf-id="hf-urer" id="caption-09" class="clip caption" data-start="10.14" data-duration="1.260000"><div data-hf-id="hf-ka6l" class="caption-box">qué diferencias tiene,</div></div><div data-hf-id="hf-eq3x" id="caption-10" class="clip caption" data-start="11.88" data-duration="1.390000"><div data-hf-id="hf-vh6e" class="caption-box">¿para qué necesito un vendedor</div></div><div data-hf-id="hf-o1ww" id="caption-11" class="clip caption" data-start="13.27" data-duration="1.160000"><div data-hf-id="hf-ywse" class="caption-box">que venga a repetirme</div></div><div data-hf-id="hf-1fbm" id="caption-12" class="clip caption" data-start="14.43" data-duration="1.070000"><div data-hf-id="hf-8q0g" class="caption-box">exactamente lo mismo?</div></div><div data-hf-id="hf-rmsl" id="caption-13" class="clip caption" data-start="16.08" data-duration="0.740000"><div data-hf-id="hf-ge2n" class="caption-box">Ahí ya no me</div></div><div data-hf-id="hf-abco" id="caption-14" class="clip caption" data-start="16.82" data-duration="0.920000"><div data-hf-id="hf-balp" class="caption-box">está agregando nada.</div></div><div data-hf-id="hf-y8yo" id="caption-15" class="clip caption" data-start="18.34" data-duration="1.060000"><div data-hf-id="hf-kxi4" class="caption-box">El vendedor del futuro</div></div><div data-hf-id="hf-8ytl" id="caption-16" class="clip caption" data-start="19.4" data-duration="0.720000"><div data-hf-id="hf-0c7x" class="caption-box">no va a valer</div></div><div data-hf-id="hf-zb19" id="caption-17" class="clip caption" data-start="20.12" data-duration="0.740000"><div data-hf-id="hf-wmm2" class="caption-box">por lo que sabe,</div></div><div data-hf-id="hf-l0b2" id="caption-18" class="clip caption" data-start="20.86" data-duration="0.880000"><div data-hf-id="hf-xe2x" class="caption-box">va a valer por</div></div><div data-hf-id="hf-wyna" id="caption-19" class="clip caption" data-start="21.74" data-duration="1.480000"><div data-hf-id="hf-0ksb" class="caption-box">cómo atiende al cliente.</div></div><div data-hf-id="hf-9syu" id="caption-20" class="clip caption" data-start="23.58" data-duration="1.530000"><div data-hf-id="hf-cuoj" class="caption-box">Y tú, ¿todavía prefieres</div></div><div data-hf-id="hf-r41z" id="caption-21" class="clip caption" data-start="25.11" data-duration="1.300000"><div data-hf-id="hf-es2q" class="caption-box">comprar hablando con alguien</div></div><div data-hf-id="hf-02sf" id="caption-22" class="clip caption" data-start="26.41" data-duration="1.770000"><div data-hf-id="hf-duif" class="caption-box">o hablando con una automatización?</div></div></div><script>const tl=gsap.timeline({paused:true});tl.set('.caption',{opacity:0},0);tl.set('#caption-01',{opacity:1},0.280000);tl.set('#caption-01',{opacity:0},1.420000);tl.set('#caption-02',{opacity:1},1.420000);tl.set('#caption-02',{opacity:0},2.240000);tl.set('#caption-03',{opacity:1},2.240000);tl.set('#caption-03',{opacity:0},3.360000);tl.set('#caption-04',{opacity:1},3.860000);tl.set('#caption-04',{opacity:0},5.110000);tl.set('#caption-05',{opacity:1},5.110000);tl.set('#caption-05',{opacity:0},5.860000);tl.set('#caption-06',{opacity:1},6.200000);tl.set('#caption-06',{opacity:0},7.160000);tl.set('#caption-07',{opacity:1},7.160000);tl.set('#caption-07',{opacity:0},8.260000);tl.set('#caption-08',{opacity:1},8.460000);tl.set('#caption-08',{opacity:0},9.720000);tl.set('#caption-09',{opacity:1},10.140000);tl.set('#caption-09',{opacity:0},11.400000);tl.set('#caption-10',{opacity:1},11.880000);tl.set('#caption-10',{opacity:0},13.270000);tl.set('#caption-11',{opacity:1},13.270000);tl.set('#caption-