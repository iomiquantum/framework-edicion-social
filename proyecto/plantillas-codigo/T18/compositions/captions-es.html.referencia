<html><body><template><style>@font-face{font-family:Montserrat;font-weight:700;src:url('assets/fonts/Montserrat-700.woff2')}@font-face{font-family:Montserrat;font-weight:900;src:url('assets/fonts/Montserrat-900.woff2')}#captions18-root{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.caption{position:absolute;left:94px;top:1254px;width:788px;height:182px;display:flex;align-items:center;justify-content:center;opacity:0}.cap-box{width:788px;padding:17px 22px;border:3px solid #252239;background:#f7f1da;color:#252239;font-family:Montserrat;font-weight:700;font-size:60px;line-height:70px;text-align:center;box-shadow:7px 7px 0 #f3c746}.cap-line{white-space:nowrap;display:block;letter-spacing:-1.4px;word-spacing:0}.cap-box strong{font-weight:900;color:#252239;text-decoration:underline;text-decoration-thickness:5px;text-underline-offset:8px}</style><div id="captions18-root" data-composition-id="captions18" data-duration="21.866666666666667" data-width="1080" data-height="1920"><div id="cap18-01" class="clip caption" data-start="0.08" data-duration="0.970000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap>Tu cliente realmente</div></div></div><div id="cap18-02" class="clip caption" data-start="1.05" data-duration="1.050000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap><strong>no</strong> quiere tu producto.</div></div></div><div id="cap18-03" class="clip caption" data-start="2.4" data-duration="1.650000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap>Y esto suena muy raro,</div><div class="cap-line" data-layout-allow-overlap>pero piénsalo.</div></div></div><div id="cap18-04" class="clip caption" data-start="4.28" data-duration="0.900000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap>Nadie quiere un curso</div></div></div><div id="cap18-05" class="clip caption" data-start="5.18" data-duration="1.120000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap>porque quiere</div><div class="cap-line" data-layout-allow-overlap>otro curso.</div></div></div><div id="cap18-06" class="clip caption" data-start="6.65" data-duration="1.000000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap>Quiere ganar más,</div></div></div><div id="cap18-07" class="clip caption" data-start="7.65" data-duration="2.000000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap>aprender algo,</div><div class="cap-line" data-layout-allow-overlap>solucionar un problema.</div></div></div><div id="cap18-08" class="clip caption" data-start="10.04" data-duration="1.060000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap>Nadie quiere</div><div class="cap-line" data-layout-allow-overlap>una herramienta</div></div></div><div id="cap18-09" class="clip caption" data-start="11.1" data-duration="1.140000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap>por otra herramienta.</div></div></div><div id="cap18-10" class="clip caption" data-start="12.78" data-duration="1.270000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap>Quiere lo que</div><div class="cap-line" data-layout-allow-overlap>esa herramienta</div></div></div><div id="cap18-11" class="clip caption" data-start="14.05" data-duration="1.400000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap>te permite <strong>conseguir</strong>.</div></div></div><div id="cap18-12" class="clip caption" data-start="15.8" data-duration="1.250000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap><strong>No</strong> vendas</div><div class="cap-line" data-layout-allow-overlap>lo que haces;</div></div></div><div id="cap18-13" class="clip caption" data-start="17.15" data-duration="1.500000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap>vende lo que</div><div class="cap-line" data-layout-allow-overlap><strong>cambia después</strong>.</div></div></div><div id="cap18-14" class="clip caption" data-start="19.04" data-duration="1.040000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap>Así que, ¿qué</div><div class="cap-line" data-layout-allow-overlap>cambia realmente</div></div></div><div id="cap18-15" class="clip caption" data-start="20.08" data-duration="1.540000000" data-track-index="0"><div class="cap-box"><div class="cap-line" data-layout-allow-overlap>cuando alguien</div><div class="cap-line" data-layout-allow-overlap>te compra a ti?</div></div></div></div><script>const tl=gsap.timeline({paused:true});tl.set('#cap18-01',{opacity:1},0.08);tl.set('#cap18-01',{opacity:0},1.05);tl.set('#cap18-02',{opacity:1},1.05);tl.set('#cap18-02',{opacity:0},2.1);tl.set('#cap18-03',{opacity:1},2.4);tl.set('#cap18-03',{opacity:0},4.05);tl.set('#cap18-04',{opacity:1},4.28);tl.set('#cap18-04',{opacity:0},5.18);tl.set('#cap18-05',{opacity:1},5.18);tl.set('#cap18-05',{opacity:0},6.3);tl.set('#cap18-06',{opacity:1},6.65);tl.set('#cap18-06',{opacity:0},7.65);tl.set('#cap18-07',{opacity:1},7.65);tl.set('#cap18-07',{opacity:0},9.65);tl.set('#cap18-08',{opacity:1},10.04);tl.set('#cap18-08',{opacity:0},11.1);tl.set('#cap18-09',{opacity:1},11.1);tl.set('#cap18-09',{opacity:0},12.24);tl.set('#cap18-10',{opacity:1},12.78);tl.set('#cap18-10',{opacity:0},14.05);tl.set('#cap18-11',{opacity:1},14.05);tl.set('#cap18-11',{opacity:0},15.45);tl.set('#cap18-12',{opacity:1},15.8);tl.set('#cap18-12',{opacity:0},17.05);tl.set('#cap18-13',{opacity:1},17.15);tl.set('#cap18-13',{opacity:0},18.65);tl.set('#cap18-14',{opacity:1},19.04);tl.set('#cap18-14',{opacity:0},20.08);tl.set('#cap18-15',{opacity:1},20.08);tl.set('#ca