<!DOCTYPE html>
<html lang="en" data-resolution="portrait">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1080, height=1920">
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        width: 1080px;
        height: 1920px;
        overflow: hidden;
        background: #0a0a0a;
      }
      #root {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #050505;
      }
      #speaker {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    </style>
  </head>
  <body>
    <div data-hf-id="hf-txxr" id="root" data-composition-id="main" data-start="0" data-duration="19.70" data-width="1080" data-height="1920">
      <video
        data-hf-id="hf-v12-speaker"
        id="speaker"
        class="clip"
        src="assets/video12-master-hdr-v1.mp4"
        muted
        playsinline
        preload="auto"
        data-start="0"
        data-duration="19.70"
        data-track-index="0"
        data-track-kind="video"
      ></video>
      <div id="hook" class="clip" data-composition-id="scene-hook" data-composition-src="compositions/scene-hook.html" data-start="0" data-duration="5.21" data-track-index="3" data-track-kind="graphics" data-width="1080" data-height="1920"></div>
      <div id="idea" class="clip" data-composition-id="scene-idea" data-composition-src="compositions/scene-idea.html" data-start="5.21" data-duration="6.21" data-track-index="3" data-track-kind="graphics" data-width="1080" data-height="1920"></div>
      <div id="contrast" class="clip" data-composition-id="scene-contrast" data-composition-src="compositions/scene-contrast.html" data-start="11.42" data-duration="3.56" data-track-index="3" data-track-kind="graphics" data-width="1080" data-height="1920"></div>
      <div id="cta" class="clip" data-composition-id="scene-cta" data-composition-src="compositions/scene-cta.html" data-start="14.98" data-duration="4.72" data-track-index="3" data-track-kind="graphics" data-width="1080" data-height="1920"></div>
      <div id="captions" class="clip" data-composition-id="captions-es" data-composition-src="compositions/captions-es.html" data-start="0" data-duration="19.70" data-track-index="8" data-track-kind="captions" data-width="1080" data-height="1920"></div>
      <audio
        data-hf-id="hf-v12-voice"
        id="voice"
        src="assets/video12-voice-normalized-v1.m4a"
        preload="auto"
        data-start="0"
        data-duration="19.70"
        data-track-index="20"
        data-track-kind="audio"
        data-volume="1"
      ></audio>
      <audio id="sfx-hook" src="assets/04_soft_pop.wav" preload="auto" data-start="0.08" data-duration="0.16" data-track-index="30" data-volume="0.34"></audio>
      <audio id="sfx-contrast" src="assets/05_low_accent.wav" preload="auto" data-start="11.46" data-duration="0.34" data-track-index="31" data-volume="0.24"></audio>
      <audio id="sfx-cta" src="assets/04_soft_pop.wav" preload="auto" data-start="15.02" data-duration="0.16" data-track-index="32" data-volume="0.30"></audio>
    </div>
    <script>
      const tl = gsap.timeline({ paused: true });
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
