<div data-hf-id="hf-v12-cta-root" id="root" data-composition-id="scene-cta" data-duration="4.72" data-width="1080" data-height="1920">
  <div class="question" id="question">¿QUÉ TE CUESTA MÁS?</div>
  <div class="choice"><span id="attention">CONSEGUIR<br>ATENCIÓN</span><span class="arrow" id="arrow">→</span><span class="sales" id="sales">CONVERTIR<br>EN VENTAS</span></div>
