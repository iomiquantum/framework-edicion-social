<!doctype html><html><head></head><body><template>
<style>
  #root{position:absolute;inset:0;overflow:hidden;color:#181217;font-family:Inter,sans-serif;pointer-events:none}
  .card{position:absolute;left:64px;right:64px;top:72px;background:#F4E7D3;border:4px solid #181217;box-shadow:12px 12px 0 #7C3AED;padding:30px 34px 36px}
  .kicker{font:900 22px/1 Inter,sans-serif;letter-spacing:4px;color:#7C3AED;margin-bottom:14px}
  .headline{font:700 88px/.88 "Bebas Neue",Impact,sans-serif;letter-spacing:-1px;text-transform:uppercase}
  .headline span{display:inline-block;opacity:0;margin-right:15px}.headline .accent{color:#DD596F}
  .rule{height:8px;background:#181217;margin-top:24px;transform-origin:left center}
  .stamp{position:absolute;right:72px;top:386px;padding:14px 20px;background:#181217;color:#F4E7D3;font:900 24px/1 Inter,sans-serif;letter-spacing:2px;transform:rotate(2deg)}
</style>
<div data-hf-id="hf-v12-hook-root" id="root" data-composition-id="scene-hook" data-duration="5.21" data-width="1080" data-height="1920">
  <div class="card" id="card"><div class="kicker">EL PROBLEMA PUEDE SER OTRO</div><div class="headline"><span id="w1">NO</span><span id="w2">ES</span><span id="w3" class="accent">MÁS</span><span id="w4" class="accent">CREATIVIDAD</span></div><div class="rule" id="rule"></div></div>
  <div class="stamp" id="stamp">MARKETING ≠ ADORNO</div>
</div>
<script>
  const tl=gsap.timeline({paused:true});
  const words=[["#w1",80,.18,.12],["#w2",48,.15,.31],["#w3",44,.14,.44],["#w4",70,.16,.56]];
  words.forEach(([id,y,d,t])=>{tl.set(id,{opacity:1,y},t).to(id,{y:0,duration:d,ease:"power4.out"},t)});
  tl.fromTo("#rule",{scaleX:0},{scaleX:1,duration:.45,ease:"power3.out"},.62)
    .fromTo("#stamp",{scale:0,opacity:0,y:20},{scale:1,opacity:1,y:0,duration:.48,ease:"power3.out"},.78);
  window.__timelines["scene-hook"]=tl;
</script>
</template></body></html>
