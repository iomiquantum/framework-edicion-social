<!doctype html><html lang="es"><head><meta charset="UTF-8"></head><body><template><style>.example{position:absolute;left:78px;width:355px;height:220px;display:flex;flex-direction:column;align-items:flex-start;color:#a13d63;opacity:0}.example svg{width:120px;height:120px}.example span{font-size:40px;color:#20243b;margin-top:16px}.comparison{position:absolute;left:75px;top:440px;width:930px;height:900px;color:#20243b}.party{position:absolute;top:0;width:355px;height:800px;opacity:0}.party svg.person{width:205px;height:225px;display:block;margin:45px auto 10px}.party h2{text-align:center;font-size:43px;margin:0}.toolset{display:flex;gap:12px;padding:24px 6px;border:5px solid #20243b;border-radius:24px;margin-top:45px;background:#e9e7f2}.toolset svg{width:100px;height:115px}.equals{position:absolute;left:408px;top:400px;font-size:100px;font-weight:800;opacity:0}.focus-label{position:absolute;left:75px;top:1360px;width:930px;text-align:center;font-size:65px;line-height:1.05;color:#20243b;opacity:0}.question-mark{font-size:86px;line-height:1}.rail .tile{height:70px}.rail .tile svg{width:64px;height:56px}.accent-rule{position:absolute;left:190px;top:310px;width:700px;height:9px;background:#f1b950;transform-origin:left center;opacity:0}@font-face{font-family:Montserrat;src:url('assets/fonts/Montserrat-800.woff2')}*{box-sizing:border-box}#root{position:absolute;inset:0;width:100%;height:100%;overflow:hidden;font-family:Montserrat,sans-serif}.surface{position:absolute;inset:0}.headline{position:absolute;left:190px;top:112px;width:790px;font-size:74px;line-height:1.04;letter-spacing:-2px;font-weight:800;margin:0}.icon{position:absolute;left:78px;top:110px;width:95px;height:95px}.rail{position:absolute;left:104px;top:282px;display:flex;gap:36px}.tile{width:172px;height:56px;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#20243b;font-size:40px}.tile svg{width:126px;height:50px}.tile .dot{width:38px;height:38px;border-radius:50%;background:#a13d63}.big-aa{position:absolute;left:80px;top:560px;font-size:150px;color:#a13d63}.list{position:absolute;left:80px;top:825px;font-size:41px;line-height:1.6;color:#20243b;max-width:390px}.list span{display:block}.image-title{position:absolute;left:75px;top:110px;width:930px;min-height:220px;background:#f1b950;color:#20243b;padding:30px;border-radius:28px;font-size:72px;line-height:1.07;letter-spacing:-2px}.last-prepare{position:absolute;left:190px;top:120px;width:780px;font-size:70px;line-height:1.08;color:#e9e7f2}.question{position:absolute;left:190px;top:120px;width:790px;font-size:84px;line-height:1.02;letter-spacing:-2px;color:#f1b950}</style><div id="root" data-composition-id="v30-central" data-width="1080" data-height="1920" data-duration="3.6333333333333"><div class="scene-inner" id="inner-central" style="position:absolute;inset:0;opacity:0"><div class="surface" style="background:#20243b"></div><h1 class="headline"><span class="arrive" style="display:block;color:#e9e7f2">UNA PREGUNTA<br>MÁS VALIOSA</span></h1><div class="icon" style="color:#f1b950;font-size:86px">?</div><div class="rail"><div class="tile" style="background:#e9e7f2"><svg viewBox="0 0 100 100"><rect x="20" y="10" width="60" height="80" rx="8" fill="none" stroke="currentColor" stroke-width="7"/><path d="M33 34H66M33 50H66M33 66H57" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"/></svg></div><div class="tile" style="background:#b9ded9"><svg viewBox="0 0 170 95" width="100%" height="100%"><path class="trace" d="M8 50H32L48 15L72 82L95 27L113 54H160" fill="none" stroke="currentColor" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/></svg></div><div class="tile" style="background:#f1b950"><svg viewBox="0 0 100 100"><rect x="9" y="16" width="82" height="68" rx="8" fill="none" stroke="currentColor" stroke-width="7"/><path d="M10 36H90M24 25H28M40 25H44M23 50H77M23 64H56" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/></svg></div><div class="tile" style="background:#e9e7f2"><svg viewBox="0 0 100 100" width="100%" height="100%"><path class="trace" d="M14 51L37 75L86 22" fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/></svg></div></div></div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo(document.querySelector('#inner-central'),{opacity:0},{opacity:1,duration:.16,ease:'power2.out'},0);document.querySelectorAll('#root .trace').forEach(p=>{const len=p.getTotalLength();p.style.strokeDasharray=String(len);tl.fromTo(p,{strokeDashoffset:len},{strokeDashoffset:0,duration:.45,ease:'power2.out'},.04);});tl.fromTo('#root .icon',{scale:.72,opacity:0},{scale:1,opacity:1,duration:.38,ease:'back.out(1.3)'},.15);tl.fromTo('#root .tile',{y:-16,opacity:0},{y:0,opacity:1,duration:.25,stagger:.08,ease:'power3.out'},.35);tl.set(document.querySelector('#root'),{opacity:0},3.6333333333333);tl.set('#inner-central',{opacity:0},3.6333333333333);window.__timelines['v30-central']=tl;</script></template></body></html>