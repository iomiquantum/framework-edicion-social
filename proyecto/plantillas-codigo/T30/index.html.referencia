<!doctype html><html lang="es"><head><meta charset="UTF-8"><script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script><style>@font-face{font-family:Montserrat;src:url('assets/fonts/Montserrat-800.woff2')}*{box-sizing:border-box}html,body{margin:0;overflow:hidden;background:#20243b}#root{position:relative;width:100%;height:100%;overflow:hidden;font-family:Montserrat,sans-serif}.scene-slot{position:absolute;inset:0;z-index:0}#slot-simbolo{z-index:20}.presenter{position:absolute;left:104px;top:350px;width:872px;height:1240px;object-fit:cover;object-position:50% 13%;z-index:10;border-radius:24px}.presenter-reading{left:495px;top:520px;width:510px;height:1000px;object-position:50% 13%}.support{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:2}.caption{position:absolute;left:75px;top:1610px;width:930px;min-height:160px;border-radius:22px;display:flex;align-items:center;justify-content:center;background:#20243b;color:#e9e7f2;padding:20px 25px;z-index:40;font-size:56px;line-height:1.16;letter-spacing:-.8px;text-align:center;font-weight:800;margin:0}.caption-text{font-size:56px;line-height:1.16;letter-spacing:-.8px;text-align:center;font-weight:800;width:100%;margin:0}</style></head><body><div id="root" data-composition-id="video30" data-width="1080" data-height="1920" data-duration="15.9"><div id="v30-persistent-background" class="clip" data-start="0" data-duration="15.9" data-track-index="4" style="position:absolute;inset:0;width:1080px;height:1920px;background:#20243b;z-index:0"></div><div id="slot-central" class="scene-slot clip" data-composition-id="v30-central" data-composition-src="compositions/central.html" data-start="0" data-duration="3.6333333333333" data-track-index="2" data-width="1080" data-height="1920"></div><div id="slot-textual" class="scene-slot clip" data-composition-id="v30-textual" data-composition-src="compositions/textual.html" data-start="3.6333333333333" data-duration="3.2666666666667" data-track-index="2" data-width="1080" data-height="1920"></div><div id="slot-sonora" class="scene-slot clip" data-composition-id="v30-sonora" data-composition-src="compositions/sonora.html" data-start="6.9" data-duration="3.1" data-track-index="2" data-width="1080" data-height="1920"></div><div id="slot-simbolo" class="scene-slot clip" data-composition-id="v30-simbolo" data-composition-src="compositions/simbolo.html" data-start="10" data-duration="2" data-track-index="2" data-width="1080" data-height="1920"></div><div id="slot-recap" class="scene-slot clip" data-composition-id="v30-recap" data-composition-src="compositions/recap.html" data-start="12" data-duration="3.9" data-track-index="2" data-width="1080" data-height="1920"></div><video id="v30-presenter-central" class="presenter clip " src="assets/video30-master-hlg-v1.mp4" data-start="0" data-media-start="0" data-duration="3.6333333333333" data-track-index="0" muted playsinline></video><video id="v30-presenter-textual" class="presenter clip presenter-reading" src="assets/video30-master-hlg-v1.mp4" data-start="3.6333333333333" data-media-start="3.6333333333333" data-duration="3.2666666666667" data-track-index="0" muted playsinline></video><video id="v30-presenter-sonora" class="presenter clip " src="assets/video30-master-hlg-v1.mp4" data-start="6.9" data-media-start="6.9" data-duration="3.1" data-track-index="0" muted playsinline></video><video id="v30-presenter-recap" class="presenter clip " src="assets/video30-master-hlg-v1.mp4" data-start="12" data-media-start="12" data-duration="3.9" data-track-index="0" muted playsinline></video><p id="caption-1" class="caption clip" data-start="0.1" data-duration="1.68" data-track-index="3">Hay una pregunta que puede valer más</p><p id="caption-2" class="caption clip" data-start="1.78" data-duration="1.8533333333" data-track-index="3">que aprender 100 herramientas de IA.</p><p id="caption-3" class="caption clip" data-start="3.6333333333" data-duration="1.8636666667" data-track-index="3">Si mañana cualquiera puede crear</p><p id="caption-4" class="caption clip" data-start="5.497" data-duration="2.1399999999999997" data-track-index="3">contenido, anuncios, páginas,</p><p id="caption-5" class="caption clip" data-start="7.637" data-duration="1.7000000000000002" data-track-index="3">productos y hasta negocios</p><p id="caption-6" class="caption clip" data-start="9.337" data-duration="1.92" data-track-index="3">usando las mismas herramientas que tú,</p><p id="caption-7" class="caption clip" data-start="11.257" data-duration="1.25" data-track-index="3">entonces tienes que preguntarte</p><p id="caption-8" class="caption clip" data-start="12.507" data-duration="1.1596666669999998" data-track-index="3">algo muy incómodo.</p><p id="caption-9" class="caption clip" data-start="13.666666667" data-duration="2.233333333000001" data-track-index="3">¿Por qué alguien debería escogerte a ti?</p><audio id="voice" src="assets/video30-voice-normalized-v1.wav" data-start="0" data-duration="15.9" data-track-index="10" data-track-kind="voice" data-volume="1"></audio><audio id="sfx-pregunta" src="assets/sfx-pregunta-mix-v1.wav" data-start="0.12" data-duration="0.44" data-track-index="11" data-track-kind="sfx" data-volume="1"></audio><audio id="sfx-diferencia" src="assets/sfx-diferencia-mix-v1.wav" data-start="10" data-duration="0.16" data-track-index="11" data-track-kind="sfx" data-volume="1"></audio><audio id="sfx-escogerte" src="assets/sfx-escogerte-mix-v1.wav" data-start="13.72" data-duration="0.48" data-track-index="11" data-track-kind="sfx" data-volume="1"></audio></div><script>const tl=gsap.timeline({paused:true});tl.set('#v30-presenter-central',{opacity:0},3.633333333);tl.set('#v30-presenter-textual',{opacity:0},6.900000000);tl.set('#v30-presenter-sonora',{opacity:0},10.000000000);tl.set('#v30-presenter-recap',{opacity:0},15.900000000);tl.set('#caption-1',{opacity:0},1.780000000);tl.set('#caption-2',{opacity:0},3.633333333);tl.set('#caption-3',{opacity:0},5.497000000);tl.set('#caption-4',{opacity:0},7.637000000);tl.set('#caption-5',{opacity:0},9.337000000);tl.set('#caption-6',{opacity:0},11.257000000);tl.set('#caption-7',{opacity:0},12.507000000);tl.set('#caption-8',{opacity:0},13.666666667);tl.set('#caption-9',{opacity:0},15.900000000);window.__timelines["video30"]=tl;</script></body></html>