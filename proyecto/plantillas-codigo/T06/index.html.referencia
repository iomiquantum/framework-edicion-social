<!doctype html><html lang="es" data-resolution="portrait"><head><meta charset="utf-8"><meta name="viewport" content="width=1080,height=1920"><script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script><style>*{box-sizing:border-box}html,body{margin:0;width:1080px;height:1920px;overflow:hidden;background:#07111f}#root{position:relative;width:1080px;height:1920px;overflow:hidden;background:#07111f}.clip{position:absolute;inset:0}#camera{position:absolute;inset:-2%;transform-origin:50% 43%}#speaker{width:104%;height:104%;object-fit:cover}.scene{z-index:5}#captions{z-index:20}</style></head><body><div id="root" data-composition-id="main" data-start="0" data-duration="19.600" data-width="1080" data-height="1920"><div id="camera"><video id="speaker" class="clip" src="assets/video06-master-hdr.mp4" muted playsinline preload="auto" data-start="0" data-duration="19.600" data-track-index="0"></video></div><div id="hook" class="clip scene" data-composition-id="scene-hook" data-composition-src="compositions/scene-hook.html" data-start="0.000" data-duration="4.400" data-track-index="3" data-track-kind="graphics" data-width="1080" data-height="1920"></div><div id="concept" class="clip scene" data-composition-id="scene-concept" data-composition-src="compositions/scene-concept.html" data-start="4.400" data-duration="5.200" data-track-index="3" data-track-kind="graphics" data-width="1080" data-height="1920"></div><div id="support" class="clip scene" data-composition-id="scene-support" data-composition-src="compositions/scene-support.html" data-start="9.600" data-duration="5.200" data-track-index="3" data-track-kind="graphics" data-width="1080" data-height="1920"></div><div id="cta" class="clip scene" data-composition-id="scene-cta" data-composition-src="compositions/scene-cta.html" data-start="14.800" data-duration="4.800" data-track-index="3" data-track-kind="graphics" data-width="1080" data-height="1920"></div><div id="captions" class="clip" data-composition-id="captions-es" data-composition-src="compositions/captions-es.html" data-start="0" data-duration="19.600" data-track-index="8" data-track-kind="captions" data-width="1080" data-height="1920"></div><audio id="voice" src="assets/video06-voice-normalized.m4a" preload="auto" data-start="0" data-duration="19.600" data-track-index="20" data-volume="1"></audio><audio id="sfx-hook" src="assets/05_low_accent.wav" preload="auto" data-start=".04" data-duration="0.340" data-track-index="30" data-volume=".75"></audio><audio id="sfx-concept" src="assets/06_sequence.wav" preload="auto" data-start="4.400" data-duration="0.500" data-track-index="31" data-volume=".70"></audio><audio id="sfx-support" src="assets/05_low_accent.wav" preload="auto" data-start="9.600" data-duration="0.340" data-track-index="32" data-volume=".62"></audio><audio id="sfx-cta" src="assets/08_resolve.wav" preload="auto" data-start="14.800" data-duration="0.840" data-track-index="33" data-volume=".82"></audio></div><script>const tl=gsap.timeline({paused:true});tl.set('#camera',{scale:1.0,x:0,y:0},0).to('#camera',{scale:1.035,y:12,duration:1.10,ease:'power2.out'},.12).to('#camera',{scale:1.015,y:0,duration:18.20,ease:'none'},1.24);window.__timelines=window.__timelines||{};window.__timelines.main=tl;tl.seek(0)</script></body></html>