<!doctype html><html><body><template><style>
  #root{position:absolute;inset:0;overflow:hidden;font-family:Avenir Next,Arial,sans-serif;color:white}.top{position:absolute;left:54px;right:54px;top:72px;height:570px;border-radius:44px;overflow:hidden;isolation:isolate}.bg-art{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.33;mix-blend-mode:screen}.top:after{content:"";position:absolute;inset:0;border:2px solid rgba(255,255,255,.18);border-radius:44px;box-shadow:inset 0 0 80px rgba(5,12,25,.35)}.line{position:absolute;left:42px;right:42px;bottom:68px;height:2px;background:linear-gradient(90deg,transparent,#24C8E8,transparent);opacity:.8}.split{position:absolute;top:0;bottom:0;width:50%;opacity:.42}.split.a{left:0;background:linear-gradient(145deg,#24C8E8,transparent 70%)}.split.b{right:0;background:linear-gradient(215deg,#7C5CFC,transparent 70%)}.seed-ring{position:absolute;width:330px;height:330px;border-radius:50%;left:calc(50% - 165px);top:85px;border:3px solid #24C8E8;box-shadow:0 0 70px #24C8E8;opacity:.5}.seed{position:absolute;width:52px;height:52px;border-radius:50%;left:calc(50% - 26px);top:224px;background:#24C8E8;box-shadow:0 0 50px #24C8E8}.target-ring{position:absolute;border-radius:50%;left:50%;top:47%;transform:translate(-50%,-50%);border:4px solid #24C8E8}.r1{width:190px;height:190px}.r2{width:330px;height:330px;opacity:.65;border-color:#7C5CFC}.r3{width:470px;height:470px;opacity:.35}.noise-side{position:absolute;inset:0 50% 0 0;background-image:radial-gradient(#24C8E8 2px,transparent 2px);background-size:18px 18px;opacity:.45}.clean-side{position:absolute;inset:0 0 0 50%;background:linear-gradient(90deg,transparent,rgba(56,189,248,.22))}.search-cone{position:absolute;left:190px;top:-40px;width:620px;height:570px;background:linear-gradient(180deg,rgba(255,255,255,.34),#7C5CFC44,transparent);clip-path:polygon(42% 0,58% 0,100% 100%,0 100%)}.search-point{position:absolute;width:82px;height:82px;border-radius:50%;left:calc(50% - 41px);top:330px;border:6px solid #24C8E8;box-shadow:0 0 60px #24C8E8}.title{position:absolute;left:105px;right:105px;top:164px;z-index:5;padding:18px 24px;border-radius:30px;background:#07111f;text-align:center;font-weight:900;letter-spacing:-3px;text-shadow:0 5px 22px #07111f}.t1{font-size:66px;line-height:.98}.t2{margin-top:16px;font-size:76px;line-height:.95;color:#24C8E8}.kicker{position:absolute;top:96px;left:390px;right:390px;padding:8px 10px;border-radius:999px;background:#f8fafc;text-align:center;font-size:19px;font-weight:900;letter-spacing:3px;color:#07111f}.icon{position:absolute;right:84px;top:440px;width:105px;height:105px;object-fit:contain;opacity:.85;z-index:6}</style><div id="root" data-composition-id="scene-hook" data-duration="4.400" data-width="1080" data-height="1920"><div class="top" id="treatment"><img class="bg-art" src="assets/video-06_knowledge_vault_background_v01.svg"><div class="line"></div><div class="split a"></div><div class="split b"></div></div><div class="kicker">IA · NEGOCIOS</div><div class="title"><div class="t1" id="w1">TU KNOW-HOW</div><div class="t2" id="w2">NO DEBERÍA MORIR CONTIGO</div></div><img class="icon" id="hook-icon" src="assets/video-06_head_to_system_overlay_v01.svg"></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('#treatment',{opacity:0,scale:.97},{opacity:1,scale:1,duration:.72,ease:'power2.out'},0).set('#w1',{opacity:1,y:74},.08).to('#w1',{y:0,duration:.19,ease:'power4.out'},.08).set('#w2',{opacity:1,y:54},.24).to('#w2',{y:0,duration:.16,ease:'power4.out'},.24).fromTo('#hook-icon',{opacity:0,scale:.78},{opacity:.85,scale:1,duration:.48,ease:'power3.out'},.34);window.__timelines=window.__timelines||{};window.__timelines['scene-hook']=tl;</script></template></body></html>