<!doctype html><html><body><template><style>#root{position:absolute;inset:0;color:#f8fafc;font-family:Avenir Next,Arial,sans-serif;pointer-events:none}.cue{position:absolute;left:78px;bottom:235px;width:924px;padding:19px 25px 21px;border-radius:22px;background:rgba(7,17,31,.92);border:1px solid rgba(255,255,255,.15);box-shadow:0 18px 55px rgba(0,0,0,.3);font-size:45px;font-weight:800;line-height:1.08;text-align:center;letter-spacing:-1px;opacity:0}.cue span{background:linear-gradient(90deg,#fff,#1BC5A3);-webkit-background-clip:text;background-clip:text;color:transparent}</style><div id="root" data-composition-id="captions-es" data-duration="18.900" data-width="1080" data-height="1920"><div id="c1" class="cue"><span>Tu cliente no quiere saber qué</span></div><div id="c2" class="cue"><span>IA usas.</span></div><div id="c3" class="cue"><span>A tu cliente no le interesa</span></div><div id="c4" class="cue"><span>qué inteligencia artificial estás usando.</span></div><div id="c5" class="cue"><span>A él le importa que respondas</span></div><div id="c6" class="cue"><span>rápido, que cumplas lo prometido y</span></div><div id="c7" class="cue"><span>que soluciones el problema.</span></div><div id="c8" class="cue"><span>La tecnología no es el producto,</span></div><div id="c9" class="cue"><span>el resultado sí.¿Qué valoras más cuando</span></div><div id="c10" class="cue"><span>compras?¿Velocidad, confianza o precio?</span></div></div><script>const tl=gsap.timeline({paused:true});const cues=[["#c1",0.15,1.9],["#c2",1.9,2.4],["#c3",2.4,4.78],["#c4",4.78,6.82],["#c5",6.82,8.19],["#c6",8.19,10.04],["#c7",10.06,11.5],["#c8",11.5,13.62],["#c9",13.62,16.08],["#c10",16.08,18.65]];cues.forEach(([id,a,b])=>{tl.fromTo(id,{opacity:0,y:14},{opacity:1,y:0,duration:.09,ease:'power1.out'},a).to(id,{opacity:0,y:-8,duration:.09,ease:'power1.in'},Math.max(a,b-.09))});window.__timelines=window.__timelines||{};window.__timelines['captions-es']=tl;</script></template></body></html>