<!doctype html><html><body><template><style>#root{position:absolute;inset:0;font-family:Avenir Next,Arial,sans-serif;color:white;overflow:hidden}.visual{position:absolute;top:90px;left:80px;width:330px;height:510px;object-fit:cover;border-radius:34px;border:3px solid #1BC5A3;box-shadow:0 22px 70px rgba(0,0,0,.35)}.label{position:absolute;top:180px;left:450px;right:70px;padding:34px 28px;border-radius:30px;background:#07111f;border-left:8px solid #FF7A59;font-size:50px;line-height:1.03;font-weight:900;letter-spacing:-1.5px}.chip{position:absolute;top:475px;left:470px;padding:14px 24px;border-radius:999px;background:#1BC5A3;color:#06111e;font-size:20px;font-weight:900;letter-spacing:3px}</style><div id="root" data-composition-id="scene-support" data-duration="5.200" data-width="1080" data-height="1920"><img class="visual" id="visual" src="assets/video-08_broll_customer_outcome_v01.png"><div class="label" id="label">LA TECNOLOGÍA NO ES EL PRODUCTO</div><div class="chip" id="chip">IDEA → ACCIÓN</div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('#visual',{opacity:0,scale:.94},{opacity:1,scale:1,duration:.48,ease:'power3.out'},.05).fromTo('#label',{opacity:0,x:70},{opacity:1,x:0,duration:.42,ease:'power4.out'},.18).fromTo('#chip',{opacity:0,y:28},{opacity:1,y:0,duration:.28,ease:'power3.out'},.42);window.__timelines=window.__timelines||{};window.__timelines['scene-support']=tl;</script></template></body></html>