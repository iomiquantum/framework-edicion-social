<!doctype html><html><body><template><style>#root{position:absolute;inset:0;overflow:hidden;font-family:Montserrat,Arial,sans-serif;color:#f8fafc}.copy{position:absolute;left:58px;top:90px;width:800px}.tag{display:inline-flex;padding:11px 18px;border-radius:999px;background:#ec4899;color:#fff;font:900 22px Inter,Arial;letter-spacing:.12em}.title{box-sizing:border-box;width:670px;margin-top:17px;padding:21px 25px 24px;border:2px solid rgba(236,72,153,.76);border-left:8px solid #ec4899;border-radius:26px;background:linear-gradient(135deg,rgba(7,17,31,.95),rgba(43,22,56,.86));box-shadow:0 18px 42px rgba(7,17,31,.30);font-size:65px;line-height:.92;letter-spacing:-.051em;text-transform:uppercase;text-shadow:0 4px 18px rgba(7,17,31,.34)}.title b{display:inline-block;color:#c4b5fd}.balance{position:absolute;right:32px;top:54px;width:230px;height:230px;filter:drop-shadow(0 16px 28px rgba(139,92,246,.28))}.rule{margin-top:18px;width:280px;height:10px;border-radius:8px;background:linear-gradient(90deg,#ec4899,#8b5cf6,#22d3ee)}</style><div id="root" data-composition-id="scene-hook" data-width="1080" data-height="1920"><img class="balance" src="assets/video-05_human_ai_balance_overlay_v01.svg"><div class="copy" data-layout-allow-occlusion><div class="tag">RIESGO SILENCIOSO</div><div class="title">LA IA TE PUEDE<br>VOLVER MÁS<br><b>MEDIOCRE</b></div><div class="rule"></div></div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('.tag',{opacity:0,x:-18},{opacity:1,x:0,duration:.24,ease:'power2.out'},.06).fromTo('.title',{opacity:0,y:22},{opacity:1,y:0,duration:.38,ease:'power3.out'},.16).fromTo('.title b',{scale:.75},{scale:1,duration:.42,ease:'back.out(2)'},.43).fromTo('.balance',{opacity:0,scale:.58,rotation:-12},{opacity:1,scale:1,rotation:0,duration:.5,ease:'back.out(1.7)'},.28).fromTo('.rule',{scaleX:0,transformOrigin:'0 50%'},{scaleX:1,duration:.35,ease:'power2.out'},.52).to('.balance',{rotation:4,duration:1.2,ease:'sine.inOut',yoyo:true,repeat:3},.95);window.__timelines=window.__timelines||{};window.__timelines['scene-hook']=tl;</script></template></body></html>
