<!doctype html><html><body><template><style>#root{position:absolute;inset:0;overflow:hidden;background:#07111f;font-family:Montserrat,Arial,sans-serif;color:#f8fafc}.photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,17,31,.72) 0%,transparent 27%,transparent 63%,rgba(7,17,31,.74) 100%)}.top{position:absolute;left:58px;right:58px;top:76px;padding:24px 30px 27px;border-radius:28px;background:rgba(7,17,31,.91);border:2px solid #8b5cf6;box-shadow:0 20px 50px rgba(0,0,0,.27)}.small{font:850 21px Inter,Arial;letter-spacing:.12em;color:#c4b5fd}.big{margin-top:8px;font-size:55px;line-height:.98;letter-spacing:-.047em}.big b{color:#22d3ee}.compare{position:absolute;left:70px;right:70px;bottom:405px;display:grid;grid-template-columns:1fr 1fr;gap:18px}.card{padding:22px 20px;border-radius:23px;background:rgba(7,17,31,.92);text-align:center;border:2px solid #ec4899}.card.good{border-color:#22d3ee}.symbol{font-size:48px;font-weight:900}.label{margin-top:5px;font:850 23px Inter,Arial;letter-spacing:.06em}.bad .symbol{color:#ec4899}.good .symbol{color:#22d3ee}</style><div id="root" data-composition-id="scene-criterion" data-width="1080" data-height="1920"><img class="photo" data-layout-allow-overflow src="assets/video-05_broll_human_judgment_v01.png"><div class="shade"></div><div class="top"><div class="small">LA RELACIÓN CORRECTA</div><div class="big">AUMENTA TU INTELIGENCIA.<br><b>NO LA REEMPLACES.</b></div></div><div class="compare"><div class="card bad"><div class="symbol">≠</div><div class="label">SUSTITUIR TU CRITERIO</div></div><div class="card good"><div class="symbol">+</div><div class="label">AMPLIAR TU CRITERIO</div></div></div></div><script>const tl=gsap.timeline({paused:true});tl.set('.photo',{scale:1.02}).to('.photo',{scale:1.065,x:-10,duration:5.74,ease:'none'},0).fromTo('.top',{opacity:0,y:-22},{opacity:1,y:0,duration:.34,ease:'power3.out'},.06).fromTo('.card',{opacity:0,y:26},{opacity:1,y:0,duration:.32,stagger:.18,ease:'power3.out'},.64).to('.good',{boxShadow:'0 0 34px rgba(34,211,238,.45)',duration:.65,ease:'sine.inOut',yoyo:true,repeat:2},1.45);window.__timelines=window.__timelines||{};window.__timelines['scene-criterion']=tl;</script></template></body></html>
