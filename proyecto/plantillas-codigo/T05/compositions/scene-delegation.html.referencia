<!doctype html><html><body><template><style>#root{position:absolute;inset:0;overflow:hidden;background:#07111f;font-family:Montserrat,Arial,sans-serif;color:#f8fafc}.bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.line{position:absolute;left:536px;top:190px;bottom:300px;width:8px;border-radius:8px;background:linear-gradient(#ec4899,#8b5cf6,#22d3ee)}.left,.right{position:absolute;top:130px;width:420px}.left{left:70px}.right{right:70px;text-align:right}.label{font:900 22px Inter,Arial;letter-spacing:.13em}.left .label{color:#f9a8d4}.right .label{color:#67e8f9}.head{margin-top:15px;font-size:56px;line-height:.98;letter-spacing:-.05em}.balance{position:absolute;left:300px;top:430px;width:480px}.tasks{position:absolute;left:90px;right:90px;top:1030px;display:grid;gap:20px}.task{padding:23px 28px;border-radius:24px;background:rgba(7,17,31,.92);border:2px solid rgba(236,72,153,.52);font-size:47px;line-height:1}.task b{float:right;color:#22d3ee}.warning{position:absolute;left:140px;right:140px;bottom:380px;padding:18px;border-radius:99px;background:#ec4899;text-align:center;font:900 25px Inter,Arial;letter-spacing:.06em}</style><div id="root" data-composition-id="scene-delegation" data-width="1080" data-height="1920"><img class="bg" src="assets/video-05_judgment_split_background_v01.svg"><div class="line"></div><div class="left"><div class="label">HUMANO</div><div class="head">CRITERIO<br>PROPIO</div></div><div class="right"><div class="label">IA</div><div class="head">DELEGACIÓN<br>TOTAL</div></div><img class="balance" src="assets/video-05_human_ai_balance_overlay_v01.svg"><div class="tasks"><div class="task">PIENSA <b>→ IA</b></div><div class="task">ESCRIBE <b>→ IA</b></div><div class="task">DECIDE <b>→ IA</b></div></div><div class="warning">SI TODO SALE DE TI, TU CRITERIO SE ATROFIA</div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('.line',{scaleY:0,transformOrigin:'50% 0'},{scaleY:1,duration:.4,ease:'power2.out'},.04).fromTo('.left',{opacity:0,x:-30},{opacity:1,x:0,duration:.32,ease:'power3.out'},.15).fromTo('.right',{opacity:0,x:30},{opacity:1,x:0,duration:.32,ease:'power3.out'},.22).fromTo('.balance',{opacity:0,scale:.7},{opacity:1,scale:1,duration:.42,ease:'back.out(1.6)'},.36).fromTo('.task',{opacity:0,y:24},{opacity:1,y:0,duration:.28,stagger:.32,ease:'power3.out'},.72).fromTo('.warning',{opacity:0,scale:.88},{opacity:1,scale:1,duration:.36,ease:'back.out(1.7)'},1.85);window.__timelines=window.__timelines||{};window.__timelines['scene-delegation']=tl;</script></template></body></html>
