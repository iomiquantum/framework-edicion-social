<!doctype html>
<html lang="es" data-resolution="portrait">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=1080,height=1920">
<script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js">
</script>
<style>*{box-sizing:border-box}html,body{margin:0;width:1080px;height:1920px;overflow:hidden;background:#07111f}#root{position:relative;width:1080px;height:1920px;overflow:hidden;background:#07111f}.clip{position:absolute;inset:0}#camera{position:absolute;inset:-2%;transform-origin:50% 42%}#speaker{width:104%;height:104%;object-fit:cover}.scene{z-index:5}#captions{z-index:20}</style>
</head>
<body>
<div id="root" data-composition-id="main" data-start="0" data-duration="19.533" data-width="1080" data-height="1920">
