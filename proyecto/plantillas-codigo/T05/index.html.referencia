</video>
</div>
<div id="hook" class="clip scene" data-composition-id="scene-hook" data-composition-src="compositions/scene-hook.html" data-start="0" data-duration="5.70" data-track-index="3" data-width="1080" data-height="1920">
</div>
<div id="delegation" class="clip scene" data-composition-id="scene-delegation" data-composition-src="compositions/scene-delegation.html" data-start="5.70" data-duration="4.55" data-track-index="4" data-width="1080" data-height="1920">
</div>
