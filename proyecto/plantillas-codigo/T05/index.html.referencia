</div>
<div id="cta" class="clip scene" data-composition-id="scene-cta" data-composition-src="compositions/scene-cta.html" data-start="15.99" data-duration="3.543" data-track-index="5" data-width="1080" data-height="1920">
</div>
<div id="captions" class="clip" data-composition-id="captions-es" data-composition-src="compositions/captions-es.html" data-start="0" data-duration="19.533" data-track-index="8" data-track-kind="captions" data-width="1080" data-height="1920">
</div>
<audio id="voice" src="assets/video05-voice-normalized.m4a" preload="auto" data-start="0" data-duration="19.533" data-track-index="20" data-volume="1">
</audio>
<audio id="sfx-hook" src="assets/05_low_accent.wav" preload="auto" data-start=".06" data-duration=".34" data-track-index="30" data-volume=".34">
</audio>
