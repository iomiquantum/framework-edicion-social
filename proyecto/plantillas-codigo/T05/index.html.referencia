</div>
<script>const tl=gsap.timeline({paused:true});tl.set('#camera',{scale:1,x:0,y:0},0).to('#camera',{scale:1.055,y:14,duration:.55,ease:'power2.out'},.18).to('#camera',{scale:1.025,y:0,duration:.65,ease:'power2.inOut'},5.0).set('#camera',{scale:1.03,x:0,y:0},15.99).to('#camera',{scale:1.075,y:18,duration:.72,ease:'power2.out'},16.12);window.__timelines=window.__timelines||{};window.__timelines.main=tl;tl.seek(0)</script>
