<template><div data-hf-id="hf-zn0p" data-composition-id="scene-palabra" data-width="1080" data-height="1920" data-duration="3.700000000" style="position:relative;width:100%;height:100%"><div data-hf-id="hf-lnc8" class="title-panel" style="background:#3b31a5;color:#ffffff"><h1 data-hf-id="hf-8b1j" id="scene-palabra-headline" class="headline"><span data-hf-id="hf-osh7">TU NOMBRE.</span><span data-hf-id="hf-qbos" style="color:#ffe500">¿QUÉ PALABRA?</span></h1></div></div><script>const root=document.querySelector('[data-composition-id="scene-palabra"]');const h=root.querySelector('.headline');gsap.set(h,{opacity:0});const tl=gsap.timeline({paused:true});tl.fromTo(h,{opacity:0,y:8},{opacity:1,y:0,duration:.24,ease:'power3.out'},0);tl.to(h,{opacity:0,duration:.1,ease:'power2.in'},3.600000000);window.__timelines['scene-palabra']=tl;tl.seek(0);</script></template>