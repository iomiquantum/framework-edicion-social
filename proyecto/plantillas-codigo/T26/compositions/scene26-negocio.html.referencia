<template><div id="scene26-negocio" data-composition-id="scene26-negocio" data-width="1080" data-height="1920" data-duration="3.033333334" style="position:relative;width:100%;height:100%"><div class="scene-inner dark" id="inner26-negocio" style="opacity:0"><div class="rail"></div><div class="headline">Tu negocio, visto<span class="accent">desde fuera.</span></div><div class="hero">¿Qué<br>encontraría<br>una IA?</div></div></div><script>const root=document.querySelector('[data-composition-id="scene26-negocio"]');const tl=gsap.timeline({paused:true});tl.fromTo(root.querySelector(".scene-inner"),{opacity:0,y:12},{opacity:1,y:0,duration:.18,ease:"power2.out"},0);tl.fromTo(root.querySelector(".hero"),{opacity:0},{opacity:1,duration:.12,ease:"power2.out"},.18);tl.set(root.querySelector(".scene-inner"),{opacity:0},3.033333334);window.__timelines["scene26-negocio"]=tl;</script></template>