<template><div id="scene26-cliente" data-composition-id="scene26-cliente" data-width="1080" data-height="1920" data-duration="5.200000000" style="position:relative;width:100%;height:100%"><div class="scene-inner " id="inner26-cliente" style="opacity:0"><div class="rail"></div><div class="headline">Tu próximo cliente<span class="accent">podría llegar por IA.</span></div></div></div><script>const root=document.querySelector('[data-composition-id="scene26-cliente"]');const tl=gsap.timeline({paused:true});tl.fromTo(root.querySelector(".scene-inner"),{opacity:0,y:12},{opacity:1,y:0,duration:.18,ease:"power2.out"},0);tl.set(root.querySelector(".scene-inner"),{opacity:0},5.200000000);window.__timelines["scene26-cliente"]=tl;</script></template>