        .to("#camera", { scale: 1.075, y: 20, duration: .72, ease: "power2.out" }, 17.740)
        .to("#camera", { scale: 1.045, y: 6, duration: .82, ease: "power1.inOut" }, 20.337);
      window.__timelines["main"] = tl; tl.seek(0);
