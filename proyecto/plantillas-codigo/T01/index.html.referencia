<!DOCTYPE html>
<html lang="es" data-resolution="portrait" data-composition-variables='[{"id":"name","type":"string","label":"Nombre de salida","default":"neutral-master"},{"id":"platform_profile","type":"enum","label":"Perfil de plataforma","default":"PLATFORM-MASTER-VERTICAL-001","options":[{"value":"PLATFORM-MASTER-VERTICAL-001","label":"Máster neutral"},{"value":"PLATFORM-INSTAGRAM-REELS-ORGANIC-001","label":"Instagram Reels"},{"value":"PLATFORM-TIKTOK-ORGANIC-001","label":"TikTok"},{"value":"PLATFORM-YOUTUBE-SHORTS-001","label":"YouTube Shorts"}]},{"id":"layout_token","type":"string","label":"Token de layout","default":"vertical-master-neutral"},{"id":"cta_token","type":"string","label":"Token de CTA","default":"cta-neutral"},{"id":"safe_essential_x","type":"number","label":"Zona esencial X","default":0.1,"min":0,"max":1,"step":0.01},{"id":"safe_essential_y","type":"number","label":"Zona esencial Y","default":0.1,"min":0,"max":1,"step":0.01},{"id":"safe_essential_width","type":"number","label":"Ancho esencial","default":0.8,"min":0,"max":1,"step":0.01},{"id":"safe_essential_height","type":"number","label":"Alto esencial","default":0.8,"min":0,"max":1,"step":0.01},{"id":"caption_safe_x","type":"number","label":"Captions X","default":0.1,"min":0,"max":1,"step":0.01},{"id":"caption_safe_y","type":"number","label":"Captions Y","default":0.64,"min":0,"max":1,"step":0.01},{"id":"caption_safe_width","type":"number","label":"Ancho captions","default":0.8,"min":0,"max":1,"step":0.01},{"id":"caption_safe_height","type":"number","label":"Alto captions","default":0.16,"min":0,"max":1,"step":0.01}]'>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1080, height=1920">
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      * { box-sizing: border-box; }
      html, body { margin: 0; width: 1080px; height: 1920px; overflow: hidden; background: #101321; }
      #root { position: relative; width: 1080px; height: 1920px; overflow: hidden; background: #101321; font-family: "Arial Black", Arial, sans-serif; }
      .clip { position: absolute; inset: 0; }
      #camera { position: absolute; inset: -2%; transform-origin: 50% 44%; }
      #speaker-video { width: 104%; height: 104%; object-fit: cover; object-position: 50% 50%; }
      #portrait-grade { pointer-events: none; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(16,19,33,.04), rgba(16,19,33,.03) 58%, rgba(16,19,33,.28)); }
      .subcomp { position: absolute; inset: 0; z-index: 5; }
      #captions-host { z-index: 20; }

      /* Un solo montaje, tres reflujos de plataforma. Los perfiles cambian
         únicamente layout, captions y CTA; nunca toma, cortes, voz o assets. */
      #root[data-platform]:not([data-platform="neutral"]) #scene-hook-host .eyebrow,
      #root[data-platform]:not([data-platform="neutral"]) #scene-problem-host .tag,
      #root[data-platform]:not([data-platform="neutral"]) #scene-cycle-host .kicker,
      #root[data-platform]:not([data-platform="neutral"]) #scene-cycle-host .title,
      #root[data-platform]:not([data-platform="neutral"]) #scene-verdict-host .card,
      #root[data-platform]:not([data-platform="neutral"]) #scene-system-host .panel,
      #root[data-platform]:not([data-platform="neutral"]) #scene-cta-host .question {
        left: calc(var(--safe_essential_x) * 100%);
      }
      #root[data-platform]:not([data-platform="neutral"]) #scene-hook-host .title,
      #root[data-platform]:not([data-platform="neutral"]) #scene-problem-host .headline,
      #root[data-platform]:not([data-platform="neutral"]) #scene-cycle-host .steps,
      #root[data-platform]:not([data-platform="neutral"]) #scene-verdict-host .card,
      #root[data-platform]:not([data-platform="neutral"]) #scene-cta-host .question {
        width: calc(var(--safe_essential_width) * 100%);
      }
      #root[data-platform]:not([data-platform="neutral"]) #scene-hook-host .rule,
      #root[data-platform]:not([data-platform="neutral"]) #scene-problem-host .meter,
      #root[data-platform]:not([data-platform="neutral"]) #scene-cycle-host .steps,
      #root[data-platform]:not([data-platform="neutral"]) #scene-problem-host .headline {
        left: calc(var(--safe_essential_x) * 100%);
      }
      #root[data-platform]:not([data-platform="neutral"]) #captions-host .cue {
        left: calc(var(--caption_safe_x) * 100%);
        top: calc(var(--caption_safe_y) * 100%);
        bottom: auto;
        width: calc(var(--caption_safe_width) * 100%);
        max-height: calc(var(--caption_safe_height) * 100%);
      }

      /* Instagram: composición más aireada y editorial, con CTA social limpio. */
      #root[data-platform="instagram"] #scene-hook-host .title { top: 294px; padding: 34px 36px 38px; font-size: 72px; }
      #root[data-platform="instagram"] #scene-hook-host .rule { top: 566px; width: 230px; }
      #root[data-platform="instagram"] #scene-problem-host .headline { width: 760px; bottom: 540px; }
      #root[data-platform="instagram"] #scene-cycle-host .steps { width: 760px; gap: 24px; }
      #root[data-platform="instagram"] #scene-cycle-host .arrow { right: 216px; }
      #root[data-platform="instagram"] #scene-system-host .panel { top: 138px; width: 455px; padding: 30px 32px; }
      #root[data-platform="instagram"] #scene-system-host .eq { font-size: 52px; line-height: 1.01; }
      #root[data-platform="instagram"] #scene-system-host .hourglass { left: 610px; right: auto; top: 238px; width: 250px; height: 250px; }
      #root[data-platform="instagram"] #captions-host .cue { padding: 17px 23px 19px; border-radius: 24px; font-size: 43px; line-height: 1.04; text-align: center; background: rgba(16,19,33,.90); }
      #root[data-platform="instagram"] #scene-cta-host .question { top: 210px; }
      #root[data-platform="instagram"] #scene-cta-host .pill { top: 548px; left: 86px; padding: 15px 24px; font-size: 23px; }

      /* TikTok: lectura inmediata, bloque más compacto y alineación izquierda. */
      #root[data-platform="tiktok"] #scene-hook-host .eyebrow { top: 164px; }
      #root[data-platform="tiktok"] #scene-hook-host .title { top: 238px; padding: 30px 32px 34px; font-size: 74px; }
      #root[data-platform="tiktok"] #scene-hook-host .rule { top: 506px; width: 300px; }
      #root[data-platform="tiktok"] #scene-problem-host .headline { width: 735px; bottom: 565px; font-size: 78px; }
      #root[data-platform="tiktok"] #scene-cycle-host .kicker { top: 154px; }
      #root[data-platform="tiktok"] #scene-cycle-host .title { top: 218px; font-size: 78px; }
      #root[data-platform="tiktok"] #scene-cycle-host .steps { top: 585px; width: 735px; gap: 20px; }
      #root[data-platform="tiktok"] #scene-cycle-host .step { padding: 24px 28px; font-size: 49px; }
      #root[data-platform="tiktok"] #scene-cycle-host .arrow { right: 225px; bottom: 455px; }
      #root[data-platform="tiktok"] #scene-system-host .panel { top: 126px; width: 448px; padding: 29px 31px; }
      #root[data-platform="tiktok"] #scene-system-host .eq { font-size: 51px; line-height: 1.01; }
      #root[data-platform="tiktok"] #scene-system-host .hourglass { left: 596px; right: auto; top: 230px; width: 248px; height: 248px; }
      #root[data-platform="tiktok"] #captions-host .cue { padding: 16px 22px 18px 27px; border-radius: 12px 22px 22px 12px; border-left: 8px solid #2ed3c7; font-size: 44px; line-height: 1.04; text-align: left; background: rgba(16,19,33,.94); }
      #root[data-platform="tiktok"] #scene-cta-host .question { top: 170px; padding: 38px 40px; }
      #root[data-platform="tiktok"] #scene-cta-host .pill { top: 526px; left: 76px; padding: 15px 22px; font-size: 22px; }

      /* Shorts: continuidad de serie, área central limpia y episodio en el CTA. */
      #root[data-platform="youtube"] #scene-hook-host .eyebrow { top: 174px; }
      #root[data-platform="youtube"] #scene-hook-host .title { top: 252px; padding: 32px 34px 36px; font-size: 70px; }
      #root[data-platform="youtube"] #scene-hook-host .rule { top: 514px; width: 278px; }
      #root[data-platform="youtube"] #scene-problem-host .headline { width: 760px; bottom: 520px; }
      #root[data-platform="youtube"] #scene-cycle-host .kicker { top: 166px; }
      #root[data-platform="youtube"] #scene-cycle-host .title { top: 230px; font-size: 80px; }
      #root[data-platform="youtube"] #scene-cycle-host .steps { top: 594px; width: 760px; gap: 22px; }
      #root[data-platform="youtube"] #scene-cycle-host .arrow { right: 216px; }
      #root[data-platform="youtube"] #scene-system-host .panel { top: 136px; width: 458px; padding: 30px 32px; }
      #root[data-platform="youtube"] #scene-system-host .eq { font-size: 52px; line-height: 1.01; }
      #root[data-platform="youtube"] #scene-system-host .hourglass { left: 610px; right: auto; top: 238px; width: 252px; height: 252px; }
      #root[data-platform="youtube"] #captions-host .cue { padding: 17px 23px 19px; border-radius: 20px; border-top: 4px solid #756bff; font-size: 43px; line-height: 1.04; text-align: center; background: rgba(16,19,33,.92); }
      #root[data-platform="youtube"] #scene-cta-host .question { top: 184px; }
      #root[data-platform="youtube"] #scene-cta-host .pill { top: 532px; left: 86px; padding: 15px 23px; font-size: 22px; }

      .cta-platform { display: none; }
      #root[data-platform="neutral"] .cta-neutral,
      #root[data-platform="instagram"] .cta-instagram,
      #root[data-platform="tiktok"] .cta-tiktok,
      #root[data-platform="youtube"] .cta-youtube { display: inline; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="21.375" data-width="1080" data-height="1920">
      <div id="camera"><video id="speaker-video" class="clip" muted playsinline preload="auto" src="assets/video01-silence-cut-speed104-v4-sdr-bt709.mov" data-start="0" data-media-start="0" data-duration="21.375" data-track-index="0"></video></div>
      <div id="portrait-grade"></div>
      <div id="scene-hook-host" class="clip subcomp" data-composition-id="scene-hook" data-composition-src="compositions/scene-hook.html" data-start="0" data-duration="2.113" data-track-index="3" data-width="1080" data-height="1920"></div>
      <div id="scene-problem-host" class="clip subcomp" data-composition-id="scene-problem" data-composition-src="compositions/scene-problem.html" data-start="2.113" data-duration="4.029" data-track-index="3" data-width="1080" data-height="1920"></div>
      <div id="scene-cycle-host" class="clip subcomp" data-composition-id="scene-cycle" data-composition-src="compositions/scene-cycle.html" data-start="6.142" data-duration="5.553" data-track-index="3" data-width="1080" data-height="1920"></div>
      <div id="scene-verdict-host" class="clip subcomp" data-composition-id="scene-verdict" data-composition-src="compositions/scene-verdict.html" data-start="11.695" data-duration="1.499" data-track-index="3" data-width="1080" data-height="1920"></div>
      <div id="scene-system-host" class="clip subcomp" data-composition-id="scene-system" data-composition-src="compositions/scene-system.html" data-start="13.194" data-duration="4.367" data-track-index="3" data-width="1080" data-height="1920"></div>
      <div id="scene-cta-host" class="clip subcomp" data-composition-id="scene-cta" data-composition-src="compositions/scene-cta.html" data-start="17.561" data-duration="3.814" data-track-index="4" data-width="1080" data-height="1920"></div>
