    <script>
      const profileValues = window.__hyperframes.getVariables();
      const platformByProfile = {
        "PLATFORM-MASTER-VERTICAL-001": "neutral",
        "PLATFORM-INSTAGRAM-REELS-ORGANIC-001": "instagram",
        "PLATFORM-TIKTOK-ORGANIC-001": "tiktok",
        "PLATFORM-YOUTUBE-SHORTS-001": "youtube"
      };
      document.getElementById("root").dataset.platform = platformByProfile[profileValues.platform_profile] || "neutral";
      const tl = gsap.timeline({ paused: true });
      tl.set("#camera", { scale: 1, x: 0, y: 0 }, 0)
        .to("#camera", { scale: 1.055, y: 16, duration: .62, ease: "power2.out" }, .20)
        .to("#camera", { scale: 1.02, y: 0, duration: .67, ease: "power2.inOut" }, 1.635)
