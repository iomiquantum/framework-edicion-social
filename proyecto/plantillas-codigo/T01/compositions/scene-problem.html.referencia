<!doctype html><html><body><template>
<style>
#root{position:absolute;inset:0;overflow:hidden;color:#f6f4ee;font-family:"Arial Black",Arial,sans-serif;pointer-events:none;background:#101321}.photo{position:absolute;inset:-40px;width:1160px;height:2000px;object-fit:cover;filter:saturate(.78) contrast(1.08) brightness(.73)}.shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(16,19,33,.12),rgba(16,19,33,.05) 45%,rgba(16,19,33,.88))}.tag{position:absolute;top:220px;left:82px;padding:16px 22px;border:2px solid rgba(246,244,238,.72);font:700 26px SFMono-Regular,monospace;letter-spacing:.08em}.headline{position:absolute;left:78px;bottom:520px;width:920px;font-size:82px;line-height:.96;letter-spacing:-.05em}.headline span{color:#ff6b6b}.meter{position:absolute;left:84px;bottom:450px;width:510px;height:14px;background:rgba(246,244,238,.16);border-radius:8px;overflow:hidden}.meter i{display:block;width:92%;height:100%;background:linear-gradient(90deg,#756bff,#ff6b6b)}
</style>
<div id="root" data-composition-id="scene-problem" data-width="1080" data-height="1920"><img class="photo" data-layout-allow-overflow src=".media/images/image_001.png"><div class="shade"></div><div class="tag">RETRABAJO DETECTADO</div><div class="headline">MÁS TRABAJO<br><span>QUE ANTES</span></div><div class="meter"><i></i></div></div>
<script>const tl=gsap.timeline({paused:true});tl.fromTo("#root",{opacity:0},{opacity:1,duration:.2},0).fromTo(".photo",{scale:1.02},{scale:1.09,duration:4,ease:"none"},0).fromTo(".tag",{opacity:0,y:-22},{opacity:1,y:0,duration:.35,ease:"power2.out"},.25).fromTo(".headline",{opacity:0,y:42},{opacity:1,y:0,duration:.48,ease:"power3.out"},.6).fromTo(".meter i",{scaleX:0,transformOrigin:"0 50%"},{scaleX:1,duration:1.1,ease:"power2.out"},.82).to("#root",{opacity:0,duration:.28},3.75);window.__timelines["scene-problem"]=tl;</script>
</template></body></html>
