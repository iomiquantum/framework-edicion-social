<!doctype html><html><body><template>
<style>
#root{position:absolute;inset:0;overflow:hidden;color:#f6f4ee;font-family:"Arial Black",Arial,sans-serif;pointer-events:none;background:#07111f}.bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.veil{position:absolute;inset:0;background:rgba(7,17,31,.20)}.kicker{position:absolute;top:190px;left:84px;font:700 26px SFMono-Regular,monospace;color:#2ed3c7;letter-spacing:.12em}.title{position:absolute;top:256px;left:78px;font-size:84px;line-height:.98;letter-spacing:-.05em}.steps{position:absolute;top:620px;left:90px;width:900px;display:grid;gap:26px}.step{display:flex;align-items:center;gap:28px;padding:26px 32px;border-radius:24px;background:rgba(16,19,33,.82);border:1px solid rgba(246,244,238,.13);font-size:54px}.n{display:grid;place-items:center;width:74px;height:74px;border-radius:20px;background:#756bff;color:#fff;font:700 26px SFMono-Regular,monospace}.step:nth-child(2) .n,.step:nth-child(4) .n{background:#ff6b6b;color:#101321}.arrow{position:absolute;right:92px;bottom:430px;color:#2ed3c7;font-size:74px}
</style>
<div id="root" data-composition-id="scene-cycle" data-width="1080" data-height="1920"><img class="bg" src=".media/images/image_002.svg"><div class="veil"></div><div class="kicker">ESTO NO ES UN SISTEMA</div><div class="title">EL BUCLE<br>DEL RETRABAJO</div><div class="steps"><div class="step"><span class="n">01</span>GENERAR</div><div class="step"><span class="n">02</span>CORREGIR</div><div class="step"><span class="n">03</span>VOLVER A PEDIR</div><div class="step"><span class="n">04</span>REVISAR OTRA VEZ</div></div><div class="arrow">↻</div></div>
<script>const tl=gsap.timeline({paused:true});tl.fromTo("#root",{opacity:0},{opacity:1,duration:.22},0).fromTo(".kicker,.title",{opacity:0,y:24},{opacity:1,y:0,duration:.42,stagger:.08,ease:"power2.out"},.15).fromTo(".step",{opacity:0,x:-55},{opacity:1,x:0,duration:.4,stagger:.45,ease:"power3.out"},.65).fromTo(".arrow",{opacity:0,rotation:-120},{opacity:1,rotation:0,duration:.7,ease:"back.out(1.6)"},2.8).to("#root",{opacity:0,duration:.24},4.72);window.__timelines["scene-cycle"]=tl;</script>
</template></body></html>
