<!doctype html><html><head></head><body><template>
<style>
  #root{position:absolute;inset:0;overflow:hidden;color:#17353A;font-family:Inter,Arial,sans-serif;pointer-events:none}
  .card{position:absolute;left:42px;right:42px;top:34px;height:208px;background:#F3E7CF;border:5px solid #17353A;box-shadow:11px 11px 0 #E76F51;padding:24px 32px 20px;overflow:hidden}
  .headline{font:900 78px/.86 "Bebas Neue",Impact,sans-serif;letter-spacing:-1px;text-transform:uppercase;display:flex;flex-wrap:wrap;column-gap:18px;align-items:baseline}
  .headline span{display:inline-block;opacity:0}.headline .accent{color:#17353A;background:#E76F51;font-size:86px;padding:0 8px}.rule{position:absolute;left:32px;right:32px;bottom:18px;height:7px;background:#E9C46A;transform-origin:left center}
  .signal{position:absolute;right:54px;top:286px;width:150px;height:150px;background:#F3E7CF;border:5px solid #17353A;box-shadow:10px 10px 0 #E9C46A;display:grid;place-items:center}
  .signal svg{width:108px;height:108px}.signal path{fill:none;stroke:#E76F51;stroke-width:9;stroke-linecap:round;stroke-linejoin:round}
</style>
<div data-hf-id="hf-v13-hook-root" id="root" data-composition-id="scene-hook" data-duration="6.99" data-width="1080" data-height="1920">
  <div class="card" id="card"><div class="headline"><span id="h1">LA IA</span><span id="h2">NO CONOCE</span><span id="h3">A TU</span><span id="h4" class="accent">CLIENTE</span></div><div class="rule" id="rule"></div></div>
  <div class="signal" id="signal"><svg viewBox="0 0 120 120" aria-hidden="true"><path id="ear-path" d="M74 94c-3 11-12 17-23 13-11-4-14-14-14-25 0-14-16-18-13-36 3-22 19-35 39-33 21 2 34 17 33 36-1 15-9 22-17 28-4 3-4 10-5 17Z"/><path id="wave-path" d="M52 39c12-9 27 0 26 14-1 9-9 12-14 17-5 5-4 11-7 16"/></svg></div>
</div>
<script>
  const tl=gsap.timeline({paused:true});
  const seq=[["#h1",72,.18,.06],["#h2",50,.15,.22],["#h3",42,.14,.35],["#h4",68,.17,.46]];
  seq.forEach(([id,y,d,t])=>{tl.set(id,{opacity:1,y},t).to(id,{y:0,duration:d,ease:"power4.out"},t)});
  tl.fromTo("#rule",{scaleX:0},{scaleX:1,duration:.44,ease:"power3.out"},.54).fromTo("#signal",{scale:0,opacity:0,y:18},{scale:1,opacity:1,y:0,duration:.48,ease:"power3.out"},.72);
  document.querySelectorAll(".signal path").forEach((p,i)=>{const len=p.getTotalLength();p.style.strokeDasharray=len;p.style.strokeDashoffset=len;tl.to(p,{strokeDashoffset:0,duration:i?.34:.54,ease:"power2.out"},.92+i*.34)});
  window.__timelines["scene-hook"]=tl;
</script>
</template></body></html>
