<!doctype html><html><head></head><body><template>
<style>
  #root{position:absolute;inset:0;color:#17353A;font-family:Inter,Arial,sans-serif;pointer-events:none}.cue{position:absolute;left:54px;right:54px;bottom:505px;padding:26px 30px 28px;background:rgba(243,231,207,.98);border:5px solid #17353A;box-shadow:12px 12px 0 #E76F51;font-size:58px;font-weight:900;line-height:1.02;text-align:center;letter-spacing:-1.2px;opacity:0}.cue.long{font-size:54px}.cue b{color:#17353A;font-weight:900;text-decoration:underline;text-decoration-color:#E76F51;text-decoration-thickness:8px;text-underline-offset:6px}.cue .teal{color:#17353A;text-decoration:underline;text-decoration-color:#E9C46A;text-decoration-thickness:8px;text-underline-offset:6px}
