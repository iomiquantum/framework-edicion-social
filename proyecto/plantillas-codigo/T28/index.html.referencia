<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script><style>@font-face{font-family:Guia;src:url(assets/fonts/Inter-700.woff2);font-weight:700;font-display:block}*{box-sizing:border-box;margin:0;padding:0}html,body{width:100%;height:100%;overflow:hidden}#main{position:relative;width:100%;height:100%;overflow:hidden;font-family:Guia,sans-serif;color:#142745}.bed{position:absolute;inset:0;background:#e7eef8}.presenter,.apoyo{position:absolute;left:208px;top:300px;width:664px;height:1180px;object-fit:contain;border-radius:24px;z-index:1}.apoyo{z-index:4;object-fit:cover;opacity:0}.layer{position:absolute;inset:0;z-index:5}.headline{position:absolute;left:90px;top:62px;width:900px;font-size:79px;line-height:1.1;font-weight:700}.headline span{display:block}.accent{color:#7846a8}.caption{position:absolute;left:90px;top:1530px;width:900px;z-index:10}.caption p{padding:24px 34px;background:#142745;color:#e7eef8;border-radius:22px;text-align:center;font-size:60px;line-height:1.12;font-weight:700;word-spacing:2px}.wave{position:absolute;left:345px;top:1820px;width:390px;height:75px;z-index:7}.focus-card{position:absolute;left:0;top:300px;width:1080px;height:1180px;background:#e7eef8;z-index:5}.ring{position:absolute;left:245px;top:170px;width:590px;height:590px}.focus-copy{position:absolute;left:90px;top:885px;width:900px;font-size:86px;text-align:center;line-height:1.12}.focus-copy span{display:block}.tool-line{position:absolute;left:90px;top:230px;width:900px;height:45px;display:flex;justify-content:space-between;font-size:27px;letter-spacing:1px;color:#1d6d82}.accent-cyan{color:#1d6d82}</style></head><body><div data-hf-id="hf-pb62" id="main" data-composition-id="main" data-width="1080" data-height="1920" data-fps="30" data-duration="24.7"><div data-hf-id="hf-08p1" class="bed"></div><video data-hf-id="hf-iy18" id="presenter" class="clip presenter" src="assets/video28-working-master-hlg-v1.mov" muted playsinline data-start="0" data-duration="24.7" data-track-index="0" data-track-kind="video"></video><div data-hf-id="hf-0fnn" id="mount-state-0" class="clip layer" data-composition-id="state-0" data-composition-src="compositions/state-0.html" data-start="0.000000000" data-duration="3.733333333" data-width="1080" data-height="1920" data-track-index="3" data-track-kind="graphics"></div><div data-hf-id="hf-n08m" id="mount-state-1" class="clip layer" data-composition-id="state-1" data-composition-src="compositions/state-1.html" data-start="3.733333333" data-duration="6.366666667" data-width="1080" data-height="1920" data-track-index="3" data-track-kind="graphics"></div><div data-hf-id="hf-zagf" id="mount-state-2" class="clip layer" data-composition-id="state-2" data-composition-src="compositions/state-2.html" data-start="10.100000000" data-duration="8.033333333" data-width="1080" data-height="1920" data-track-index="3" data-track-kind="graphics"></div><div data-hf-id="hf-z8r0" id="mount-state-3" class="clip layer" data-composition-id="state-3" data-composition-src="compositions/state-3.html" data-start="18.133333333" data-duration="3.900000000" data-width="1080" data-height="1920" data-track-index="3" data-track-kind="graphics"></div><div data-hf-id="hf-14cm" id="mount-state-4" class="clip layer" data-composition-id="state-4" data-composition-src="compositions/state-4.html" data-start="22.033333333" data-duration="2.666666667" data-width="1080" data-height="1920" data-track-index="3" data-track-kind="graphics"></div><img data-hf-id="hf-64fh" id="image-learning" class="clip apoyo" src="assets/aprendizaje-contexto-v1.png" alt="Metáfora generada: dos herramientas iguales, experiencias distintas" data-start="15.85" data-duration="2.1" data-track-index="2" data-track-kind="image"><div data-hf-id="hf-iyjj" id="mount-focus-learning" class="clip layer" data-composition-id="focus-learning" data-composition-src="compositions/focus-learning.html" data-start="18.2" data-duration="2.1" data-width="1080" data-height="1920" data-track-index="4" data-track-kind="graphics"></div><img data-hf-id="hf-xyuf" class="wave" src="assets/onda-guia-v1.svg" alt="Pictograma de voz, no señal acústica medida"><div data-hf-id="hf-9ons" id="mount-captions" class="clip layer" style="z-index:10" data-composition-id="captions-es" data-composition-src="compositions/captions-es.html" data-start="0" data-duration="24.7" data-width="1080" data-height="1920" data-track-index="8" data-track-kind="captions"></div><audio data-hf-id="hf-1hpe" id="voice" src="assets/video28-voice-level-v1.wav" data-start="0" data-duration="24.7" data-volume="1" data-track-index="20" data-track-kind="voice"></audio><audio data-hf-id="hf-o98o" id="sfx-problema" src="assets/sfx-problema-mix-v1.wav" data-start="0.15" data-duration="0.58" data-volume="1" data-track-index="30" data-track-kind="sfx"></audio><audio data-hf-id="hf-9cv0" id="sfx-diferencia" src="assets/sfx-diferencia-mix-v2.wav" data-start="10.15" data-duration="0.09" data-volume="1" data-track-index="30" data-track-kind="sfx"></audio><audio data-hf-id="hf-fc6y" id="sfx-aprendizaje" src="assets/sfx-aprendizaje-mix-v1.wav" data-start="20.1" data-duration="0.84" data-volume="1" data-track-index="30" data-track-kind="sfx"></audio></div><script>const tl=gsap.timeline({paused:true});tl.set("#image-learning",{opacity:1},15.85);tl.set("#image-learning",{opacity:0},17.95);window.__timelines.main=tl;</script></body></html>