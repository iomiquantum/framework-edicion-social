<!doctype html><html><body><template><style>#root{position:absolute;inset:0;overflow:hidden;font-family:Montserrat,Arial,sans-serif;color:#f8fafc}.copy{position:absolute;left:58px;top:92px;width:820px}.tag{display:inline-flex;padding:11px 18px;border-radius:999px;background:#ef4444;color:#fff;font:900 22px Inter,Arial;letter-spacing:.12em}.title{box-sizing:border-box;width:660px;margin-top:17px;padding:21px 25px 24px;border:2px solid rgba(249,115,22,.75);border-left:8px solid #f97316;border-radius:26px;background:linear-gradient(135deg,rgba(7,17,31,.95),rgba(50,24,22,.86));box-shadow:0 18px 42px rgba(7,17,31,.30);font-size:66px;line-height:.91;letter-spacing:-.052em;text-transform:uppercase;text-shadow:0 4px 18px rgba(7,17,31,.34)}.title b{display:inline-block;color:#fb923c}.pipe{position:absolute;right:36px;top:58px;width:230px;height:230px;filter:drop-shadow(0 16px 28px rgba(239,68,68,.25))}.rule{margin-top:18px;width:270px;height:10px;border-radius:8px;background:linear-gradient(90deg,#f97316,#ef4444,#14b8a6)}</style><div id="root" data-composition-id="scene-hook" data-width="1080" data-height="1920"><img class="pipe" src="assets/video-04_tangled_pipeline_overlay_v01.svg"><div class="copy" data-layout-allow-occlusion><div class="tag">ADVERTENCIA</div><div class="title">LA IA PUEDE<br><b>EMPEORAR</b><br>TU NEGOCIO</div><div class="rule"></div></div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('.tag',{opacity:0,x:-18},{opacity:1,x:0,duration:.24,ease:'power2.out'},.06).fromTo('.title',{opacity:0,y:22},{opacity:1,y:0,duration:.38,ease:'power3.out'},.16).fromTo('.title b',{scale:.75},{scale:1,duration:.42,ease:'back.out(2)'},.45).fromTo('.pipe',{opacity:0,scale:.6,rotation:-15},{opacity:1,scale:1,rotation:0,duration:.5,ease:'back.out(1.7)'},.3).fromTo('.rule',{scaleX:0,transformOrigin:'0 50%'},{scaleX:1,duration:.35,ease:'power2.out'},.52).to('.pipe',{rotation:5,duration:1.1,ease:'sine.inOut',yoyo:true,repeat:3},1);window.__timelines=window.__timelines||{};window.__timelines['scene-hook']=tl;</script></template></body></html>
