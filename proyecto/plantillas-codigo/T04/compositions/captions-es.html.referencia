<!doctype html><html><body><template><style>#root{position:absolute;inset:0;color:#f8fafc;font-family:Montserrat,Arial,sans-serif;pointer-events:none}.cue{position:absolute;left:72px;bottom:255px;width:936px;padding:20px 25px 22px;border-radius:23px;background:rgba(7,17,31,.94);box-shadow:0 18px 55px rgba(0,0,0,.3);font-size:46px;line-height:1.08;text-align:center;letter-spacing:-.025em;opacity:0}.cue em{font-style:normal;color:#5eead4}.cue strong{color:#fb923c}</style><div id="root" data-composition-id="captions-es" data-width="1080" data-height="1920"><div id="c1" class="cue"><strong>La IA puede empeorar tu negocio.</strong></div><div id="c2" class="cue">La inteligencia artificial también puede empeorarlo.</div><div id="c3" class="cue">Si tienes <strong>procesos malos,</strong></div><div id="c4" class="cue">información desordenada y nadie mide resultados,</div><div id="c5" class="cue">la IA puede hacer el desorden <strong>mucho más rápido.</strong></div><div id="c6" class="cue">¿Qué parte de tu negocio</div><div id="c7" class="cue">todavía <em>no automatizarías?</em></div></div><script>const tl=gsap.timeline({paused:true});const cues=[["#c1",.173,2.121],["#c2",2.467,5.950],["#c3",6.296,8.15],["#c4",8.15,11.431],["#c5",11.777,15.062],["#c6",15.408,17.015],["#c7",17.361,18.545]];cues.forEach(([id,a,b])=>{tl.fromTo(id,{opacity:0,y:16},{opacity:1,y:0,duration:.09,ease:'power1.out'},a).to(id,{opacity:0,y:-8,duration:.09,ease:'power1.in'},b-.09)});window.__timelines=window.__timelines||{};window.__timelines['captions-es']=tl;</script></template></body></html>
