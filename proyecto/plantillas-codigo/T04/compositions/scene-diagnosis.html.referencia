<!doctype html>
<html>
<body>
<template>
<style>#root{position:absolute;inset:0;overflow:hidden;background:#07111f;font-family:Montserrat,Arial,sans-serif;color:#f8fafc}.bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.tag{position:absolute;left:70px;top:105px;padding:10px 18px;border-radius:999px;background:#f97316;color:#07111f;font:900 22px Inter,Arial;letter-spacing:.11em}.pipe{position:absolute;left:180px;top:190px;width:720px}.cards{position:absolute;left:70px;right:70px;top:865px;display:grid;gap:20px}.card{display:flex;align-items:center;gap:22px;padding:25px 29px;border-radius:25px;background:rgba(7,17,31,.91);border:2px solid rgba(239,68,68,.55);box-shadow:0 22px 50px rgba(0,0,0,.27);font-size:43px;line-height:1}.n{width:58px;height:58px;border-radius:18px;display:grid;place-items:center;background:#ef4444;font:900 27px Inter,Arial}.card:nth-child(2){border-color:rgba(249,115,22,.62)}.card:nth-child(2) .n{background:#f97316}.card:nth-child(3){border-color:rgba(20,184,166,.62)}.card:nth-child(3) .n{background:#14b8a6}.footer{position:absolute;left:120px;right:120px;bottom:365px;text-align:center;font:900 29px Inter,Arial;letter-spacing:.08em;color:#fca5a5}</style>
<div id="root" data-composition-id="scene-diagnosis" data-width="1080" data-height="1920">
<img class="bg" src="assets/video-04_accelerated_chaos_background_v01.svg">
<div class="tag">ANTES DE AUTOMATIZAR</div>
<img class="pipe" src="assets/video-04_tangled_pipeline_overlay_v01.svg">
<div class="cards">
<div class="card">
<span class="n">1</span>PROCESOS MALOS</div>
<div class="card">
<span class="n">2</span>INFORMACIÓN DESORDENADA</div>
<div class="card">
<span class="n">3</span>NADIE MIDE RESULTADOS</div>
</div>
<div class="footer" style="display:none" data-layout-allow-overlap data-layout-allow-occlusion>ENTRADA MALA → SALIDA MÁS RÁPIDA</div>
</div>
<script>const tl=gsap.timeline({paused:true});tl.fromTo('.tag',{opacity:0,y:-18},{opacity:1,y:0,duration:.28,ease:'power2.out'},.06).fromTo('.pipe',{opacity:0,scaleX:.2,transformOrigin:'0 50%'},{opacity:1,scaleX:1,duration:.48,ease:'power3.out'},.15).fromTo('.card',{opacity:0,x:-44},{opacity:1,x:0,duration:.28,stagger:.34,ease:'power3.out'},.5).fromTo('.footer',{opacity:0,y:18},{opacity:1,y:0,duration:.32,ease:'power2.out'},1.65).to('.pipe',{x:24,duration:1.2,ease:'sine.inOut',yoyo:true,repeat:2},2);window.__timelines=window.__timelines||{};window.__timelines['scene-diagnosis']=tl;</script>
</template>
</body>
</html>
