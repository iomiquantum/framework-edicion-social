<!doctype html><html><body><template><style>#root{position:absolute;inset:0;overflow:hidden;background:#07111f;font-family:Montserrat,Arial,sans-serif;color:#f8fafc}.photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,17,31,.62) 0%,transparent 28%,transparent 58%,rgba(7,17,31,.75) 100%)}.top{position:absolute;left:58px;right:58px;top:86px;padding:24px 30px 27px;border-radius:28px;background:rgba(7,17,31,.91);border-left:9px solid #ef4444;box-shadow:0 20px 50px rgba(0,0,0,.27)}.small{font:850 21px Inter,Arial;letter-spacing:.12em;color:#fdba74}.big{margin-top:8px;font-size:57px;line-height:.98;letter-spacing:-.047em}.big b{color:#f97316}.speed{position:absolute;right:54px;top:910px;display:grid;gap:18px}.arrow{width:260px;height:16px;border-radius:9px;background:linear-gradient(90deg,transparent,#ef4444);transform:skewX(-22deg)}.result{position:absolute;left:70px;right:70px;bottom:410px;padding:22px 26px;border-radius:24px;background:rgba(239,68,68,.92);text-align:center;font:900 34px Inter,Arial;letter-spacing:.035em}</style><div id="root" data-composition-id="scene-speed" data-width="1080" data-height="1920"><img class="photo" data-layout-allow-overflow src="assets/video-04_broll_accelerated_chaos_v01.png"><div class="shade"></div><div class="top"><div class="small">LA IA NO ARREGLA EL SISTEMA</div><div class="big">SOLO HACE EL DESORDEN<br><b>MUCHO MÁS RÁPIDO</b></div></div><div class="speed"><div class="arrow"></div><div class="arrow"></div><div class="arrow"></div></div><div class="result">CAOS × VELOCIDAD</div></div><script>const tl=gsap.timeline({paused:true});tl.set('.photo',{scale:1.02}).to('.photo',{scale:1.07,duration:3.63,ease:'none'},0).fromTo('.top',{opacity:0,y:-22},{opacity:1,y:0,duration:.34,ease:'power3.out'},.05).fromTo('.arrow',{opacity:0,x:-80},{opacity:1,x:0,duration:.28,stagger:.12,ease:'power3.out'},.55).fromTo('.result',{opacity:0,scale:.86},{opacity:1,scale:1,duration:.36,ease:'back.out(1.7)'},1.12).to('.speed',{x:45,duration:.5,ease:'power1.in',repeat:3},1.45);window.__timelines=window.__timelines||{};window.__timelines['scene-speed']=tl;</script></template></body></html>
