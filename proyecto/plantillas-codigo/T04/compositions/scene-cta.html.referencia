<!doctype html><html><body><template><style>#root{position:absolute;inset:0;overflow:hidden;font-family:Montserrat,Arial,sans-serif;color:#f8fafc}.card{position:absolute;left:58px;right:58px;top:88px;padding:26px 31px 30px;border-radius:29px;background:rgba(7,17,31,.92);border:3px solid #14b8a6;box-shadow:0 24px 58px rgba(0,0,0,.28)}.small{font:850 22px Inter,Arial;letter-spacing:.12em;color:#5eead4}.question{margin-top:10px;font-size:56px;line-height:.98;letter-spacing:-.047em}.question b{color:#f97316}.pill{position:absolute;left:130px;right:130px;bottom:390px;padding:16px 20px;border-radius:99px;background:#14b8a6;color:#07111f;text-align:center;font:900 24px Inter,Arial;letter-spacing:.04em}</style><div id="root" data-composition-id="scene-cta" data-width="1080" data-height="1920"><div class="card"><div class="small">PON UN LÍMITE</div><div class="question">¿QUÉ PARTE TODAVÍA <b>NO AUTOMATIZARÍAS?</b></div></div><div class="pill">PRIMERO ORDENA. LUEGO ACELERA.</div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('.card',{opacity:0,y:-24},{opacity:1,y:0,duration:.36,ease:'power3.out'},.06).fromTo('.question b',{scale:.78,display:'inline-block'},{scale:1,duration:.4,ease:'back.out(1.8)'},.42).fromTo('.pill',{opacity:0,scale:.86},{opacity:1,scale:1,duration:.38,ease:'back.out(1.7)'},.84);window.__timelines=window.__timelines||{};window.__timelines['scene-cta']=tl;</script></template></body></html>
