<!doctype html><html><body><template><style>
#root{position:absolute;inset:0;overflow:hidden;font-family:Montserrat,Arial,sans-serif;color:#f7f4ee;background:#111325}.bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{position:absolute;inset:0;background:rgba(17,19,37,.28)}.kicker{position:absolute;left:70px;top:220px;padding:10px 18px;border-radius:99px;background:#38bdf8;color:#111325;font:900 23px Inter,Arial;letter-spacing:.1em}.cards{position:absolute;left:70px;right:70px;top:350px;display:grid;gap:34px}.card{padding:36px 42px;border-radius:32px;background:rgba(17,19,37,.91);border:1px solid rgba(255,255,255,.18);box-shadow:0 30px 70px rgba(0,0,0,.26)}.label{font:800 24px Inter,Arial;letter-spacing:.12em;color:#b9c2d6}.big{margin-top:10px;font-size:76px;line-height:.96;letter-spacing:-.05em}.old .big{color:#fb7185}.new{border-color:rgba(56,189,248,.7)}.new .big{color:#38bdf8}.arrow{position:absolute;right:105px;top:778px;font-size:120px;color:#8b5cf6}.formula{position:absolute;left:70px;right:70px;bottom:350px;padding:25px;border-radius:26px;text-align:center;background:#8b5cf6;font-size:48px;letter-spacing:-.03em}
</style><div id="root" data-composition-id="scene-action" data-width="1080" data-height="1920"><img class="bg" src=".media/images/action-bridge.svg"><div class="shade"></div><div class="kicker">EL CAMBIO REAL</div><div class="cards"><div class="card old"><div class="label">NO TE FALTA</div><div class="big">INFORMACIÓN</div></div><div class="card new"><div class="label">TE FALTA</div><div class="big">ACCIÓN</div></div></div><div class="arrow">↓</div><div class="formula">CONOCIMIENTO → ACCIÓN</div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('#root',{opacity:0},{opacity:1,duration:.2},0).fromTo('.kicker',{opacity:0,y:-20},{opacity:1,y:0,duration:.32,ease:'power2.out'},.1).fromTo('.old',{opacity:0,x:-60},{opacity:1,x:0,duration:.45,ease:'power3.out'},.28).fromTo('.arrow',{opacity:0,scale:.65},{opacity:1,scale:1,duration:.4,ease:'back.out(1.8)'},1.25).fromTo('.new',{opacity:0,x:60},{opacity:1,x:0,duration:.45,ease:'power3.out'},1.55).fromTo('.formula',{opacity:0,y:35},{opacity:1,y:0,duration:.45,ease:'power3.out'},2.55).to('.formula',{scale:1.035,duration:.5,ease:'sine.inOut',yoyo:true,repeat:1},3.25).to('#root',{opacity:0,duration:.24},5.12);window.__timelines=window.__timelines||{};window.__timelines['scene-action']=tl;</script></template></body></html>
