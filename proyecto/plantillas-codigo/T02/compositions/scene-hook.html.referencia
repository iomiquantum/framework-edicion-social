<!doctype html><html><body><template><style>
#root{position:absolute;inset:0;font-family:Montserrat,Arial,sans-serif;color:#f7f4ee;overflow:hidden}.depth{display:none}.copy{position:absolute;left:62px;top:178px;width:820px}.eyebrow{display:inline-flex;padding:12px 20px;border:3px solid #22d3ee;border-radius:999px;font:800 24px Inter,Arial;letter-spacing:.12em;color:#22d3ee}.title{margin-top:34px;font-size:88px;line-height:.9;letter-spacing:-.055em;text-transform:uppercase}.title .no{color:#fb7185}.line{margin-top:48px;width:250px;height:11px;border-radius:9px;background:linear-gradient(90deg,#c45cff,#22d3ee)}
</style><div id="root" data-composition-id="scene-hook" data-width="1080" data-height="1920"><div class="depth"></div><div class="copy" data-layout-allow-occlusion><div class="eyebrow" data-layout-allow-occlusion>REALIDAD INCÓMODA</div><div class="title" data-layout-allow-occlusion>OTRO CURSO<br><span class="no" data-layout-allow-occlusion>NO</span> TE SALVA</div><div class="line"></div></div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('.depth',{scaleX:0,opacity:0},{scaleX:1,opacity:1,duration:.34,ease:'power2.out'},.02).fromTo('.eyebrow',{opacity:0,x:-18},{opacity:1,x:0,duration:.28,ease:'power2.out'},.14).fromTo('.title',{opacity:0,y:22},{opacity:1,y:0,duration:.38,ease:'power3.out'},.22).fromTo('.title .no',{scale:.72,display:'inline-block'},{scale:1,duration:.4,ease:'back.out(2)'},.48).fromTo('.line',{scaleX:0,transformOrigin:'0 50%'},{scaleX:1,duration:.38,ease:'power2.out'},.5);window.__timelines=window.__timelines||{};window.__timelines['scene-hook']=tl;</script></template></body></html>
