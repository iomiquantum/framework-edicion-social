<!doctype html><html><body><template><style>
#root{position:absolute;inset:0;overflow:hidden;font-family:Montserrat,Arial,sans-serif;color:#f7f4ee}.facebadge{position:absolute;left:58px;top:92px;width:760px;padding:24px 30px 25px;border-radius:28px;background:rgba(17,19,37,.9);border:3px solid #38bdf8;box-shadow:0 20px 44px rgba(0,0,0,.22);font-family:Inter,Arial;color:#f7f4ee}.facebadge span{display:block;font-size:39px;line-height:1;font-weight:900;letter-spacing:.055em}.facebadge b{display:block;margin-top:8px;font-size:54px;line-height:.96;font-weight:900;letter-spacing:-.025em;color:#fb7185}.photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center center;opacity:0}.wash{position:absolute;inset:0;opacity:0;background:linear-gradient(180deg,rgba(17,19,37,.04) 0 58%,rgba(17,19,37,.7) 100%)}.panel{opacity:0;position:absolute;left:58px;right:58px;bottom:500px;padding:25px 30px;border-radius:28px;background:rgba(17,19,37,.91);border:1px solid rgba(255,255,255,.16);box-shadow:0 24px 55px rgba(0,0,0,.3)}.mini{font:800 21px Inter,Arial;letter-spacing:.12em;color:#38bdf8}.headline{font-size:56px;line-height:.98;letter-spacing:-.043em;margin-top:10px}.headline b{color:#fb7185}.score{display:flex;gap:14px;margin-top:19px}.chip{padding:10px 16px;border-radius:16px;background:#8b5cf6;font:800 23px Inter,Arial}.chip.zero{background:#b7354e}
</style><div id="root" data-composition-id="scene-stack" data-width="1080" data-height="1920"><div class="facebadge"><span>¿OTRO CURSO?</span><b>PRIMERO EJECUTA.</b></div><img class="photo" data-layout-allow-overflow src=".media/images/course-overload.png"><div class="wash"></div><div class="panel"><div class="mini">ACUMULAR ≠ AVANZAR</div><div class="headline">Ya tienes <b>CINCO</b>.<br>¿Cuántos ejecutaste?</div><div class="score"><div class="chip">5 COMPRADOS</div><div class="chip zero">0 EJECUTADOS</div></div></div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('.facebadge',{opacity:0,y:-18},{opacity:1,y:0,duration:.28,ease:'power3.out'},.08).fromTo('.facebadge b',{opacity:0,x:-18},{opacity:1,x:0,duration:.3,ease:'power2.out'},.2).to('.facebadge',{opacity:0,duration:.10},2.02).set('.facebadge',{display:'none'},2.12).set('.photo',{opacity:1,scale:1.015},2.16).fromTo('.photo',{scale:1.015},{scale:1.065,duration:4.3,ease:'none'},2.16).fromTo('.wash',{opacity:0},{opacity:1,duration:.14},2.16).fromTo('.panel',{opacity:0,y:18},{opacity:1,y:0,duration:.26,ease:'power2.out',immediateRender:false},2.27).fromTo('.chip',{opacity:0,y:12},{opacity:1,y:0,duration:.22,stagger:.08,ease:'power2.out'},2.46).to('#root',{opacity:0,duration:.16},6.56);window.__timelines=window.__timelines||{};window.__timelines['scene-stack']=tl;</script></template></body></html>
