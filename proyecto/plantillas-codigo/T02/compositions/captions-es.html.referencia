<!doctype html><html><body><template><style>
#root{position:absolute;inset:0;color:#f7f4ee;font-family:Montserrat,Arial,sans-serif;pointer-events:none}.cue{position:absolute;left:74px;bottom:255px;width:932px;padding:21px 27px 23px;border-radius:24px;background:rgba(17,19,37,.93);box-shadow:0 18px 55px rgba(0,0,0,.30);font-size:48px;line-height:1.08;text-align:center;letter-spacing:-.025em;opacity:0}.cue em{font-style:normal;color:#38bdf8}.cue strong{color:#fb7185}
</style><div id="root" data-composition-id="captions-es" data-width="1080" data-height="1920"><div id="c1" class="cue">Otro curso <strong>no te va a salvar.</strong></div><div id="c2" class="cue">Tal vez no necesitas comprar otro curso.</div><div id="c3" class="cue">Si ya tienes <em>cinco comprados</em></div><div id="c4" class="cue">y todavía no ejecutas ninguno,</div><div id="c5" class="cue">probablemente no te falta información.</div><div id="c6" class="cue">Te falta convertir</div><div id="c7" class="cue"><em>conocimiento en acción.</em></div><div id="c8" class="cue">Sé sincero:</div><div id="c9" class="cue">¿cuántos cursos tienes comprados</div><div id="c10" class="cue">que todavía <strong>no terminas?</strong></div></div><script>const tl=gsap.timeline({paused:true});const cues=[["#c1",.173,1.818],["#c2",2.164,4.254],["#c3",4.60,6.55],["#c4",6.55,8.561],["#c5",8.907,10.812],["#c6",11.159,12.106],["#c7",12.461,14.020],["#c8",14.366,15.005],["#c9",15.431,16.82],["#c10",16.82,18.188]];cues.forEach(([id,a,b])=>{tl.fromTo(id,{opacity:0,y:18},{opacity:1,y:0,duration:.10,ease:'power1.out'},a).to(id,{opacity:0,y:-10,duration:.10,ease:'power1.in'},b-.10)});window.__timelines=window.__timelines||{};window.__timelines['captions-es']=tl;</script></template></body></html>
