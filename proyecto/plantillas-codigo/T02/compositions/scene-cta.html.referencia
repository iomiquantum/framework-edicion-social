<!doctype html><html><body><template><style>
#root{position:absolute;inset:0;overflow:hidden;font-family:Montserrat,Arial,sans-serif;color:#f7f4ee}.card{position:absolute;left:58px;right:58px;top:118px;padding:28px 34px;border-radius:30px;background:rgba(17,19,37,.9);border-left:9px solid #fb7185;box-shadow:0 24px 58px rgba(0,0,0,.28)}.small{font:800 22px Inter,Arial;letter-spacing:.12em;color:#38bdf8}.question{font-size:62px;line-height:1;letter-spacing:-.048em;margin-top:12px}.question b{color:#fb7185}.pill{position:absolute;left:150px;right:150px;bottom:375px;padding:17px 22px;border-radius:99px;background:#8b5cf6;text-align:center;font:900 25px Inter,Arial;letter-spacing:.045em;box-shadow:0 18px 38px rgba(0,0,0,.24)}
</style><div id="root" data-composition-id="scene-cta" data-width="1080" data-height="1920"><div class="card"><div class="small">SÉ SINCERO</div><div class="question">¿Cuántos cursos todavía <b>NO TERMINAS?</b></div></div><div class="pill">RESPÓNDETE ANTES DE COMPRAR OTRO</div></div><script>const tl=gsap.timeline({paused:true});tl.fromTo('.card',{opacity:0,y:-28},{opacity:1,y:0,duration:.42,ease:'power3.out'},.08).fromTo('.question b',{scale:.72,display:'inline-block'},{scale:1,duration:.44,ease:'back.out(2)'},.58).fromTo('.pill',{opacity:0,scale:.84},{opacity:1,scale:1,duration:.4,ease:'back.out(1.7)'},1.15).to('.pill',{boxShadow:'0 0 32px rgba(139,92,246,.62)',duration:.62,ease:'sine.inOut',yoyo:true,repeat:1},2.12);window.__timelines=window.__timelines||{};window.__timelines['scene-cta']=tl;</script></template></body></html>
